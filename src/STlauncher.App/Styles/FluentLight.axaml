<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Light-theme overrides for FluentTheme resource keys, mirroring Fluent.axaml. Keys that do not exist in the current
      Avalonia version are simply ignored, so this list is safe to keep broad.
      The colours are the palette of ColorsLight.axaml: ground #F6F3F4, field #FFFFFF,
      hover #EEE8EB, hairline #E4DCE0.
    -->

    <Color x:Key="SystemAccentColor">#A3243F</Color>
    <Color x:Key="SystemAccentColorDark1">#8A1E35</Color>
    <Color x:Key="SystemAccentColorDark2">#7E1B31</Color>
    <Color x:Key="SystemAccentColorDark3">#6A162A</Color>
    <Color x:Key="SystemAccentColorLight1">#B92D4B</Color>
    <Color x:Key="SystemAccentColorLight2">#C4577A</Color>
    <Color x:Key="SystemAccentColorLight3">#D98AA0</Color>

    <!-- Text inputs: TextBox, ComboBox editable area. A white field stands on the ground
         and on white cards alike, so its border is a step stronger than the hairline. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FBF9FA"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F1ECEE"/>

    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D9CFD4"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#C2B5BC"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#A3243F"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E4DCE0"/>

    <SolidColorBrush x:Key="TextControlForeground" Color="#1B1418"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1B1418"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1B1418"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#7F7379"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7F7379"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6E6268"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#7F7379"/>

    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FBF9FA"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F1ECEE"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F1ECEE"/>

    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D9CFD4"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#C2B5BC"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#A3243F"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#E4DCE0"/>

    <SolidColorBrush x:Key="ComboBoxForeground" Color="#1B1418"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#1B1418"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#1B1418"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#7F7379"/>

    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#1B1418"/>

    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EEE8EB"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#1B1418"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#1B1418"/>

    <!-- CheckBox glyph background follows the accent -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#B7A9B0"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#A3243F"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#B92D4B"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#1B1418"/>
    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#1B1418"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>

    <!-- The switch: a filled track either way, no outline. A switch that cannot be
         flipped is still there to be seen: the stock disabled colours are white on white. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#A3243F"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#B92D4B"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8A1E35"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#D9B9C2"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#DCD2D7"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#CFC3C9"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#CFC3C9"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#ECE6E9"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#C9BDC3"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFFFFF"/>

    <!-- The slider -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#DCD2D7"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#CFC3C9"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#CFC3C9"/>
    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#A3243F"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#A3243F"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A3243F"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#B92D4B"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#B92D4B"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#A3243F"/>

    <!-- Popups, flyouts, menus -->
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#EEE8EB"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#1B1418"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#1B1418"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#1B1418"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#8E8288"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#5F5359"/>
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#7F7379"/>

    <!-- Tooltips -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#E4DCE0"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="#1B1418"/>

    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#D3C8CE"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B7A9B0"/>

    <!-- Controls whose dark-variant defaults vanish on ivory -->
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#5F5359"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundPointerOver" Color="#1B1418"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundPressed" Color="#1B1418"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#7F7379"/>
    <SolidColorBrush x:Key="NumericUpDownButtonForeground" Color="#5F5359"/>
    <SolidColorBrush x:Key="ButtonSpinnerForeground" Color="#5F5359"/>

</ResourceDictionary>
