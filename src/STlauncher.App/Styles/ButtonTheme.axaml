<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The launcher's own Button template, replacing Fluent's. Fluent's theme paints the
      ContentPresenter and restyles it on :pointerover / :pressed with its own greys; our
      styles then repaint the same presenter, and a colour transition animates the fight
      between the two (a light grey flash on every hover). With one root Border that
      nobody else styles, the transition has a single owner.

      Styles target the fill with "/template/ Border#PART_Root"; text colour stays on the
      presenter, "/template/ ContentPresenter#PART_ContentPresenter".
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <!-- A button with no class is the quiet one: a raised fill with a 1 px edge, bold
             Manrope. The fill alone is lost on a panel and the edge alone on the ground;
             together it is a button on both. The classes that change it (primary,
             accent-soft, ghost, icon, hero ...) are listed at the top of Controls.axaml. -->
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="15,9"/>
        <!-- Keyboard focus is a ring drawn by the button's own root (below), so it follows
             the corners; the theme's square adorner is switched off. -->
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.16"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22"/>
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- The press is a small dip of the whole button, not a colour change. -->
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Reached with Tab: a 2 px ring of the accent, no blur. -->
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>
