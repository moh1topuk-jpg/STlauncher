<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The light palette: warm ivory grounds, the same crimson accent, ink for text.
         Every key mirrors Colors.axaml; ThemeService swaps the two dictionaries. -->

    <!-- Ground, field, raised, hover: see Colors.axaml. On ivory the field is white, and a
         panel inside a white card needs a tone of its own, so SurfaceAlt is not white here;
         the mockup's white "raised" lives in RaisedBrush. The muted text is a shade darker
         than the mockup's #8E8288: that one falls under 3.5:1 on this ground at 12 px. -->
    <Color x:Key="AppBgColor">#F6F3F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1ECEE</Color>
    <Color x:Key="ElevatedColor">#EAE3E7</Color>
    <Color x:Key="HoverColor">#DFD6DB</Color>

    <Color x:Key="DividerColor">#E4DCE0</Color>
    <Color x:Key="BorderColor">#D3C8CE</Color>

    <Color x:Key="TextPrimaryColor">#1B1418</Color>
    <Color x:Key="TextSecondaryColor">#5F5359</Color>
    <Color x:Key="TextMutedColor">#7F7379</Color>
    <Color x:Key="TextOnAccentColor">#FFF6F8</Color>

    <Color x:Key="AccentColor">#A3243F</Color>
    <Color x:Key="AccentHoverColor">#B92D4B</Color>
    <Color x:Key="AccentPressedColor">#8A1E35</Color>
    <Color x:Key="GoldColor">#8A6A10</Color>
    <Color x:Key="GoldMutedColor">#B08F2E</Color>

    <Color x:Key="SuccessColor">#2F7F52</Color>
    <Color x:Key="WarningColor">#9A6A12</Color>
    <Color x:Key="DangerColor">#B8322A</Color>

    <FontFamily x:Key="DisplayFont">avares://STlauncher.App/Assets/Fonts#Manrope</FontFamily>
    <FontFamily x:Key="BodyFont">fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Menlo, monospace</FontFamily>

    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldMutedBrush" Color="{StaticResource GoldMutedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- ===================== The quiet look: brushes by what they are for ===================== -->
    <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#EEE8EB"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource DividerColor}"/>
    <!-- A quiet button is grey here, not the mockup's white: half the pages still stand on
         white cards, where a white button is only its text. -->
    <SolidColorBrush x:Key="ControlBrush" Color="#ECE6E9"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E2DADE"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D9CFD5"/>
    <BoxShadows x:Key="RowLineShadow">0 -1 0 0 #E4DCE0</BoxShadows>
    <BoxShadows x:Key="NoShadow">0 0 0 0 #00000000</BoxShadows>
    <BoxShadows x:Key="DialogShadow">0 18 48 0 #2E2A1C24</BoxShadows>
    <RadialGradientBrush x:Key="GroundGlowBrush" Center="78%,34%" GradientOrigin="78%,34%" RadiusX="52%" RadiusY="62%">
        <GradientStop Offset="0" Color="#17A3243F"/>
        <GradientStop Offset="1" Color="#00A3243F"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="AccentHairlineBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#00A3243F"/>
        <GradientStop Offset="0.5" Color="#C9A3243F"/>
        <GradientStop Offset="1" Color="#00A3243F"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#F6F3F4"/>
        <GradientStop Offset="1" Color="#F1ECEE"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GhostBrush" Color="#00F6F3F4"/>
    <SolidColorBrush x:Key="RailBrush" Color="#F6F3F4"/>
    <SolidColorBrush x:Key="UpdateBannerBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IndexBorderBrush" Color="#E4DCE0"/>

    <SolidColorBrush x:Key="CardGlassBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="CardGlassWarmBrush" Color="#D9F8ECF1"/>
    <SolidColorBrush x:Key="TileWarmBrush" Color="#F8ECF1"/>
    <SolidColorBrush x:Key="HeroSideBrush" Color="#99FFFFFF"/>

    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#8C2A1C24"/>
    <SolidColorBrush x:Key="LightboxScrimBrush" Color="#E6F3EEF0"/>
    <SolidColorBrush x:Key="LightboxFrameBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LightboxBorderBrush" Color="#22000000"/>

    <SolidColorBrush x:Key="InstalledTagBrush" Color="#DDF2E5"/>
    <SolidColorBrush x:Key="InstalledTagTextBrush" Color="#1F6B3D"/>

    <RadialGradientBrush x:Key="StageGlowBrush" Center="42%,38%" GradientOrigin="42%,38%" RadiusX="60%" RadiusY="55%">
        <GradientStop Offset="0" Color="#FBF4EE"/>
        <GradientStop Offset="0.7" Color="#40F6E4EA"/>
        <GradientStop Offset="1" Color="#00F3EEF0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#F0D3DC"/>
        <GradientStop Offset="0.55" Color="#F3E6EC"/>
        <GradientStop Offset="1" Color="#ECE3E8"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BuildIconBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F0D3DC"/>
        <GradientStop Offset="1" Color="#E8DDE3"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProjectHeaderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F0D3DC"/>
        <GradientStop Offset="1" Color="#EDE3E8"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#A3243F"/>
        <GradientStop Offset="1" Color="#A3243F"/>
    </LinearGradientBrush>
    <BoxShadows x:Key="HeroShadow">0 6 22 0 #33A3243F</BoxShadows>
    <BoxShadows x:Key="HeroShadowHover">0 10 30 0 #59A3243F</BoxShadows>


    <!-- ===================== Home: the lit stage and the glass over it ===================== -->
    <RadialGradientBrush x:Key="HomeGlowBrush" Center="84%,50%" GradientOrigin="84%,50%" RadiusX="46%" RadiusY="64%">
        <GradientStop Offset="0" Color="#40E7A9B8"/>
        <GradientStop Offset="0.5" Color="#1AE7A9B8"/>
        <GradientStop Offset="1" Color="#00F3EEF0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HeroCardBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFFFFF"/>
        <GradientStop Offset="1" Color="#FBEFF3"/>
    </LinearGradientBrush>
    <BoxShadows x:Key="HeroCardShadow">0 10 24 0 #1F502030</BoxShadows>
    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="60%" RadiusY="95%">
        <GradientStop Offset="0" Color="#33C02E4C"/>
        <GradientStop Offset="1" Color="#00C02E4C"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HeroGoldGlowBrush" Center="80%,0%" GradientOrigin="80%,0%" RadiusX="70%" RadiusY="90%">
        <GradientStop Offset="0" Color="#40E8C25A"/>
        <GradientStop Offset="1" Color="#00E8C25A"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="MosaicBrush" Color="#0D7E1B31"/>


    <LinearGradientBrush x:Key="NickGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#B8283F"/>
        <GradientStop Offset="1" Color="#8A6100"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="GlassChipBrush" Color="#14301A24"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#1F301A24"/>
    <SolidColorBrush x:Key="PillBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="PlateBrush" Color="#F2FFFFFF"/>
    <BoxShadows x:Key="PlateShadow">0 8 18 0 #1F502030</BoxShadows>

    <LinearGradientBrush x:Key="TileGoldBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FFF3D2"/>
        <GradientStop Offset="0.7" Color="#FFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileBlueBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#DDEEFA"/>
        <GradientStop Offset="0.7" Color="#FFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TileGoldHoverBrush" Color="#B08F2E"/>
    <SolidColorBrush x:Key="TileBlueHoverBrush" Color="#3B7FC4"/>
    <LinearGradientBrush x:Key="IconGoldBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F2D06B"/>
        <GradientStop Offset="1" Color="#C7952A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconBlueBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#8CCBF2"/>
        <GradientStop Offset="1" Color="#4A8FC9"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StageConeBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#66FFE9BE"/>
        <GradientStop Offset="0.6" Color="#1FC02E4C"/>
        <GradientStop Offset="1" Color="#00C02E4C"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="StageAuraBrush">
        <GradientStop Offset="0" Color="#40E24A6B"/>
        <GradientStop Offset="0.55" Color="#1AC02E4C"/>
        <GradientStop Offset="1" Color="#00C02E4C"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PedestalBrush" Center="50%,35%" GradientOrigin="50%,35%">
        <GradientStop Offset="0" Color="#FFFFFF"/>
        <GradientStop Offset="1" Color="#E4D4DB"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="PedestalRimBrush" Color="#80C02E4C"/>
    <RadialGradientBrush x:Key="PedestalShadowBrush">
        <GradientStop Offset="0" Color="#59301A24"/>
        <GradientStop Offset="1" Color="#00301A24"/>
    </RadialGradientBrush>

    <!-- ===================== Builds and the mod catalog ===================== -->
    <!-- The same six colours as in the dark palette: they carry their own white text, so
         they do not change with the ground they sit on. -->
    <LinearGradientBrush x:Key="TintBrush0" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#C02E4C"/>
        <GradientStop Offset="1" Color="#7E1B31"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush1" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#3F7BD9"/>
        <GradientStop Offset="1" Color="#24447A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush2" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#4C9A6A"/>
        <GradientStop Offset="1" Color="#235238"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush3" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#9D5BD2"/>
        <GradientStop Offset="1" Color="#4B2068"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush4" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#C98627"/>
        <GradientStop Offset="1" Color="#6B4514"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush5" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2F8FBF"/>
        <GradientStop Offset="1" Color="#1B4F6B"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TintMosaicBrush" Color="#1FFFFFFF"/>

    <SolidColorBrush x:Key="SourceBadgeBrush" Color="#A6000000"/>
    <SolidColorBrush x:Key="ModrinthDotBrush" Color="#1BD96A"/>
    <SolidColorBrush x:Key="CurseForgeDotBrush" Color="#F16436"/>

    <!-- ===================== Skins: the editor's canvas ===================== -->
    <SolidColorBrush x:Key="SkinPaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SkinPaperAltBrush" Color="#E9E0E5"/>
    <SolidColorBrush x:Key="SkinOutlineBrush" Color="#73301A24"/>
    <SolidColorBrush x:Key="SkinGridBrush" Color="#38161014"/>

</ResourceDictionary>
