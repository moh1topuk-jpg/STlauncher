<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette of the quiet look. Five tones carry every surface:
           ground  AppBg      the window itself
           field   Surface    inputs, chips, the track of a picker; also what is left of cards
           raised  SurfaceAlt a quiet button, a menu, a dialog
           hover   Elevated   a row under the pointer, the selected item
           (Hover is one step further, for hovering something already raised)
         and one hairline (Divider) separates rows. The older key names stay: pages use them. -->
    <Color x:Key="AppBgColor">#0C0A0D</Color>
    <Color x:Key="SurfaceColor">#131015</Color>
    <Color x:Key="SurfaceAltColor">#1B161A</Color>
    <Color x:Key="ElevatedColor">#221B21</Color>
    <Color x:Key="HoverColor">#2B232A</Color>

    <!-- Lines: the hairline between rows, and a stronger one for the rare real frame -->
    <Color x:Key="DividerColor">#261F25</Color>
    <Color x:Key="BorderColor">#342B32</Color>

    <!-- Text: three levels -->
    <Color x:Key="TextPrimaryColor">#F1ECEE</Color>
    <Color x:Key="TextSecondaryColor">#A99BA3</Color>
    <Color x:Key="TextMutedColor">#72676E</Color>
    <Color x:Key="TextOnAccentColor">#FFF6F8</Color>

    <!-- Accents. ThemeService replaces the three accent tones for the colour the player chose. -->
    <Color x:Key="AccentColor">#B5294A</Color>
    <Color x:Key="AccentHoverColor">#CF3558</Color>
    <Color x:Key="AccentPressedColor">#96203C</Color>
    <Color x:Key="GoldColor">#C9A227</Color>
    <Color x:Key="GoldMutedColor">#8A6F1B</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#56A877</Color>
    <Color x:Key="WarningColor">#D19A3A</Color>
    <Color x:Key="DangerColor">#D4513F</Color>

    <!-- Type: Manrope (OFL) for everything with weight - headings, buttons, row titles;
         Inter, which ships with Avalonia, for running text; Consolas for versions and captions. -->
    <FontFamily x:Key="DisplayFont">avares://STlauncher.App/Assets/Fonts#Manrope</FontFamily>
    <FontFamily x:Key="BodyFont">fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Menlo, monospace</FontFamily>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="BorderBrushSubtle" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldMutedBrush" Color="{StaticResource GoldMutedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- ===================== The quiet look: brushes by what they are for =====================
         New code names a brush by its job; the keys above stay for the pages that use them. -->
    <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource DividerColor}"/>
    <!-- A quiet button and its states. -->
    <SolidColorBrush x:Key="ControlBrush" Color="#1B161A"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#262026"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#171216"/>
    <!-- The hairline above a row: a shadow, so it follows the row's rounded corners and
         costs no extra element in a list of hundreds. No blur. -->
    <BoxShadows x:Key="RowLineShadow">0 -1 0 0 #261F25</BoxShadows>
    <BoxShadows x:Key="NoShadow">0 0 0 0 #00000000</BoxShadows>
    <!-- Under a dialog: the one soft shadow the look allows itself. -->
    <BoxShadows x:Key="DialogShadow">0 18 48 0 #80000000</BoxShadows>
    <!-- The soft light on the window's ground. ThemeService repaints it for the chosen accent. -->
    <RadialGradientBrush x:Key="GroundGlowBrush" Center="78%,34%" GradientOrigin="78%,34%" RadiusX="52%" RadiusY="62%">
        <GradientStop Offset="0" Color="#1FB5294A"/>
        <GradientStop Offset="1" Color="#00B5294A"/>
    </RadialGradientBrush>

    <!-- Once the accent's "theatre" hairline; now simply the hairline, kept under its old key. -->
    <LinearGradientBrush x:Key="AccentHairlineBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#00B5294A"/>
        <GradientStop Offset="0.5" Color="#C9B5294A"/>
        <GradientStop Offset="1" Color="#00B5294A"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#131015"/>
        <GradientStop Offset="1" Color="#0C0A0D"/>
    </LinearGradientBrush>

    <!-- Chrome: the rail and the strips sit on the ground itself now -->
    <SolidColorBrush x:Key="GhostBrush" Color="#000C0A0D"/>
    <SolidColorBrush x:Key="RailBrush" Color="#0C0A0D"/>
    <SolidColorBrush x:Key="UpdateBannerBrush" Color="#131015"/>
    <SolidColorBrush x:Key="IndexBorderBrush" Color="#1B161A"/>

    <!-- Glass cards on the main screen let the glow show through -->
    <SolidColorBrush x:Key="CardGlassBrush" Color="#CC131015"/>
    <SolidColorBrush x:Key="CardGlassWarmBrush" Color="#CC1F1218"/>
    <SolidColorBrush x:Key="TileWarmBrush" Color="#1F1218"/>
    <SolidColorBrush x:Key="HeroSideBrush" Color="#661B161A"/>

    <!-- Scrims behind dialogs and the screenshot viewer -->
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B0000000"/>
    <SolidColorBrush x:Key="LightboxScrimBrush" Color="#E60C0A0D"/>
    <SolidColorBrush x:Key="LightboxFrameBrush" Color="#0C0A0D"/>
    <SolidColorBrush x:Key="LightboxBorderBrush" Color="#22FFFFFF"/>

    <!-- "Installed" pill -->
    <SolidColorBrush x:Key="InstalledTagBrush" Color="#1E3A28"/>
    <SolidColorBrush x:Key="InstalledTagTextBrush" Color="#7DD39A"/>

    <!-- The warm glow behind the play area -->
    <RadialGradientBrush x:Key="StageGlowBrush" Center="42%,38%" GradientOrigin="42%,38%" RadiusX="60%" RadiusY="55%">
        <GradientStop Offset="0" Color="#34191F"/>
        <GradientStop Offset="1" Color="#000C0A0D"/>
    </RadialGradientBrush>

    <!-- Server page banner -->
    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#3A1A25"/>
        <GradientStop Offset="0.55" Color="#1A1119"/>
        <GradientStop Offset="1" Color="#0F0C11"/>
    </LinearGradientBrush>

    <!-- Build icon tile and the catalog card header -->
    <LinearGradientBrush x:Key="BuildIconBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2A1A22"/>
        <GradientStop Offset="1" Color="#1A1119"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProjectHeaderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2A1A22"/>
        <GradientStop Offset="1" Color="#151015"/>
    </LinearGradientBrush>

    <!-- Accent-derived defaults; ThemeService replaces them for the chosen accent -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#B5294A"/>
        <GradientStop Offset="1" Color="#B5294A"/>
    </LinearGradientBrush>
    <BoxShadows x:Key="HeroShadow">0 6 22 0 #33B5294A</BoxShadows>
    <BoxShadows x:Key="HeroShadowHover">0 10 30 0 #59B5294A</BoxShadows>


    <!-- ===================== Home: the lit stage and the glass over it ===================== -->
    <RadialGradientBrush x:Key="HomeGlowBrush" Center="84%,50%" GradientOrigin="84%,50%" RadiusX="46%" RadiusY="64%">
        <GradientStop Offset="0" Color="#575A1C2C"/>
        <GradientStop Offset="0.5" Color="#1F5A1C2C"/>
        <GradientStop Offset="1" Color="#000C0A0D"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HeroCardBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F02C151D"/>
        <GradientStop Offset="0.55" Color="#F01A1217"/>
        <GradientStop Offset="1" Color="#F0151015"/>
    </LinearGradientBrush>
    <BoxShadows x:Key="HeroCardShadow">0 10 24 0 #66000000</BoxShadows>
    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="60%" RadiusY="95%">
        <GradientStop Offset="0" Color="#66C02E4C"/>
        <GradientStop Offset="1" Color="#00C02E4C"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HeroGoldGlowBrush" Center="80%,0%" GradientOrigin="80%,0%" RadiusX="70%" RadiusY="90%">
        <GradientStop Offset="0" Color="#33E8C25A"/>
        <GradientStop Offset="1" Color="#00E8C25A"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="MosaicBrush" Color="#0CFFFFFF"/>


    <LinearGradientBrush x:Key="NickGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#FF8AA3"/>
        <GradientStop Offset="1" Color="#E8C25A"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="GlassChipBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="PillBrush" Color="#4D000000"/>
    <SolidColorBrush x:Key="PlateBrush" Color="#D9130F14"/>
    <BoxShadows x:Key="PlateShadow">0 8 18 0 #59000000</BoxShadows>

    <LinearGradientBrush x:Key="TileGoldBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#E62A2112"/>
        <GradientStop Offset="0.7" Color="#E617121A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileBlueBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#E614212A"/>
        <GradientStop Offset="0.7" Color="#E617121A"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TileGoldHoverBrush" Color="#80E8C25A"/>
    <SolidColorBrush x:Key="TileBlueHoverBrush" Color="#805FB6E8"/>
    <LinearGradientBrush x:Key="IconGoldBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F2D06B"/>
        <GradientStop Offset="1" Color="#A9781A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconBlueBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#5FB6E8"/>
        <GradientStop Offset="1" Color="#2A5E8C"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StageConeBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#1FFFD9A0"/>
        <GradientStop Offset="0.6" Color="#14C02E4C"/>
        <GradientStop Offset="1" Color="#00C02E4C"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="StageAuraBrush">
        <GradientStop Offset="0" Color="#55E24A6B"/>
        <GradientStop Offset="0.55" Color="#22C02E4C"/>
        <GradientStop Offset="1" Color="#00C02E4C"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PedestalBrush" Center="50%,35%" GradientOrigin="50%,35%">
        <GradientStop Offset="0" Color="#3A1E27"/>
        <GradientStop Offset="1" Color="#150E12"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="PedestalRimBrush" Color="#66E24A6B"/>
    <RadialGradientBrush x:Key="PedestalShadowBrush">
        <GradientStop Offset="0" Color="#CC000000"/>
        <GradientStop Offset="1" Color="#00000000"/>
    </RadialGradientBrush>

    <!-- ===================== Builds and the mod catalog ===================== -->
    <!-- A colour of its own for every build and every mod in the catalog; TintBrushConverter
         picks one by id. White text and icons have to read on all six. -->
    <LinearGradientBrush x:Key="TintBrush0" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#C02E4C"/>
        <GradientStop Offset="1" Color="#7E1B31"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush1" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#3F7BD9"/>
        <GradientStop Offset="1" Color="#24447A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush2" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#4C9A6A"/>
        <GradientStop Offset="1" Color="#235238"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush3" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#9D5BD2"/>
        <GradientStop Offset="1" Color="#4B2068"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush4" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#C98627"/>
        <GradientStop Offset="1" Color="#6B4514"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TintBrush5" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2F8FBF"/>
        <GradientStop Offset="1" Color="#1B4F6B"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TintMosaicBrush" Color="#1FFFFFFF"/>

    <!-- Where a catalog card is from: a dark badge on the coloured strip, a dot in the site's colour. -->
    <SolidColorBrush x:Key="SourceBadgeBrush" Color="#A6000000"/>
    <SolidColorBrush x:Key="ModrinthDotBrush" Color="#1BD96A"/>
    <SolidColorBrush x:Key="CurseForgeDotBrush" Color="#F16436"/>

    <!-- ===================== Skins: the editor's canvas ===================== -->
    <!-- The chequered paper under transparent pixels, the outline of each face, the pixel grid. -->
    <SolidColorBrush x:Key="SkinPaperBrush" Color="#241D22"/>
    <SolidColorBrush x:Key="SkinPaperAltBrush" Color="#2E262C"/>
    <SolidColorBrush x:Key="SkinOutlineBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="SkinGridBrush" Color="#38161014"/>

</ResourceDictionary>
