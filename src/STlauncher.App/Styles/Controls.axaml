<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================================
         THE VOCABULARY OF THE LOOK
         Every page is built from the classes below.

         The rules, after the correction:
           * A page is a few PANELS on the ground (the build list, the content, a group of
             settings, each column of a two-column page). The ground shows between them.
             Rows inside a panel stay rows with hairlines: no frame around every item.
           * Everything pressable looks pressable: a fill AND a 1 px edge. Text-only buttons
             (ghost, plain, link) are for tertiary things inside a panel next to a real
             button, never for the way to somewhere.
           * One FILLED accent button per screen ("primary"). The accent also guides: the
             main action of a panel is "accent-soft"; the active tab, the chosen row, the
             active rail item, key numbers and the focus ring are in the accent.
           * Gold marks what is new or needs a look. Green / amber / grey dots are state.
           * Rare actions still hide until the row is aimed at, and live in the "..." menu.

         SURFACES (Border)
           panel                a step lighter than the ground (white on the tinted ground
                                in the light theme), radius 16, a faint edge, padding 18.
                                No shadow.
                                  <Border Classes="panel">
                                      <StackPanel Spacing="12">
                                          <controls:Caption Text="{DynamicResource Home_Continue}"/>
                                          ...rows, settings, buttons...
                                      </StackPanel>
                                  </Border>
           panel flush          for a list that runs edge to edge: padding 6, which is what
                                lets a row's 10 px corner sit inside the panel's 16 px one.
                                A heading inside it takes Margin="12,10,12,6".
                                  <Border Classes="panel flush">
                                      <DockPanel>
                                          <controls:Caption DockPanel.Dock="Top" Margin="12,10,12,6" Text="Builds"/>
                                          <ListBox Classes="rows" .../>
                                      </DockPanel>
                                  </Border>
           panel tint           the page's lead panel: a faint wash of the accent from the
                                top left corner. One per page at most.
                                  <Border Classes="panel tint">...</Border>
           panel inset          a notice, a question, a consent text inside another panel:
                                it steps DOWN (radius 12). A "panel" nested in a "panel"
                                becomes this by itself.
                                  <Border Classes="panel inset" Padding="14,12">...</Border>
           card                 the older name of "panel" (padding 20). Use "panel".
           tile                 one figure with its caption; several make a row of metrics.
           Tones, bottom up: GroundBrush, FieldBrush (inputs), PanelBrush, RaisedBrush
           (menus), RowHoverBrush, ControlBrush (buttons). Edges: PanelEdgeBrush,
           FieldEdgeBrush, ControlEdgeBrush / ControlEdgeHoverBrush, HairlineBrush (rows).
           Accent: AccentBrush (fills), AccentHoverBrush (marks: bars, underlines, icons),
           AccentTextBrush (the accent as ink: readable on a panel), AccentSoftBrush +
           AccentEdgeBrush (a wash and its edge), RowSelectedBrush + SelectedRowShadow.

         BUTTONS (Button)
           (no class) / quiet   every ordinary action: a raised fill with a 1 px edge; both
                                lighten under the pointer, the fill drops when pressed.
                                Reads on the ground and on a panel, in both themes.
                                  <Button Content="Open"/>
           primary              THE filled crimson one. At most one per screen.
                                  <Button Classes="primary" Content="Create server"/>
           accent-soft          the main action of a panel when the screen's filled button
                                is elsewhere: an accent wash, an accent edge, accent ink.
                                  <Button Classes="accent-soft" Content="Add mods"/>
                                  <Button Classes="accent-soft"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconPlus}" Classes="small"/><TextBlock Text="Add mods"/></StackPanel></Button>
           ghost                no fill at rest, primary ink; an edge and a fill under the
                                pointer. Tertiary only: "Cancel" beside a real button.
                                  <Button Classes="ghost" Content="Cancel"/>
           plain                a ghost with tight padding and no edge, for a bare icon or
                                a word inside a line (the close cross of a notice).
           link                 primary ink, underlined; the accent under the pointer. For
                                "What changed", "Open the trash" inside a panel.
                                  <Button Classes="link" Content="Open the trash"/>
           icon                 30x30, one icon, the quiet button's fill and edge at rest.
                                Give it a ToolTip.Tip.
                                  <Button Classes="icon" ToolTip.Tip="Show file"><PathIcon Data="{StaticResource IconFolder}"/></Button>
           icon more            the "..." of a row or header; it carries a MenuFlyout.
                                  <Button Classes="icon more" ToolTip.Tip="More">
                                      <PathIcon Data="{StaticResource IconDots}"/>
                                      <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                                          <MenuItem Header="Show file" Command="..."/>
                                          <Separator/>
                                          <MenuItem Classes="danger" Header="Delete" Command="..."/>
                                      </MenuFlyout></Button.Flyout>
                                  </Button>
           hero                 the big play button of the home screen (56 high).
                                  <Button Classes="primary hero"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource IconPlay}"/><TextBlock Text="Play"/></StackPanel></Button>
           hero-side            its square companion (56x52, quiet).
           play                 "Play" in a header (44 high), the accent as well.
           small                modifier: about 30 high.
           danger               modifier: red words on the quiet fill, a red edge on hover.
           chip                 a filter chip that can be chosen; it has an edge, the chosen
                                one wears the accent wash and edge.
                                  <Button Classes="chip" Classes.active="{Binding ...}" Content="Maps"/>
           Sizes: the 1 px edge is inside the padding (15,9 + 1), so a button is as large
           as before. A TextBlock or PathIcon written inside a button takes the page's
           colours: for primary / accent-soft the styles below put the button's ink back
           for the shapes Button > TextBlock, Button > PathIcon and Button > StackPanel > those.
           Keyboard focus is a 2 px ring of the accent drawn by the button itself.

         ROWS
           Border.row           one item of a list: padding 12,11, radius 10, a hairline
                                above, a tone under the pointer (visible on a panel too).
                                Put a Grid inside.
               .reveal          any child (usually a StackPanel of icon buttons): hidden until the
                                row is under the pointer, or until Tab moves focus into it.
                                Hidden also means it cannot be clicked. Never the ONLY way to an
                                action: mirror it in the "..." menu and the context menu.
               .first           modifier: no hairline (the first row of a StackPanel loses its
                                line by itself; say "first" when the row sits in an ItemsControl).
               .selected        modifier: the chosen row: a wash of the accent and a thin
                                ring of it.
               .flat            modifier: no hairline at all (a sidebar list, padding 12,9).
               .off             modifier: a switched-off item, dimmed.
                                  <Border Classes="row">
                                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="14">
                                          <Border Classes="icon-tile" Background="{DynamicResource TintBrush2}"><TextBlock Classes="tile-letter" Text="S"/></Border>
                                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                              <TextBlock Classes="strong" Text="Sodium" TextTrimming="CharacterEllipsis"/>
                                              <TextBlock Classes="sub" Text="Renders the world faster" TextTrimming="CharacterEllipsis"/>
                                          </StackPanel>
                                          <StackPanel Grid.Column="2" Classes="reveal" Orientation="Horizontal" Spacing="4">
                                              <Button Classes="icon" ...update.../> <Button Classes="icon" ...folder.../> <Button Classes="icon more" .../>
                                          </StackPanel>
                                          <TextBlock Grid.Column="3" Classes="mono" Text="0.8.12" VerticalAlignment="Center"/>
                                          <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}"/>     (the always-visible trailing control)
                                      </Grid>
                                  </Border>
           ListBox.rows         the same row when the list is a ListBox (stays virtualised): the
                                item container is the row, "reveal" works inside it; the
                                selected item is the chosen row (accent wash and ring).
           :is(Control).reveal-host   any other container whose .reveal children show on hover
                                (a world's picture with actions over it).

         TABS, PICKERS, SWITCHES
           Border.tabs + Button.tab   underlined tabs: secondary ink at rest, the active one
                                (Classes.active) primary with an accent underline; its
                                count turns accent.
                                  <Border Classes="tabs"><StackPanel Orientation="Horizontal" Spacing="22">
                                      <Button Classes="tab" Classes.active="{Binding IsModsTab}" Command="...">
                                          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Mods"/><TextBlock Classes="count" Text="27"/></StackPanel>
                                      </Button>
                                  </StackPanel></Border>
           Border.segments + Button.segment   the segmented picker (one of a few values): a
                                field-coloured track with an edge; the chosen segment is a
                                raised slab in it.
                                  <Border Classes="segments"><StackPanel Orientation="Horizontal">
                                      <Button Classes="segment" Classes.active="{Binding IsDark}" Content="Dark"/> ...
                                  </StackPanel></Border>
           Button.index         an entry of a page's own index (the settings sections);
                                Classes.active marks the current one like a chosen row.
           ToggleSwitch         the switch, 34x20, no words beside it. Off is a grey track
                                with an edge and a light knob; on is the accent.
                                  <ToggleSwitch IsChecked="{Binding X}"/>
           TextBox, ComboBox, NumericUpDown need no class: a field fill with a visible
           edge, the accent edge on focus.

         SMALL THINGS
           Border.chip          a fact in a pill with an edge: <Border Classes="chip"><TextBlock Text="Boost is on"/></Border>
           Border.chip.warn     the same in gold ("3 updates"); put an icon in a StackPanel beside the text.
           Border.chip.accent   a key fact in the accent ("matches the server").
           Border.field + TextBox.bare   the search field (an edge, the accent on focus):
                                  <Border Classes="field" Width="260"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                      <PathIcon Data="{StaticResource IconSearch}" Classes="small"/>
                                      <TextBox Grid.Column="1" Classes="bare" Watermark="Search" Text="{Binding Query}"/>
                                  </Grid></Border>
           controls:Caption     a section caption: mono, UPPERCASE (it uppercases the text itself), muted.
                                  <controls:Caption Text="{DynamicResource Home_Continue}"/>    (xmlns:controls="using:STlauncher.App.Controls")
           TextBlock.caption    the same look for text that is already uppercase; TextBlock.label is its older, lowercase sibling.
           TextBlock.strong     a row's or a setting's title (bold). TextBlock.sub: the one muted line under it.
           TextBlock.muted      secondary ink at 12.5 (8:1 on a panel); TextBlock.faint is the
                                faintest level that may carry words (5.5:1 on a panel).
           TextBlock.accent     a key number or word in the accent ink (AccentTextBrush).
           TextBlock.gold       something new or needing a look.
           TextBlock.mono       a version or a loader: mono, secondary colour.
           TextBlock.tag        "there is 0.8.13": mono, the warning colour.
           TextBlock.kbd        the name of a key beside what it does ("Ctrl K", "Esc"): mono, muted.
           Ellipse.dot          a 7 px status dot, green; .warn gold, .off grey.
           Border.icon-tile     the 34x34 coloured square with a letter or an icon.
           Border.hairline      a 1 px line across.

         EMPTY STATE
           StackPanel.empty     nothing here yet: an icon in a soft round tile, a title, one
                                sentence, the next-step button. It centres itself in the
                                panel (or Grid cell) it stands in. Every part is optional
                                but the sentence; put two buttons in a horizontal StackPanel.
                                  <StackPanel Classes="empty" IsVisible="{Binding HasNoMods}">
                                      <Border Classes="empty-icon"><PathIcon Data="{StaticResource IconBuilds}"/></Border>
                                      <TextBlock Classes="strong" Text="No mods yet"/>
                                      <TextBlock Classes="sub" Text="Pick some from the catalog or drop .jar files here."/>
                                      <Button Classes="accent-soft" Content="Open the catalog" Command="..."/>
                                  </StackPanel>

         SETTINGS
           Border.setting       one setting: the name and one muted line on the left, the control
                                on the right, a hairline below. A group of them goes in a panel.
                                  <Border Classes="panel"><StackPanel>
                                      <TextBlock Classes="group" Text="Game"/>
                                      <Border Classes="setting"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                          <StackPanel VerticalAlignment="Center">
                                              <TextBlock Classes="strong" Text="Memory for the game"/>
                                              <TextBlock Classes="sub" Text="2048 MB, recommended for this build"/>
                                          </StackPanel>
                                          <Slider Grid.Column="1" Width="220"/>
                                      </Grid></Border>
                                      <Border Classes="setting last">...</Border>     (last: no hairline under the group's final setting)
                                  </StackPanel></Border>
           TextBlock.group      the heading of a group of settings (17, extra bold).

         PAGE HEADER
           TextBlock.page-title the title of a page or of the thing on it (26); add "large" (34)
                                for a page that is only its title, "huge" (54) on the home screen.
           StackPanel.meta      the line under it: facts with dot separators. An Ellipse between
                                two facts is the dot.
                                  <StackPanel Classes="meta"><TextBlock Classes="mono" Text="Fabric 0.17.2"/><Ellipse/><TextBlock Text="27 mods"/><Ellipse/><TextBlock Text="1.4 GB"/></StackPanel>
           The 52 px strip above every page belongs to the shell (MainWindow.axaml): its left
           holds the page's context label, one TextBlock per section; its right is the search.
           The rail belongs to the shell too: sections top down, settings last among them,
           the version and the player at the foot.

         OVER THE PAGE
           Border.scrim + Border.dialog   an in-window dialog:
                                  <Border Classes="scrim" IsVisible="{Binding IsOpen}"><Border Classes="dialog" Width="480">...</Border></Border>
           ToolTip, ContextMenu, MenuFlyout, Flyout, scroll bars need no class.
           MenuItem.danger marks a destructive item.
         ===================================================================================== -->

    <!-- ===================== Typography =====================
         Manrope carries everything with weight; running text is Inter at 13.5 medium. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBgBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style Selector="TextBlock.wrap">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.5"/>
    </Style>

    <!-- The title of a page, or of the one thing the page is about. -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.5"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.page-title.large">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="LetterSpacing" Value="-0.7"/>
    </Style>
    <Style Selector="TextBlock.page-title.huge">
        <Setter Property="FontSize" Value="54"/>
        <Setter Property="LetterSpacing" Value="-1.6"/>
        <Setter Property="LineHeight" Value="56"/>
    </Style>

    <!-- The heading of a group of settings. -->
    <Style Selector="TextBlock.group">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
    </Style>

    <!-- The name of a row or of a setting; the one muted line under it is "sub". -->
    <Style Selector="TextBlock.strong">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.sub">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- A section caption: mono, spaced, muted (5.5:1 on a panel since the correction).
         The text has to be uppercase already; controls:Caption does that for a string
         from the language file. -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LetterSpacing" Value="0.9"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- "there is 0.8.13" at the right of a row. -->
    <Style Selector="TextBlock.tag">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>

    <!-- The number beside a tab's name. -->
    <Style Selector="TextBlock.count">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The main screen's one big title. -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="42"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.8"/>
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
    </Style>

    <!-- The one large number of a metric tile. -->
    <Style Selector="TextBlock.value">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.5"/>
    </Style>

    <!-- Small uppercase eyebrow above a block. Not a heading: it labels, it does not title. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- The accent as ink: AccentBrush is a fill and too dark for words on a dark panel. -->
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <Style Selector="TextBlock.gold">
        <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
    </Style>

    <!-- ===================== Icons ===================== -->

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <Style Selector="PathIcon.small">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
    </Style>

    <Style Selector="PathIcon.large">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
    </Style>

    <Style Selector="PathIcon.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="PathIcon.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="PathIcon.gold">
        <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
    </Style>

    <!-- ===================== Surfaces =====================
         A page is a few panels on the ground: the build list, the content, a group of
         settings. A panel is one step lighter than the ground (white on the tinted ground
         in the light theme) with a faint edge and no shadow. Rows inside it stay rows with
         hairlines: a panel groups, it does not frame every item. -->

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <!-- For a list that runs from edge to edge: 6 px is what lets a row's 10 px corner
         sit inside the panel's 16 px one. Headings inside take Margin="12,10". -->
    <Style Selector="Border.panel.flush">
        <Setter Property="Padding" Value="6"/>
    </Style>
    <!-- The lead panel of a page: a faint wash of the accent from its top left corner. -->
    <Style Selector="Border.panel.tint">
        <Setter Property="Background" Value="{DynamicResource PanelTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelTintEdgeBrush}"/>
    </Style>
    <!-- A panel inside a panel (a notice, a question, a consent text) steps down instead
         of up, or it would be the same tone as what it lies on. "inset" says so outright. -->
    <Style Selector="Border.panel Border.panel, Border.panel.inset">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- The older name of a panel; the same surface. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- One figure with its caption; several of them make a row of metrics. -->
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Small pill that says what something is: "From the catalog", "Installed". -->
    <Style Selector="Border.tag">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.tag.accent > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Border.tag.success > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
    </Style>

    <Style Selector="Border.tag.installed">
        <Setter Property="Background" Value="{DynamicResource InstalledTagBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="Border.tag.installed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InstalledTagTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- A catalog card; the selected one carries the accent outline. -->
    <Style Selector="Border.mod-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.mod-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>
    <Style Selector="Border.mod-card.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- A chip that can be chosen: a category, a filter. An edge says it can be pressed;
         the chosen one wears the accent's wash and edge. -->
    <Style Selector="Button.chip">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.chip /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldEdgeBrush}"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.chip.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.chip.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/>
    </Style>

    <!-- Full-window scrim behind a lightbox: dark, flat, and a button so a click closes. -->
    <Style Selector="Button.scrim">
        <Setter Property="Background" Value="{DynamicResource LightboxScrimBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.scrim /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource LightboxScrimBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.scrim:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource LightboxScrimBrush}"/>
    </Style>

    <!-- A switched-off mod stays in the list, visibly off. -->
    <Style Selector="Border.mod-row.off">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- Just added: an outline for a while, so it can be found in a long list. -->
    <Style Selector="Border.mod-row.new">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Border.hairline">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!-- ===================== Over the page: menus, flyouts, tooltips, dialogs =====================
         The raised tone, one hairline, round corners. No shadow on a popup: it is a window
         of its own and a shadow would cost it a transparent margin. -->

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <!-- A destructive item says so by colour, and keeps it under the pointer. -->
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="MenuItem.danger:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="MenuItem > Separator, MenuFlyoutPresenter Separator, ContextMenu Separator">
        <Setter Property="Margin" Value="6,4"/>
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ToolTipBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MaxWidth" Value="340"/>
    </Style>
    <!-- An explanation moved into a tooltip is a sentence or two: it has to wrap. -->
    <Style Selector="ToolTip TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- A dialog inside the window: the scrim takes the whole window, the dialog sits in
         its middle. The one place a soft shadow is allowed. -->
    <Style Selector="Border.scrim">
        <Setter Property="Background" Value="{DynamicResource OverlayScrimBrush}"/>
    </Style>
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource DialogBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="26"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}"/>
    </Style>

    <!-- ===================== Buttons =====================
         A button with no class is the quiet one: a fill AND a 1 px edge, so it reads as a
         button on the ground and on a panel. Under the pointer both get lighter; pressed,
         the fill drops below its resting tone. The filled accent belongs to "primary" (one
         per screen); "accent-soft" is the main action of a panel.

         The edge is the button's own BorderBrush, so a class changes it either there
         (Button.x) or on the template's root (Button.x /template/ Border#PART_Root), which
         wins. The 1 px is inside the padding: 15,9 + 1 is the old 16,10. -->

    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="15,9"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>

    <Style Selector="Button:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>

    <Style Selector="Button:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
    </Style>

    <!-- A button that is really a container - a tile with a title and a description, a
         card, a swatch - must not hand the button's bold Manrope down to all of it. -->
    <Style Selector="Button.tile, Button.build-chip, Button.link-tile, Button.skin-card, Button.scrim, Button.glass-wide">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- The quiet button, said aloud: the same as no class at all. -->
    <Style Selector="Button.quiet">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>


    <!-- Primary action -->
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <Style Selector="Button.primary /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Button.primary:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>

    <!-- The main action of a panel, when the screen's one filled button is elsewhere: a
         wash of the accent, its edge, and the accent as ink. As many per screen as there
         are panels that need one; never two side by side. -->
    <Style Selector="Button.accent-soft">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.accent-soft /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/>
    </Style>
    <Style Selector="Button.accent-soft:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSoftHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.accent-soft:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentSoftPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.accent-soft > StackPanel > TextBlock, Button.accent-soft > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.accent-soft > StackPanel > PathIcon, Button.accent-soft > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <!-- The one big button of the main screen. -->
    <!-- The big play button of the home screen: with "primary" it is the accent, flat,
         with a quiet glow that deepens under the pointer. -->
    <Style Selector="Button.hero">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="34,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.hero > StackPanel > TextBlock, Button.hero > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.hero > StackPanel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <Style Selector="Button.hero /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource HeroGradientBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource HeroShadow}"/>
    </Style>

    <Style Selector="Button.hero:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource HeroShadowHover}"/>
    </Style>

    <Style Selector="Button.hero:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource HeroShadow}"/>
    </Style>

    <Style Selector="Button.hero:pressed">
        <Setter Property="RenderTransform" Value="scale(0.985)"/>
    </Style>

    <!-- A square companion to the hero button: same height, one icon, quiet. -->
    <Style Selector="Button.hero-side">
        <Setter Property="Height" Value="56"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.hero-side /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
    </Style>

    <!-- A class style outranks the plain :pointerover rule, so the side button needs its own. -->
    <Style Selector="Button.hero-side:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>

    <!-- ===================== Navigation rail =====================
         Icon over label in a 76 px rail. The labels are the secondary ink, not the
         faintest. The section the player is in cannot be missed: a pill washed with the
         accent, the icon in the accent, the label bold, and a bar of the accent at the
         rail's edge (Border.rail-mark, the button's neighbour in MainWindow.axaml). -->

    <Style Selector="Button.rail">
        <Setter Property="Width" Value="62"/>
        <Setter Property="Padding" Value="0,9,0,7"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.rail /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>

    <Style Selector="Button.rail TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.rail PathIcon">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.16"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.rail:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.rail:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.rail:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>

    <Style Selector="Button.rail.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Button.rail.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Button.rail.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
    </Style>

    <!-- The bar at the rail's left edge beside the section the player is in. -->
    <Style Selector="Border.rail-mark">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="0,2,2,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.rail-mark.active">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- The version at the foot of the rail: muted while current; gold, with an arrow,
         when an update waits. Gold is the colour of "there is something new", the accent
         stays with the screen's main action. -->
    <Style Selector="Button.version-pill">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
    </Style>
    <Style Selector="Button.version-pill:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
    </Style>
    <Style Selector="Button.version-pill TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="Button.version-pill /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>

    <Style Selector="Button.version-pill:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>

    <Style Selector="Button.version-pill.available TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
    </Style>
    <Style Selector="Button.version-pill.available PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
    </Style>

    <Style Selector="Button.version-pill.available /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GoldMutedBrush}"/>
    </Style>

    <Style Selector="Button.version-pill.available:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>

    <!-- The avatar at the foot of the rail, and the one on the main screen. -->
    <Style Selector="Button.avatar">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.avatar /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
    </Style>

    <Style Selector="Button.avatar:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
    </Style>

    <!-- The face fills the button, so a colour change is invisible: it grows instead. -->
    <Style Selector="Button.avatar:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.08)"/>
    </Style>

    <!-- Section index on the settings page. -->
    <Style Selector="Button.index">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.index /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>

    <Style Selector="Button.index:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Button.index:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- The section the page is on: the chosen row's wash and ring. -->
    <Style Selector="Button.index.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.index.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
    </Style>

    <!-- The selected build in the list carries an accent bar on its left edge. -->
    <Style Selector="ListBox.builds ListBoxItem">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.builds ListBoxItem Border.selection-bar">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.builds ListBoxItem:selected Border.selection-bar">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- Ghost: no fill at rest, but the ink is the primary one and an edge and a fill come
         under the pointer. For a tertiary action beside a real button ("Cancel"), never
         for the way to somewhere. Its 1 px edge is there, transparent, so it is the same
         height as the button it stands next to. -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.ghost /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>

    <!-- Plain: a ghost with tight padding, for a bare icon or a word inside a line of
         text. The secondary ink at rest, the primary one and a fill under the pointer. -->
    <Style Selector="Button.plain">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.plain /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>

    <Style Selector="Button.plain:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.plain > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.plain:pointerover > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- A link: the primary ink, underlined; the accent under the pointer. For the way to
         something further inside a panel ("What changed"), next to real buttons. -->
    <Style Selector="Button.link">
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource AccentHoverBrush}" BorderThickness="2" CornerRadius="4" Margin="-4,-2"/>
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.link /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Button.link:focus-visible /template/ Border#PART_Root">
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.link:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>
    <Style Selector="Button.link:pressed">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>

    <!-- A square button with one icon: the actions of a row or a header. It has the quiet
         button's fill and edge at rest: a bare glyph does not say it can be pressed. -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.icon > PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.icon /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>
    <Style Selector="Button.icon:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
    </Style>
    <!-- A menu is open from it: it stays lit, so the menu has an owner. -->
    <Style Selector="Button.icon:flyout-open">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>
    <Style Selector="Button.icon:flyout-open /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>

    <!-- Destructive, but not shouting: red words on the quiet fill and edge. -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="Button.danger /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.plain.small">
        <Setter Property="Padding" Value="7,5"/>
    </Style>

    <!-- A quiet remove button that only turns red when aimed at. -->
    <Style Selector="Button.icon-danger">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Padding" Value="7,3"/>
    </Style>
    <Style Selector="Button.icon-danger /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>
    <Style Selector="Button.icon-danger:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Button.icon-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- A tile that is a link: icon, title, address. -->
    <Style Selector="Button.link-tile">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.link-tile /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>
    <Style Selector="Button.link-tile:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>

    <!-- Accent swatches: a circle of the colour, a ring when chosen. -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
    </Style>
    <Style Selector="Button.swatch /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Button.swatch.selected /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.swatch:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.12)"/>
    </Style>

    <!-- ===================== Sidebar navigation ===================== -->

    <Style Selector="Button.nav">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.nav /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.nav PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="Button.nav:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>

    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.nav.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Button.nav.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
    </Style>

    <!-- ===================== Segmented switcher ===================== -->

    <Style Selector="Button.segment">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.segment /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.segment:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.segment.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- The chosen segment is a small quiet button lying in the track. -->
    <Style Selector="Button.segment.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SegmentActiveShadow}"/>
    </Style>
    <Style Selector="Button.segment:pressed">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>

    <Style Selector="Button.segment.active:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>

    <!-- Update row: quiet while there is nothing to do, accented the moment there is.
         It lives in the sidebar permanently, so it must not shout by default. -->
    <Style Selector="Button.update-row">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    </Style>

    <Style Selector="Button.update-row /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    </Style>

    <Style Selector="Button.update-row:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>

    <Style Selector="Button.update-row.available">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.update-row.available /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.update-row.available:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- Disabled inputs have to read as disabled. Targeted at leaf controls rather than
         ":disabled" alone - a blanket rule dims a disabled container and then dims its
         children again on top. -->
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="NumericUpDown:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- ===================== Inputs ===================== -->

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- The switch of a row or a setting is the launcher's own template: SwitchTheme.axaml. -->

    <!-- ===================== Lists ===================== -->

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- The chosen item: a wash of the accent and a thin ring of it. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- ===================== Progress ===================== -->

    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource ControlEdgeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ===================== Title bar ===================== -->

    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.chrome /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>

    <Style Selector="Button.chrome PathIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>

    <Style Selector="Button.chrome:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>

    <Style Selector="Button.chrome-close:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>


    <!-- ===================== Home ===================== -->

    <Style Selector="TextBlock.greeting">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="-0.8"/>
    </Style>

    <Style Selector="TextBlock.display.hero">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="LetterSpacing" Value="-0.9"/>
    </Style>

    <!-- The card the build to continue with sits in: glass, a glow from one corner. -->
    <Style Selector="Border.hero-card">
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="Background" Value="{DynamicResource HeroCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource HeroCardShadow}"/>
    </Style>

    <!-- A fact in a pill: "Boost is on". With "warn" it is something to look at: "3 updates". -->
    <Style Selector="Border.chip">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Gold is for what is new or needs a look: the chip takes its edge too. -->
    <Style Selector="Border.chip.warn">
        <Setter Property="BorderBrush" Value="{DynamicResource GoldMutedBrush}"/>
    </Style>
    <!-- A key fact in the accent: "matches the server", "selected". -->
    <Style Selector="Border.chip.accent">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/>
    </Style>
    <Style Selector="Border.chip > TextBlock, Border.chip > StackPanel > TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip > StackPanel > PathIcon">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip.warn > TextBlock, Border.chip.warn > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.chip.warn > StackPanel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.chip.accent > TextBlock, Border.chip.accent > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Border.chip.accent > StackPanel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <!-- A rounded note floating over the stage or beside a heading. -->
    <Style Selector="Border.pill">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.pill.small">
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Cards and panels that let the stage's light through. -->
    <Style Selector="Border.card.glass">
        <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style Selector="Border.panel.glass">
        <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- The plate under the figure: the name and what can be changed about it. -->
    <Style Selector="Border.plate">
        <Setter Property="Padding" Value="16,12,12,12"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource PlateBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource PlateShadow}"/>
    </Style>

    <!-- A way to play other than the big button: a wide tile, tinted by what it leads to. -->
    <Style Selector="Button.tile">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tile.gold /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource TileGoldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.tile.gold:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource TileGoldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TileGoldHoverBrush}"/>
    </Style>
    <Style Selector="Button.tile.blue /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource TileBlueBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.tile.blue:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource TileBlueBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TileBlueHoverBrush}"/>
    </Style>

    <!-- Another build on the home screen: pick it and it becomes the one to play. -->
    <Style Selector="Button.build-chip">
        <Setter Property="Padding" Value="11"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.build-chip /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.build-chip:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassChipBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>
    <Style Selector="Button.build-new">
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.build-new /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>
    <Style Selector="Button.build-new:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>

    <!-- A small square button on glass: change the pose, edit the name. -->
    <Style Selector="Button.glass-icon">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.glass-icon /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.glass-icon:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassChipBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>

    <!-- ===================== Emotes ===================== -->

    <!-- The pose pill over the stage as a button: the same note, and it opens the list of poses and emotes. -->
    <Style Selector="Button.pill">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.pill /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.pill:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>

    <!-- ===================== Builds and the mod catalog =====================
         The same glass as on the home screen. Nothing here casts a blurred shadow: a build
         shows a hundred of these rows and a catalog page forty cards. -->

    <!-- The track a row of segments sits in: the build's tabs, the catalog's source. -->
    <Style Selector="Border.segments">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.segments Button.segment">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Border.segments Button.segment:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Border.segments Button.segment.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
    </Style>

    <!-- A TextBlock or an icon written out inside a button takes the page's colours, not
         the button's. In the dark theme the two are nearly the same; in the light one that
         is dark ink on an accent fill. These put the button's colour back. Child selectors
         only: a descendant one would reach into a menu opened from the button. -->
    <Style Selector="Button.segment > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.segment.active > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.chip.active > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.primary > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.primary > StackPanel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.primary > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- The same for the quiet remove button: its cross is grey until aimed at, then red. -->
    <Style Selector="Button.icon-danger > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Button.icon-danger:pointerover > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- A search field: the icon and the words share one outlined box. -->
    <Style Selector="Border.field">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.field:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>
    <Style Selector="Border.field > Grid > PathIcon, Border.field > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.field:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- The text box inside such a field draws nothing of its own, in any state. -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- One thing the build holds - a mod, a pack, a shader. The older name of "row":
         it looks the same now, and a page being redone should say "row". -->
    <Style Selector="Border.mod-line">
        <Setter Property="Padding" Value="12,11"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.mod-line:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="Border.mod-line.selected">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/>
    </Style>
    <!-- Switched off: still in the list, visibly off. -->
    <Style Selector="Border.mod-line.off">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <!-- Just added: outlined for a while, so it can be found in a long list. -->
    <Style Selector="Border.mod-line.new">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- A mod in the catalog: a large card under a strip of its own colour. -->
    <Style Selector="Border.mod-tile">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.mod-tile:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>
    <Style Selector="Border.mod-tile.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- The first letter of a title, standing in for a logo. -->
    <Style Selector="TextBlock.tile-letter">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- "Modrinth" or "CurseForge" on a card's strip. -->
    <Style Selector="Border.source-badge">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource SourceBadgeBrush}"/>
    </Style>
    <Style Selector="Border.source-badge TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- A card's one action, and what stands in its place once the mod is in the build. -->
    <Style Selector="Button.add">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Button.add > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.in-build">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource InstalledTagBrush}"/>
    </Style>
    <Style Selector="Border.in-build TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource InstalledTagTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- "Play" in a build's header: the home screen's big button, at a size a header holds. -->
    <Style Selector="Button.play">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.play > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.play > StackPanel > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.play /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.play:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.play:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>

    <!-- ===================== Skins ===================== -->

    <!-- A skin in the library: the figure and the name on glass; the chosen one wears the accent. -->
    <Style Selector="Button.skin-card">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.skin-card /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.skin-card:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>
    <Style Selector="Button.skin-card.selected /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <!-- A drawing tool in the editor: quiet on glass, the accent when it is the one in hand. -->
    <Style Selector="Button.tool">
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.tool /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassChipBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
    </Style>
    <Style Selector="Button.tool.active">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.tool.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.tool.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- A colour to draw with. The colour itself is a plate inside, so hovering cannot repaint it. -->
    <Style Selector="Button.colour">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.colour /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
    </Style>
    <Style Selector="Button.colour:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GlassChipBrush}"/>
    </Style>
    <Style Selector="Button.colour:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.12)"/>
    </Style>

    <!-- =====================================================================================
         The quiet look: rows, tabs, settings, headers. Usage is at the top of this file.
         ===================================================================================== -->

    <!-- ===================== Rows =====================
         One item of a list. No frame, no fill: a hairline above, a tone under the pointer
         that can be seen on the ground and on a panel. The chosen row is washed with the
         accent and ringed with it. Hairline and ring are shadows without blur, so a list
         of hundreds costs no extra elements. -->
    <Style Selector="Border.row">
        <Setter Property="Padding" Value="12,11"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource RowLineShadow}"/>
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="Border.row.selected">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
    </Style>
    <!-- The first row has nothing above it to be divided from. -->
    <Style Selector="StackPanel > Border.row:nth-child(1)">
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="Border.row.first">
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="Border.row.flat">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="Border.row.flat.selected">
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
    </Style>
    <Style Selector="Border.row.off">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- The same row when the list is a ListBox: the container is the row. -->
    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="12,11"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BoxShadow" Value="{DynamicResource RowLineShadow}"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:nth-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource SelectedRowShadow}"/>
    </Style>

    <!-- Revealed on hover: the rare actions of a row. Hidden means unseen AND out of the
         pointer's reach, so a tap on a touch screen cannot hit a button nobody saw. The
         keyboard still gets there: Tab into the hidden group and the group shows itself.
         (Focus anywhere in the row would be the simpler rule, but a click on the row's
         switch leaves focus there, and the row would stay lit after the pointer has gone.) -->
    <Style Selector=":is(Control).reveal">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.row:pointerover :is(Control).reveal, Border.mod-line:pointerover :is(Control).reveal, ListBoxItem:pointerover :is(Control).reveal, :is(Control).reveal-host:pointerover :is(Control).reveal">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector=":is(Control).reveal:focus-within">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>

    <!-- The coloured square at the start of a row: a letter or an icon on a build's tint. -->
    <Style Selector="Border.icon-tile">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.icon-tile > TextBlock.tile-letter">
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.icon-tile > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- A status dot: green by default. -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Ellipse.dot.warn">
        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Ellipse.dot.off">
        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- ===================== Tabs =====================
         Words on a hairline; the one the page is on is underlined in the accent. -->
    <Style Selector="Border.tabs">
        <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Button.tab">
        <Setter Property="Padding" Value="0,0,0,9"/>
        <Setter Property="Margin" Value="0,0,0,-1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.tab /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBrush}"/>
    </Style>
    <Style Selector="Button.tab > StackPanel > TextBlock, Button.tab > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.tab:pointerover > StackPanel > TextBlock, Button.tab:pointerover > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.tab.active > StackPanel > TextBlock, Button.tab.active > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <!-- The number beside the chosen tab is a key number: the accent. -->
    <Style Selector="Button.tab.active > StackPanel > TextBlock.count">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.tab.active /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.tab:pressed">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>

    <!-- ===================== Settings =====================
         One setting: what it is on the left, the control on the right, a hairline below. -->
    <Style Selector="Border.setting">
        <Setter Property="Padding" Value="0,15"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.setting.last">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Border.setting TextBlock.sub">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ===================== Page header =====================
         Facts under a title, a dot between two of them. -->
    <Style Selector="StackPanel.meta">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>
    <Style Selector="StackPanel.meta > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.meta > Ellipse">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The label in the strip above a page: where the player is. -->
    <Style Selector="TextBlock.context">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The search entry in that strip: a button dressed as a field, 300 wide; "compact"
         leaves only its icon when the strip has no room for the words. -->
    <Style Selector="Button.search-entry">
        <Setter Property="Width" Value="330"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- It has to read as a field: the field's fill, the field's edge, a placeholder in
         the secondary ink. Under the pointer the edge takes the accent, as a field's does
         on focus. -->
    <Style Selector="Button.search-entry /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.search-entry:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.search-entry TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.search-entry PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.search-entry:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <!-- "Ctrl K" as a keycap. -->
    <Style Selector="Button.search-entry Border.keycap">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.search-entry.compact Border.keycap">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.search-entry:pressed">
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>
    <Style Selector="Button.search-entry.compact">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.search-entry.compact TextBlock">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.search-entry.compact > Grid">
        <Setter Property="ColumnSpacing" Value="0"/>
    </Style>

    <!-- The name of a key beside what it does: "Ctrl K", "Esc". -->
    <Style Selector="TextBlock.kbd">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- Red stays red under the pointer, whatever else the button is. -->
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- ===================== Empty state =====================
         Nothing here yet: an icon in a soft round tile, a title, one sentence, and the
         button that does something about it. Centred in the panel it stands in. -->
    <Style Selector="StackPanel.empty">
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="Margin" Value="24,28"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.empty > Border.empty-icon">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelTintEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="StackPanel.empty > Border.empty-icon > PathIcon">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="StackPanel.empty > TextBlock.strong">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="StackPanel.empty > TextBlock.sub">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="MaxWidth" Value="380"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="StackPanel.empty > Button, StackPanel.empty > StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- The theme's own radio button keeps its dark-theme words and ring in the light theme. -->
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="RadioButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="RadioButton:not(:checked) /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

</Styles>
