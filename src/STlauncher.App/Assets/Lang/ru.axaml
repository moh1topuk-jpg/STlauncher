    <!-- Mod updates -->
    <x:String x:Key="Mods_CheckUpdates">Проверить обновления</x:String>
    <x:String x:Key="Mods_CheckUpdatesHint">Сверит моды с Modrinth и покажет, у каких есть новая версия. Само ничего не обновляет.</x:String>
    <x:String x:Key="Mods_UpdateAll">Обновить все ({0})</x:String>
    <x:String x:Key="Mods_UpdateOne">Поставить эту версию</x:String>
