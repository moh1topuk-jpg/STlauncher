    <!-- My server: a server the player hosts for friends -->
    <x:String x:Key="Nav_Host">My server</x:String>
    <x:String x:Key="Host_Title">My server</x:String>
    <x:String x:Key="Host_Subtitle">A Minecraft server on this computer. Only the people you invite can join.</x:String>
    <x:String x:Key="Host_Another">Another server</x:String>
    <x:String x:Key="Host_EmptyTitle">Your own server for friends</x:String>
    <x:String x:Key="Host_EmptyText">The launcher sets up a Minecraft server on this computer and takes the game version and the mods from your build. Friends join by an invite - one line of text. The server runs while the launcher is open, and nothing is downloaded without your say.</x:String>
    <x:String x:Key="Host_Create">Create a server</x:String>
    <x:String x:Key="Host_CreateTitle">A new server</x:String>
    <x:String x:Key="Host_CreateBuild">Based on the build</x:String>
    <x:String x:Key="Host_CreateBuildHint">The game version and the loader come from the build.</x:String>
    <x:String x:Key="Host_CreateName">Name</x:String>
    <x:String x:Key="Host_CreateNameHint">For example, Our world</x:String>
    <x:String x:Key="Host_CreateWorld">World</x:String>
    <x:String x:Key="Host_WorldNew">A new world</x:String>
    <x:String x:Key="Host_WorldCopy">A copy of “{0}” · {1}</x:String>
    <x:String x:Key="Host_CreateMemory">Server memory</x:String>
    <x:String x:Key="Host_MemoryValue">{0:0.#} GB</x:String>
    <x:String x:Key="Host_MemoryHint">2 GB is enough for a few friends without mods; with mods 4 GB is better.</x:String>
    <x:String x:Key="Host_PlanTitle">What will happen</x:String>
    <x:String x:Key="Host_PlanBusy">Finding out what has to be downloaded…</x:String>
    <x:String x:Key="Host_PlanServerJar">Minecraft server {0}</x:String>
    <x:String x:Key="Host_PlanLoaderLauncher">{0} {1} loader</x:String>
    <x:String x:Key="Host_PlanLoaderLibraries">{0} libraries</x:String>
    <x:String x:Key="Host_PlanLoaderInstaller">{0} {1} installer</x:String>
    <x:String x:Key="Host_PlanByInstaller">{0} · {1} · the {2} installer downloads this itself</x:String>
    <x:String x:Key="Host_PlanJava">Java {0}</x:String>
    <x:String x:Key="Host_PlanFrom">{0} · {1}</x:String>
    <x:String x:Key="Host_PlanFromAbout">{0} · about {1}</x:String>
    <x:String x:Key="Host_PlanFromUnknown">{0} · size not known in advance</x:String>
    <x:String x:Key="Host_PlanAtFirstStart">{0} · about {1} · the server fetches them itself on its first start</x:String>
    <x:String x:Key="Host_PlanTotal">To download in all</x:String>
    <x:String x:Key="Host_PlanAbout">about {0}</x:String>
    <x:String x:Key="Host_PlanJavaFound">Java {0} is already on this computer</x:String>
    <x:String x:Key="Host_PlanJavaFoundDetail">It does not have to be downloaded.</x:String>
    <x:String x:Key="Host_PlanJavaUnknown">This computer has no Java {0}</x:String>
    <x:String x:Key="Host_PlanJavaUnknownDetail">How big the download is could not be learnt: adoptium.net does not answer. The launcher will ask about it again before the server starts.</x:String>
    <x:String x:Key="Host_PlanMods">Mods copied from the build into the server: {0}</x:String>
    <x:String x:Key="Host_PlanModsNone">The build has no mods for a server</x:String>
    <x:String x:Key="Host_PlanModsNoneDetail">The server will run without mods.</x:String>
    <x:String x:Key="Host_PlanModsSkipped">Left out of the server: {0}</x:String>
    <x:String x:Key="Host_PlanSkippedClient">Only for the client: {0}.</x:String>
    <x:String x:Key="Host_PlanSkippedLikelyClient">Look like client mods (they ask for the game on the client side only): {0}.</x:String>
    <x:String x:Key="Host_PlanModsForge">{0} mods rarely say whether a server needs them</x:String>
    <x:String x:Key="Host_PlanModsForgeDetail">Only the ones that say so themselves are left out. If the server does not start because of a client mod, remove it from the “mods” folder of the server.</x:String>
    <x:String x:Key="Host_PlanSkippedDisabled">Switched off in the build: {0}.</x:String>
    <x:String x:Key="Host_PlanAndMore">{0} and {1} more</x:String>
    <x:String x:Key="Host_PlanWorldNew">A new world</x:String>
    <x:String x:Key="Host_PlanWorldNewDetail">Made when the server first starts.</x:String>
    <x:String x:Key="Host_PlanWorldCopy">A copy of the world “{0}”</x:String>
    <x:String x:Key="Host_PlanWorldCopyDetail">{0}. The original stays in the build, untouched.</x:String>
    <x:String x:Key="Host_PlanUntouched">The build “{0}” is not changed</x:String>
    <x:String x:Key="Host_PlanUntouchedDetail">Everything is copied into the server; nothing in the build is moved or deleted.</x:String>
    <x:String x:Key="Host_PlanAccess">Only nicknames on the list can join</x:String>
    <x:String x:Key="Host_PlanAccessDetail">You ({0}) go on the list and become the operator. Friends are added afterwards.</x:String>
    <x:String x:Key="Host_PlanFirewall">Windows will ask about Java</x:String>
    <x:String x:Key="Host_PlanFirewallDetail">On the first start the firewall asks whether Java may accept connections. That is the server itself - allow it.</x:String>
    <x:String x:Key="Host_Eula">I accept the Minecraft licence agreement (EULA)</x:String>
