    <x:String x:Key="Mods_UpdatedKeptPrevious">{0} updated to {1}. The previous version is kept: right-click the mod and pick "Bring back the previous version".</x:String>
    <x:String x:Key="Mods_UpdateFailedKept">{0} was not updated and stays as it was. {1}</x:String>
