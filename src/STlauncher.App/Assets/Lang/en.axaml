    <x:String x:Key="Mods_UpdateAllPartly">Updated {0} of {1}. Left as they were: {2}</x:String>
    <x:String x:Key="Mods_RestorePrevious">Bring back the previous version ({0})</x:String>
    <x:String x:Key="Mods_RestoredPrevious">{0}: the previous version is back. The newer file is kept, so this can be undone the same way.</x:String>
    <x:String x:Key="Mods_RestoreFailed">{0} stays as it was. {1}</x:String>
    <x:String x:Key="Mods_ReplaceGameRunning">The game is running: close it and try again.</x:String>
    <x:String x:Key="Mods_ReplaceRestore">The kept file could not be put back: {0}</x:String>
