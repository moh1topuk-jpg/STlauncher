<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STlauncher.App.App"
             xmlns:local="using:STlauncher.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://STlauncher.App/Styles/Colors.axaml"/>
                <ResourceInclude Source="avares://STlauncher.App/Styles/Fluent.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://STlauncher.App/Styles/Controls.axaml"/>
    </Application.Styles>
</Application>
