<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:sys="using:System"
             x:Class="STlauncher.App.Views.Pages.GamePage"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <Grid Margin="22" ColumnDefinitions="*,320" ColumnSpacing="16" VerticalAlignment="Top">

            <StackPanel Grid.Column="0" Spacing="14">

                <!-- Build card -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource Game_Instance}" Classes="label"/>
                                <ComboBox ItemsSource="{Binding Instances}"
                                          SelectedItem="{Binding SelectedInstance}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="inst:Instance">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Classes="faint">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="VersionId" TargetNullValue="—"/>
                                                            <Binding Path="Loader"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Bottom"
                                    Content="{DynamicResource Game_SetupBuild}"
                                    Command="{Binding SelectSectionCommand}"
                                    CommandParameter="Builds"/>
                        </Grid>

                        <Border Classes="hairline"/>

                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="14">
                            <TextBlock Text="{DynamicResource Game_Version}" Classes="faint"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.VersionId, TargetNullValue=—}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Game_Loader}" Classes="faint"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding SelectedInstance.Loader}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Launch -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Button Classes="primary" Content="{DynamicResource Game_Play}"
                                Command="{Binding PlayCommand}" IsEnabled="{Binding !IsBusy}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Height="56" FontSize="18"/>

                        <Button Classes="ghost" Content="{DynamicResource Game_PlayOnServer}"
                                Command="{Binding PlayOnServerCommand}" IsEnabled="{Binding !IsBusy}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Height="42"/>

                        <!-- Launch progress -->
                        <Border Classes="panel" Padding="14" IsVisible="{Binding ShowLaunchProgress}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                             Height="6"/>
                            </StackPanel>
                        </Border>

                        <Button Classes="ghost small" HorizontalAlignment="Left"
                                Content="{DynamicResource Game_OpenConsole}"
                                IsVisible="{Binding ShowDeveloperConsole}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Console"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Profile -->
            <StackPanel Grid.Column="1" Spacing="14">

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Game_Nickname}" Classes="label"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="56" Height="56" CornerRadius="8" Background="#2A2028"
                                    ClipToBounds="True">
                                <Image Source="{Binding Avatar}" Stretch="Uniform" Width="56" Height="56"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="15"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Game_OfflineMode}" Classes="faint"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBox Text="{Binding Username}" Watermark="Player"/>

                        <Border Classes="hairline"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Game_Nicknames}" Classes="faint"/>
                            <ItemsControl ItemsSource="{Binding Nicknames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Button Classes="ghost small" Margin="0,0,6,6" Content="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyNicknameCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding NewNickname}"
                                         Watermark="{DynamicResource Game_NicknameHint}"/>
                                <Button Grid.Column="1" Classes="ghost small"
                                        Content="{DynamicResource Game_SaveNickname}"
                                        Command="{Binding SaveNicknameCommand}"/>
                                <Button Grid.Column="2" Classes="danger small"
                                        Content="{DynamicResource Game_RemoveNickname}"
                                        Command="{Binding RemoveNicknameCommand}"
                                        CommandParameter="{Binding Username}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
