<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:sys="using:System"
             xmlns:conv="using:STlauncher.App.Converters"
             xmlns:controls="using:STlauncher.App.Controls"
             x:Class="STlauncher.App.Views.Pages.GamePage"
             x:DataType="vm:MainWindowViewModel">

    <!-- The main screen is a stage, not a form: the build's name, one big button, and the
         player in the corner. Everything adjustable lives elsewhere. -->
    <Panel>

        <!-- A soft warm glow behind the play area, so the screen has a centre. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="42%,38%" GradientOrigin="42%,38%" RadiusX="60%" RadiusY="55%">
                    <GradientStop Offset="0" Color="#34191F"/>
                    <GradientStop Offset="1" Color="#000C0A0D"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Embers drifting behind the stage; off in the settings for those who want it still. -->
        <controls:EmberField IsActive="{Binding AnimatedBackground}"/>

        <ScrollViewer>
            <Grid Margin="72,32" ColumnDefinitions="*,300" ColumnSpacing="56"
                  MaxWidth="1080" VerticalAlignment="Center">

                <!-- ======== Stage ======== -->
                <StackPanel Grid.Column="0" Spacing="28" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{DynamicResource Game_Instance}" Classes="label" VerticalAlignment="Center"/>
                            <Border Classes="tag accent" IsVisible="{Binding IsCatalogInstance}">
                                <TextBlock Text="{DynamicResource Builds_TagCatalog}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedInstance.Name}" Classes="display"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding SelectedInstance.VersionId, TargetNullValue=—}" Classes="muted" FontSize="14"/>
                            <TextBlock Text="•" Classes="faint"/>
                            <TextBlock Text="{Binding SelectedInstance.Loader}" Classes="muted" FontSize="14"/>
                            <TextBlock Text="•" Classes="faint"/>
                            <TextBlock Classes="muted" FontSize="14"
                                       Text="{Binding BuildModCount, Converter={x:Static conv:ModCountConverter.Instance}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Launch. One primary action; the build picker sits beside it. -->
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Button Classes="primary hero"
                                    Command="{Binding PlayCommand}" IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <PathIcon Data="{StaticResource IconPlay}" Classes="large"/>
                                    <TextBlock Text="{DynamicResource Game_Play}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="hero-side" ToolTip.Tip="{DynamicResource Game_PickBuild}">
                                <PathIcon Data="{StaticResource IconChevronDown}"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Spacing="10" Width="320">
                                            <TextBlock Text="{DynamicResource Game_PickBuild}" Classes="label"/>
                                            <ListBox ItemsSource="{Binding Instances}"
                                                     SelectedItem="{Binding SelectedInstance}" MaxHeight="320">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="inst:Instance">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Classes="faint" Text="{Binding VersionId, TargetNullValue=—}"/>
                                                                <TextBlock Classes="faint" Text="·"/>
                                                                <TextBlock Classes="faint" Text="{Binding Loader}"/>
                                                                <TextBlock Classes="faint" Text="·"/>
                                                                <TextBlock Classes="faint"
                                                                           Text="{Binding ModCount, Converter={x:Static conv:ModCountConverter.Instance}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Classes="ghost small" HorizontalAlignment="Stretch"
                                                    Content="{DynamicResource Game_SetupBuild}"
                                                    Command="{Binding SelectSectionCommand}"
                                                    CommandParameter="Builds"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="ghost"
                                    Command="{Binding PlayOnServerCommand}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconServer}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Game_PlayOnServer}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ServerJoinHint}" Classes="faint"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The last run crashed: say so where the player is looking, with the log
                         one click away. -->
                    <Border Classes="panel" Padding="16" IsVisible="{Binding HasGameCrashed}" MaxWidth="560"
                            HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource DangerBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding GameCrashNotice}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="ghost small"
                                    Content="{DynamicResource Game_OpenLog}"
                                    Command="{Binding OpenLastGameLogCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Launch progress. -->
                    <Border Classes="panel" Padding="16" IsVisible="{Binding ShowLaunchProgress}" MaxWidth="560"
                            HorizontalAlignment="Left">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======== Side ======== -->
                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">

                    <!-- The player. The face opens the model. -->
                    <Border Classes="card" Padding="16" Background="#CC141014">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <Button Classes="avatar" Width="52" Height="52" ToolTip.Tip="{DynamicResource Game_ViewSkin}">
                                    <controls:SkinFace Skin="{Binding PlayerSkin}" Width="52" Height="52" CornerRadius="12"/>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Spacing="10" Width="240">
                                                <controls:SkinViewer Skin="{Binding PlayerSkin}" Height="280"/>
                                                <TextBlock Text="{DynamicResource Game_ViewerHint}" Classes="faint" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SkinSourceLabel}" Classes="faint" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <!-- A face is not obviously a button; the smallest possible nudge. -->
                                <TextBlock Text="{DynamicResource Game_SkinTap}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                                        IsVisible="{Binding !IsEditingNickname}">
                                <TextBlock Text="{Binding Username}" Classes="h3" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Game_OfflineMode}" Classes="faint"/>
                            </StackPanel>

                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalAlignment="Center"
                                  IsVisible="{Binding IsEditingNickname}">
                                <TextBox Text="{Binding Username}" Watermark="{DynamicResource Game_NicknameOwn}"
                                         MinHeight="34"/>
                                <Button Grid.Column="1" Classes="plain small"
                                        Command="{Binding RerollNicknameCommand}"
                                        ToolTip.Tip="{DynamicResource Game_NicknameReroll}">
                                    <PathIcon Data="{StaticResource IconDice}" Classes="small"/>
                                </Button>
                            </Grid>

                            <Button Grid.Column="2" Classes="plain small" VerticalAlignment="Center"
                                    IsVisible="{Binding !IsEditingNickname}"
                                    Command="{Binding EditNicknameCommand}"
                                    ToolTip.Tip="{DynamicResource Game_EditNickname}">
                                <PathIcon Data="{StaticResource IconEdit}" Classes="small"/>
                            </Button>
                            <Button Grid.Column="2" Classes="primary small" VerticalAlignment="Center"
                                    IsVisible="{Binding IsEditingNickname}"
                                    Command="{Binding FinishEditingNicknameCommand}"
                                    ToolTip.Tip="{DynamicResource Game_NicknameDone}">
                                <PathIcon Data="{StaticResource IconCheck}" Classes="small"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Saved names, shown only while editing. -->
                    <Border Classes="card" Padding="16" Background="#CC141014" IsVisible="{Binding IsEditingNickname}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{DynamicResource Game_Nicknames}" Classes="label"/>
                            <ItemsControl ItemsSource="{Binding Nicknames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Button Classes="ghost small" Margin="0,0,6,6" Content="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyNicknameCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Button Classes="ghost small" HorizontalAlignment="Stretch"
                                        Content="{DynamicResource Game_SaveNickname}"
                                        Command="{Binding SaveNicknameCommand}"/>
                                <Button Grid.Column="1" Classes="plain small"
                                        Content="{DynamicResource Game_RemoveNickname}"
                                        Command="{Binding RemoveNicknameCommand}"
                                        CommandParameter="{Binding Username}"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Game_NicknameRule}" Classes="faint" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Where the build stands. -->
                    <Border Classes="card" Padding="16" Background="#CC141014">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{DynamicResource Game_State}" Classes="label"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource SuccessBrush}" IsVisible="{Binding !IsBuildSyncBusy}"/>
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource GoldBrush}" IsVisible="{Binding IsBuildSyncBusy}"/>
                                <TextBlock Text="{Binding BuildStateLabel}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LastPlayedLabel}" Classes="muted" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- What this version changed, once after an update. -->
                    <Border Classes="card" Padding="16" Background="#CC141014" IsVisible="{Binding ShowWhatsNew}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <PathIcon Data="{StaticResource IconStar}" Classes="gold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding WhatsNewTitle}" Classes="h3" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="plain small" Command="{Binding DismissWhatsNewCommand}"
                                        ToolTip.Tip="{DynamicResource WhatsNew_Close}">
                                    <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                </Button>
                            </Grid>
                            <ScrollViewer MaxHeight="260">
                                <ItemsControl ItemsSource="{Binding WhatsNewLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WhatsNewLine">
                                            <Panel>
                                                <TextBlock Text="{Binding Text}" Classes="label" Margin="0,8,0,4"
                                                           IsVisible="{Binding IsHeading}"/>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,6"
                                                      IsVisible="{Binding !IsHeading}">
                                                    <Border Width="5" Height="5" CornerRadius="3" Margin="2,7,0,0"
                                                            Background="{DynamicResource AccentHoverBrush}" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                               FontSize="12" LineHeight="17"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Classes="ghost small" HorizontalAlignment="Left"
                                    Content="{DynamicResource WhatsNew_Ok}" Command="{Binding DismissWhatsNewCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Builds found in other launchers: offered once, right where the
                         player looks first. -->
                    <Border Classes="card" Padding="16" Background="#CC1F1218" IsVisible="{Binding HasImportSuggestion}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <PathIcon Data="{StaticResource IconBuilds}" Classes="gold" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding ImportSuggestionText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Import_SuggestHint}" Classes="faint" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="plain small" VerticalAlignment="Top"
                                        Command="{Binding DismissImportSuggestionCommand}"
                                        ToolTip.Tip="{DynamicResource Import_SuggestDismiss}">
                                    <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                </Button>
                            </Grid>
                            <Button Classes="primary small" HorizontalAlignment="Left"
                                    Content="{DynamicResource Import_SuggestAccept}"
                                    Command="{Binding AcceptImportSuggestionCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- A pulse from the server, not a billboard for it. -->
                    <Button Classes="link-tile" Command="{Binding SelectSectionCommand}" CommandParameter="Server">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ElevatedBrush}">
                                <PathIcon Data="{StaticResource IconUsers}" Classes="gold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OnlineNowLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ServerPeak}" Classes="faint"/>
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Classes="small muted"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Classes="plain small" HorizontalAlignment="Left"
                            IsVisible="{Binding ShowDeveloperConsole}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Console">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconConsole}" Classes="small"/>
                            <TextBlock Text="{DynamicResource Game_OpenConsole}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Panel>
</UserControl>
