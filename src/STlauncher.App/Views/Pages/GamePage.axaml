<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:sys="using:System"
             xmlns:conv="using:STlauncher.App.Converters"
             x:Class="STlauncher.App.Views.Pages.GamePage"
             x:DataType="vm:MainWindowViewModel">

    <!-- The main screen is a stage, not a form: one big button, the name of what it
         starts, and the player in the corner. Everything adjustable lives elsewhere. -->
    <Panel>

        <!-- A soft warm glow behind the play area, so the screen has a centre. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="45%,35%" GradientOrigin="45%,35%" RadiusX="55%" RadiusY="55%">
                    <GradientStop Offset="0" Color="#2E1A22"/>
                    <GradientStop Offset="1" Color="#000C0A0D"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer>
            <Grid Margin="32" ColumnDefinitions="*,280" ColumnSpacing="24"
                  MaxWidth="1000" VerticalAlignment="Center">

                <!-- ======== Stage ======== -->
                <StackPanel Grid.Column="0" Spacing="28" VerticalAlignment="Center">

                    <!-- What will start -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Game_Instance}" Classes="label"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MaxWidth="520" HorizontalAlignment="Left">
                            <ComboBox ItemsSource="{Binding Instances}"
                                      SelectedItem="{Binding SelectedInstance}"
                                      HorizontalAlignment="Stretch" MinHeight="42" FontSize="15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="inst:Instance">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="faint" Text="{Binding VersionId, TargetNullValue=—}"/>
                                                <TextBlock Classes="faint" Text="·"/>
                                                <TextBlock Classes="faint" Text="{Binding Loader}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="1" Classes="ghost" MinHeight="42"
                                    ToolTip.Tip="{DynamicResource Game_SetupBuild}"
                                    Command="{Binding SelectSectionCommand}"
                                    CommandParameter="Builds">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconSettings}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Game_SetupBuild}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SelectedInstance.VersionId, TargetNullValue=—}" Classes="muted"/>
                            <TextBlock Text="·" Classes="muted"/>
                            <TextBlock Text="{Binding SelectedInstance.Loader}" Classes="muted"/>
                            <TextBlock Text="·" Classes="muted"/>
                            <TextBlock Classes="muted"
                                       Text="{Binding BuildModCount, Converter={x:Static conv:ModCountConverter.Instance}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Launch. One primary action; joining the server is an extra, not the
                         headline - the launcher is not a billboard for one server. -->
                    <StackPanel Spacing="14">
                        <Button Classes="primary hero" HorizontalAlignment="Left"
                                Command="{Binding PlayCommand}" IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconPlay}" Classes="large"/>
                                <TextBlock Text="{DynamicResource Game_Play}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="ghost"
                                    Command="{Binding PlayOnServerCommand}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconServer}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Game_PlayOnServer}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ServerJoinHint}" Classes="faint"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBuildSyncBusy}">
                            <PathIcon Data="{StaticResource IconDownload}" Classes="small gold"/>
                            <TextBlock Classes="gold" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{DynamicResource Builds_SyncBusy}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The last run crashed: say so where the player is looking, with the log
                         one click away. -->
                    <Border Classes="panel" Padding="16" IsVisible="{Binding HasGameCrashed}" MaxWidth="560"
                            HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource DangerBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding GameCrashNotice}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Classes="ghost small"
                                    Content="{DynamicResource Game_OpenLog}"
                                    Command="{Binding OpenLastGameLogCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Launch progress. -->
                    <Border Classes="panel" Padding="16" IsVisible="{Binding ShowLaunchProgress}" MaxWidth="560"
                            HorizontalAlignment="Left">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"/>
                        </StackPanel>
                    </Border>

                    <Button Classes="plain small" HorizontalAlignment="Left"
                            IsVisible="{Binding ShowDeveloperConsole}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Console">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconConsole}" Classes="small"/>
                            <TextBlock Text="{DynamicResource Game_OpenConsole}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ======== Player ======== -->
                <Border Grid.Column="1" Classes="card" VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource ElevatedBrush}"
                                    ClipToBounds="True">
                                <Image Source="{Binding Avatar}" Stretch="Uniform" Width="56" Height="56"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding Username}" Classes="h3"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                <TextBlock Text="{DynamicResource Game_OfflineMode}" Classes="faint"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Shown as text; a field only on request. -->
                        <StackPanel Spacing="8" IsVisible="{Binding !IsEditingNickname}">
                            <Button Classes="ghost small" HorizontalAlignment="Stretch"
                                    Command="{Binding EditNicknameCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconEdit}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Game_EditNickname}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsEditingNickname}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding Username}"
                                         Watermark="{DynamicResource Game_NicknameOwn}"/>
                                <Button Grid.Column="1" Classes="plain small"
                                        Command="{Binding RerollNicknameCommand}"
                                        ToolTip.Tip="{DynamicResource Game_NicknameReroll}">
                                    <PathIcon Data="{StaticResource IconDice}" Classes="small"/>
                                </Button>
                                <Button Grid.Column="2" Classes="primary small"
                                        Command="{Binding FinishEditingNicknameCommand}"
                                        ToolTip.Tip="{DynamicResource Game_NicknameDone}">
                                    <PathIcon Data="{StaticResource IconCheck}" Classes="small"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{DynamicResource Game_NicknameRule}" Classes="faint" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Saved names, out of the way until asked for. -->
                        <Button Classes="plain small" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconAccount}" Classes="small"/>
                                <TextBlock Text="{DynamicResource Game_Nicknames}"/>
                                <PathIcon Data="{StaticResource IconChevronDown}" Classes="small"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="10" Width="260">
                                        <ItemsControl ItemsSource="{Binding Nicknames}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Button Classes="ghost small" Margin="0,0,6,6" Content="{Binding}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyNicknameCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBox Text="{Binding NewNickname}"
                                                     Watermark="{DynamicResource Game_NicknameHint}"/>
                                            <Button Grid.Column="1" Classes="ghost small"
                                                    Content="{DynamicResource Game_SaveNickname}"
                                                    Command="{Binding SaveNicknameCommand}"/>
                                        </Grid>

                                        <Button Classes="plain small" HorizontalAlignment="Left"
                                                Content="{DynamicResource Game_RemoveCurrentNickname}"
                                                Command="{Binding RemoveNicknameCommand}"
                                                CommandParameter="{Binding Username}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Panel>
</UserControl>
