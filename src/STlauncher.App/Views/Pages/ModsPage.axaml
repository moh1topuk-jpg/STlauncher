<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:mods="using:STlauncher.Core.Mods"
             x:Class="STlauncher.App.Views.Pages.ModsPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="22" RowDefinitions="Auto,*" RowSpacing="14">

        <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource Nav_Mods}" Classes="label"/>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ModSearchQuery}" Watermark="{DynamicResource Mods_SearchHint}"/>
                <Button Grid.Column="1" Classes="primary" Content="{DynamicResource Mods_Search}"
                        Command="{Binding SearchModsCommand}" IsEnabled="{Binding !IsModsBusy}"/>
                <Button Grid.Column="2" Classes="ghost" Content="{DynamicResource Mods_Refresh}"
                        Command="{Binding RefreshModsCommand}"/>
                <Button Grid.Column="3" Classes="ghost" Content="{DynamicResource Mods_Import}"
                        Click="OnImportModpackClick" IsEnabled="{Binding !IsModsBusy}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <TextBlock Text="{DynamicResource Mods_Modrinth}" Classes="label"/>
                    <TextBlock Grid.Row="1" Text="{Binding ModSearchQuery}" Classes="faint"
                               IsVisible="False"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding ModSearchResults}"
                             SelectedItem="{Binding SelectedMod}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="mods:ModSearchResult">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" Classes="faint" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Mods_Installed}" Classes="label"/>
                        <Button Grid.Column="1" Classes="primary small"
                                Content="{DynamicResource Mods_InstallSelected}"
                                Command="{Binding InstallSelectedModCommand}"
                                IsEnabled="{Binding !IsModsBusy}"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding InstalledMods}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="mods:InstalledMod">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" Classes="faint"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost small"
                                            Content="{DynamicResource Mods_Toggle}"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleModCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Classes="danger small"
                                            Content="{DynamicResource Mods_Delete}"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UninstallModCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
