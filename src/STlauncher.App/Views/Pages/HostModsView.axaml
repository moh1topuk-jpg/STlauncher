<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:conv="using:STlauncher.App.Converters"
             xmlns:controls="using:STlauncher.App.Controls"
             x:Class="STlauncher.App.Views.Pages.HostModsView"
             x:DataType="vm:MainWindowViewModel"
             x:Name="ModsRoot">

    <!-- The server's mods: what is on it in the left panel, Modrinth in the right one, and
         the settings files of a mod in an editor that takes the tab's place while it is open.
         Self-contained: the page only places it, the view model's HostMods partial does
         the rest. Commands inside menus are reached through #ModsRoot: a popup is not a
         descendant of the view. -->

    <UserControl.Styles>
        <!-- A value the file would not take: the field says so before Save does. -->
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- "?" beside a heading: the longer explanation, on request. -->
        <Style Selector="Border.help">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.help > TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The first row of a list has no line above it; in an ItemsControl the row is
             not the panel's own child, so the shared rule cannot see that it is first. -->
        <Style Selector="ItemsControl.rows ContentPresenter:nth-child(1) > Border.row">
            <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
        </Style>

        <!-- Something the player has to know or answer before going on: gold, always in sight. -->
        <Style Selector="Border.caution">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource TileGoldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GoldMutedBrush}"/>
        </Style>

        <!-- One setting of a file: the key, what the file says about it, the value; a hairline below. -->
        <Style Selector="Border.config-field">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One line of an install's list: a file to fetch, a mod already there, a reason it cannot go ahead. -->
        <DataTemplate DataType="vm:HostModPlanLine">
            <Grid ColumnDefinitions="16,*" ColumnSpacing="10" Margin="0,0,0,9">
                <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                    <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12"
                              Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsDownload}"/>
                    <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11"
                              Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsPresent}"/>
                    <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12"
                              Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsProblem}"/>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" Classes="strong" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Classes="sub" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Panel>
        <!-- ================= The tab: the server's mods and Modrinth ================= -->
        <StackPanel Spacing="14" IsVisible="{Binding !IsHostConfigOpen}">

            <!-- What the last action did, or why it could not. -->
            <Border Classes="panel" Padding="14,8,6,8" IsVisible="{Binding HasHostModsNotice}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding HostModsNotice}" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top"
                            ToolTip.Tip="{DynamicResource HostMods_NoticeClose}"
                            Command="{Binding DismissHostModsNoticeCommand}">
                        <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- A vanilla server loads no mods: said, not offered. -->
            <Border Classes="panel" MinHeight="230" IsVisible="{Binding HostModsUnsupported}">
                <StackPanel Classes="empty">
                    <Border Classes="empty-icon">
                        <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                    <TextBlock Classes="strong" Text="{DynamicResource HostMods_UnsupportedTitle}"/>
                    <TextBlock Classes="sub" Text="{DynamicResource HostMods_UnsupportedText}"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16" IsVisible="{Binding HostModsSupported}">

                <!-- ============ On the server ============ -->
                <Border Classes="panel flush" VerticalAlignment="Top">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="12,10,12,2">
                        <TextBlock Text="{Binding HostModsHeader}" Classes="strong" FontSize="15" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="help" ToolTip.Tip="{DynamicResource HostMods_ConfigureHint}">
                            <TextBlock Text="?"/>
                        </Border>
                        <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="50" Height="3"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     IsVisible="{Binding IsHostModsLoading}"/>
                    </Grid>
                    <!-- Nothing restarts by itself: the player is told when changes take hold. -->
                    <TextBlock Text="{Binding HostModsRestartNote}" Classes="sub" TextWrapping="Wrap" Margin="12,0,12,8"/>

                    <Panel MinHeight="220" IsVisible="{Binding ShowHostModsEmpty}">
                        <StackPanel Classes="empty">
                            <Border Classes="empty-icon">
                                <PathIcon Data="{StaticResource IconBuilds}"/>
                            </Border>
                            <TextBlock Classes="sub" Text="{DynamicResource HostMods_Empty}"/>
                        </StackPanel>
                    </Panel>

                    <ScrollViewer MaxHeight="640" IsVisible="{Binding HasHostMods}">
                        <ItemsControl Classes="rows" ItemsSource="{Binding HostMods}" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HostModItem">
                                    <Border Classes="row" Classes.off="{Binding !Enabled}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource HostMods_Configure}" IsVisible="{Binding HasSettings}"
                                                          Command="{Binding #ModsRoot.((vm:MainWindowViewModel)DataContext).OpenHostModSettingsCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <!-- Still two steps: the item opens the question, the answer removes. -->
                                                <MenuItem Header="{DynamicResource HostMods_Remove}">
                                                    <MenuItem Classes="danger" Header="{DynamicResource HostMods_RemoveConfirm}"
                                                              ToolTip.Tip="{Binding RemoveQuestion}"
                                                              Command="{Binding RemoveCommand}" CommandParameter="{Binding}"/>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                            <!-- The mod's own icon; a letter on its colour when the jar has none. -->
                                            <Border Classes="icon-tile"
                                                    Background="{Binding TintKey, Converter={x:Static conv:TintBrushConverter.Instance}}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Initial}" Classes="tile-letter" FontSize="13" IsVisible="{Binding !HasIcon}"/>
                                                    <Border Background="{DynamicResource ElevatedBrush}" IsVisible="{Binding HasIcon}">
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <!-- A grid, not a stack: a stack never limits a long title, which then runs under the buttons.
                                                 Where it came from, its version and its file are a tooltip away. -->
                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center" Background="Transparent">
                                                <ToolTip.Tip>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Entry.FileName}" Classes="mono"/>
                                                        <TextBlock Text="{Binding Detail}"/>
                                                        <TextBlock Text="{Binding Description}" Classes="sub" IsVisible="{Binding HasDescription}"/>
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                                <TextBlock Text="{Binding Title}" Classes="strong" TextTrimming="CharacterEllipsis"/>
                                                <Panel Grid.Row="1">
                                                    <TextBlock Text="{Binding Description}" Classes="sub" TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding HasDescription}"/>
                                                    <TextBlock Text="{Binding Detail}" Classes="sub" TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding !HasDescription}"/>
                                                </Panel>
                                            </Grid>
                                            <StackPanel Grid.Column="2" Classes="reveal" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="icon" ToolTip.Tip="{DynamicResource HostMods_Configure}"
                                                        IsVisible="{Binding HasSettings}"
                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenHostModSettingsCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconSettings}"/>
                                                </Button>
                                                <!-- Removing asks first; the answer is in the flyout. -->
                                                <Button Classes="icon icon-danger" ToolTip.Tip="{DynamicResource HostMods_Remove}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11"/>
                                                    <Button.Flyout>
                                                        <controls:RevealFlyout Placement="BottomEdgeAlignedRight">
                                                            <StackPanel Spacing="10" Width="290">
                                                                <TextBlock Text="{Binding RemoveQuestion}" Classes="muted" TextWrapping="Wrap" LineHeight="18"/>
                                                                <Button Classes="danger small" HorizontalAlignment="Left"
                                                                        Content="{DynamicResource HostMods_RemoveConfirm}"
                                                                        Command="{Binding RemoveCommand}" CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </controls:RevealFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <!-- The switch shows the state and changes it. -->
                                            <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                                                          ToolTip.Tip="{DynamicResource HostMods_ToggleTip}"
                                                          Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleHostModCommand}"
                                                          CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Settings files no mod could be named for. -->
                    <Border Classes="row" IsVisible="{Binding HasHostOtherConfigs}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Classes="icon-tile" Background="{DynamicResource FieldBrush}">
                                <PathIcon Data="{StaticResource IconFolder}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding HostOtherConfigsLabel}" Classes="strong" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Classes="small" Content="{DynamicResource HostMods_OtherOpen}"
                                    VerticalAlignment="Center" Command="{Binding OpenHostOtherSettingsCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                </Border>

                <!-- ============ From Modrinth ============ -->
                <Border Grid.Column="1" Classes="panel flush" VerticalAlignment="Top">
                <StackPanel>
                    <Border Classes="field" Height="40" Margin="8,8,8,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <PathIcon Data="{StaticResource IconSearch}" Classes="small muted" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Classes="bare" Text="{Binding HostModQueryText}"
                                     Watermark="{DynamicResource HostMods_SearchHint}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchHostModsCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="40" Height="3" VerticalAlignment="Center"
                                         IsVisible="{Binding IsHostModSearching}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding HostModsSearchNote}" Classes="sub" TextWrapping="Wrap" Margin="12,8,12,8"/>

                    <!-- What an install would fetch, before anything is fetched. -->
                    <Border Classes="panel inset" Padding="18,16,18,14" Margin="8,2,8,10" IsVisible="{Binding IsHostModPlanOpen}"
                            BorderBrush="{DynamicResource AccentEdgeBrush}" controls:Reveal.OnVisible="True">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding HostModPlanTitle}" Classes="h3" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding HostModPlanLines}"/>
                            <TextBlock Text="{Binding HostModPlanTotal}" Classes="muted" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HostModsRestartNote}" Classes="sub" TextWrapping="Wrap"
                                       IsVisible="{Binding HostModPlanCanInstall}"/>
                            <StackPanel Spacing="6" IsVisible="{Binding IsHostModInstalling}">
                                <TextBlock Text="{Binding HostModInstallText}" Classes="muted"/>
                                <ProgressBar IsIndeterminate="True" Height="4"/>
                            </StackPanel>
                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                                <!-- The tab's accent while the list is open: the yes it asks for. -->
                                <Button Classes="primary" IsVisible="{Binding HostModPlanCanInstall}"
                                        IsEnabled="{Binding CanConfirmHostModPlan}"
                                        Command="{Binding ConfirmHostModPlanCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource HostMods_PlanConfirm}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="{DynamicResource Common_Cancel}"
                                        IsEnabled="{Binding CanCancelHostModPlan}"
                                        Command="{Binding CancelHostModPlanCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding HostModSearchMessage}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding HasHostModSearchMessage}" Margin="12,4"/>

                    <ScrollViewer MaxHeight="640">
                        <StackPanel Margin="0,0,4,0">
                            <ItemsControl Classes="rows" ItemsSource="{Binding HostModResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HostModResultItem">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Classes="icon-tile"
                                                        Background="{Binding Result.Slug, Converter={x:Static conv:TintBrushConverter.Instance}}">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Initial}" Classes="tile-letter" FontSize="13" IsVisible="{Binding !HasIcon}"/>
                                                        <Border Background="{DynamicResource ElevatedBrush}" IsVisible="{Binding HasIcon}">
                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Panel>
                                                </Border>
                                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center" Background="Transparent"
                                                      ToolTip.Tip="{Binding Description}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Title}" Classes="strong" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Byline}" Classes="sub" FontSize="11.5"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <!-- One state at a time: offer it, work out what it brings, already there. -->
                                                <Panel Grid.Column="2" VerticalAlignment="Center">
                                                    <Button Classes="small" IsVisible="{Binding NotInstalled}"
                                                            IsEnabled="{Binding !IsPlanning}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).PlanHostModCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{DynamicResource HostMods_Add}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,4,0" IsVisible="{Binding Installed}">
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource SuccessBrush}"/>
                                                        <TextBlock Text="{DynamicResource HostMods_AlreadyThere}" Classes="sub" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                                                 IsVisible="{Binding IsPlanning}"/>
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="small" HorizontalAlignment="Center" Margin="0,8,0,6"
                                    Content="{DynamicResource HostMods_More}"
                                    IsVisible="{Binding HostModsHasMore}" Command="{Binding MoreHostModsCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ================= Settings of a mod: its files, one open at a time ================= -->
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" IsVisible="{Binding IsHostConfigOpen}" controls:Reveal.OnVisible="True">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Classes="small" Command="{Binding CloseHostConfigCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconChevronLeft}" Width="10" Height="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource HostMods_Back}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostConfigTitle}" Classes="group" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HostModsRestartNote}" Classes="sub" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Unsaved changes and a way out was taken: the player decides. -->
            <Border Grid.Row="1" Classes="caution" IsVisible="{Binding IsHostConfigAsking}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource HostMods_UnsavedQuestion}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary small" Content="{DynamicResource HostMods_UnsavedSave}"
                                Command="{Binding HostConfigAnswerSaveCommand}"/>
                        <Button Classes="small" Content="{DynamicResource HostMods_UnsavedDiscard}"
                                Command="{Binding HostConfigAnswerDiscardCommand}"/>
                        <Button Classes="small" Content="{DynamicResource HostMods_UnsavedStay}"
                                Command="{Binding HostConfigAnswerStayCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="250,*" ColumnSpacing="16">
                <!-- The mod's files. -->
                <Border Classes="panel flush" VerticalAlignment="Top">
                <ScrollViewer MaxHeight="660" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding HostConfigFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HostConfigFileItem">
                                <Button Classes="plain" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenHostConfigFileCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="row flat" Classes.selected="{Binding IsSelected}">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Label}" Classes="strong" TextWrapping="Wrap"
                                                       ToolTip.Tip="{Binding File.RelativePath}"/>
                                            <TextBlock Text="{Binding Detail}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Border>

                <!-- The open file: fields where the file can be read as fields, its text otherwise. -->
                <Border Grid.Column="1" Classes="panel" Padding="20,16,20,16" VerticalAlignment="Top"
                        IsVisible="{Binding HasHostConfigFile}">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding HostConfigFile.File.RelativePath, FallbackValue=''}" Classes="mono"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Classes="link" Content="{DynamicResource HostMods_AsText}" VerticalAlignment="Center"
                                IsVisible="{Binding HostConfigCanShowText}" Command="{Binding ShowHostConfigAsTextCommand}"/>
                        <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{DynamicResource HostMods_Reveal}"
                                Command="{Binding RevealHostConfigFileCommand}">
                            <PathIcon Data="{StaticResource IconFolder}"/>
                        </Button>
                    </Grid>

                    <!-- Save sits above the fields, not under them: a long file must not push it off the screen. -->
                    <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="6"
                               IsVisible="{Binding !HasHostConfigMessage}">
                        <!-- The editor's accent; it steps aside while the question above is asked. -->
                        <Button Classes.primary="{Binding !IsHostConfigAsking}" Content="{DynamicResource HostMods_Save}"
                                IsEnabled="{Binding CanSaveHostConfig}" Command="{Binding SaveHostConfigCommand}"/>
                        <Button Content="{DynamicResource HostMods_Discard}"
                                IsEnabled="{Binding HostConfigDirty}" Command="{Binding RevertHostConfigCommand}"/>
                        <TextBlock Text="{DynamicResource HostMods_SaveHint}" Classes="sub" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="{Binding HostConfigMessage}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding HasHostConfigMessage}"/>
                        <TextBlock Text="{Binding HostConfigNotice}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding HasHostConfigNotice}"/>
                    </StackPanel>

                    <Panel Grid.Row="3">
                        <!-- Fields: the key, what the file says about it, the value. -->
                        <ScrollViewer MaxHeight="560" VerticalAlignment="Top" IsVisible="{Binding IsHostConfigFields}">
                            <ItemsControl ItemsSource="{Binding HostConfigFields}" Margin="0,0,12,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HostConfigFieldItem">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SectionHeader}" Classes="label" Margin="0,18,0,2"
                                                       IsVisible="{Binding HasSectionHeader}"/>
                                            <Border Classes="config-field">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Key}" Classes="strong" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}"
                                                                      VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Comment}" Classes="sub" TextWrapping="Wrap" LineHeight="17"
                                                               IsVisible="{Binding HasComment}"/>
                                                    <TextBox Text="{Binding Value}" IsVisible="{Binding IsTextual}"
                                                             Classes.mono="{Binding IsRaw}" Classes.invalid="{Binding IsInvalid}"/>
                                                    <TextBlock Text="{DynamicResource HostMods_FieldBad}" FontSize="11.5"
                                                               Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsInvalid}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Text: the file as it is, in a fixed-width font. -->
                        <TextBox Classes="mono" Text="{Binding HostConfigText}" IsVisible="{Binding IsHostConfigText}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 MinHeight="320" MaxHeight="560" VerticalAlignment="Top" VerticalContentAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Panel>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </Panel>
</UserControl>
