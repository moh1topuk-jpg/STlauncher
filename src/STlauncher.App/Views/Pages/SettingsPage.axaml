<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:controls="using:STlauncher.App.Controls"
             x:Class="STlauncher.App.Views.Pages.SettingsPage"
             x:DataType="vm:MainWindowViewModel">

    <!-- Five sections, in the order they are needed: what changes a game session comes
         first, what changes once a year is folded away at the bottom. -->
    <Grid ColumnDefinitions="220,*">

        <!-- ======== Index ======== -->
        <Border Grid.Column="0" Padding="16,28" BorderBrush="{DynamicResource IndexBorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Text="{DynamicResource Nav_Settings}" Classes="h2" FontSize="22" Margin="10,0,0,14"/>

                <StackPanel Grid.Row="1" Spacing="2">
                    <Button Classes="index" Content="{DynamicResource Settings_TabGame}" Click="OnIndexClick" Tag="GameSection"/>
                    <Button Classes="index" Content="{DynamicResource Settings_SectionLook}" Click="OnIndexClick" Tag="LookSection"/>
                    <Button Classes="index" Content="{DynamicResource Settings_SectionLauncher}" Click="OnIndexClick" Tag="LauncherSection"/>
                    <Button Classes="index" Content="{DynamicResource Settings_Backups}" Click="OnIndexClick" Tag="BackupsSection"/>
                    <Button Classes="index" Content="{DynamicResource Settings_SectionMore}" Click="OnIndexClick" Tag="MoreSection"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="6">
                    <Button Classes="index" Content="{DynamicResource WhatsNew_Open}"
                            Command="{Binding OpenWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}"/>
                    <TextBlock Text="{Binding UpdateStateLabel}" Classes="faint" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Name="SettingsScroll">
            <StackPanel Margin="40,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

                <!-- ======== Game: the one button, then memory and the window ======== -->
                <Border Name="GameSection" Classes="card" Padding="24,22">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource Settings_TabGame}" Classes="h3" FontSize="17"/>
                            <TextBlock Grid.Column="1" Text="{Binding GameSettingsScopeLabel}" Classes="faint" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- One button instead of twelve settings. Writes options.txt and the memory;
                             for an own Fabric build also adds the optimisation mods. -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Perf_Title}" FontWeight="SemiBold"/>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Classes="ghost" Command="{Binding ApplyPerformancePresetCommand}" CommandParameter="Low"
                                        IsEnabled="{Binding !IsApplyingPreset}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{DynamicResource Perf_Low}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Perf_LowHint}" Classes="faint" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Command="{Binding ApplyPerformancePresetCommand}" CommandParameter="Balanced"
                                        IsEnabled="{Binding !IsApplyingPreset}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{DynamicResource Perf_Balanced}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Perf_BalancedHint}" Classes="faint" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Command="{Binding ApplyPerformancePresetCommand}" CommandParameter="High"
                                        IsEnabled="{Binding !IsApplyingPreset}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{DynamicResource Perf_High}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Perf_HighHint}" Classes="faint" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Perf_Hint}" Classes="faint" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Perf_ModsHint}" Classes="faint" TextWrapping="Wrap"
                                       IsVisible="{Binding CanInstallOptimizationMods}"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                  IsVisible="{Binding PresetStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" IsVisible="{Binding IsApplyingPreset}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PresetStatus}" Classes="gold" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                            <!-- Memory: a slider with the recommendation marked, instead of two
                                 number boxes with no hint of what is sensible. -->
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource Settings_MemoryTitle}" FontWeight="SemiBold"/>
                                    <Button Grid.Column="1" Classes="plain small" Foreground="{DynamicResource GoldBrush}"
                                            Content="{Binding RecommendedMemoryLabel}"
                                            Command="{Binding UseRecommendedMemoryCommand}"/>
                                </Grid>
                                <Slider Minimum="1024" Maximum="{Binding MemorySliderMax}" TickFrequency="512" IsSnapToTickEnabled="True"
                                        Value="{Binding MaxMemoryMb}"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding MemoryHint}" Classes="faint" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Settings_MemoryCeiling}" Classes="faint"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="{DynamicResource Settings_ResolutionTitle}" FontWeight="SemiBold"/>
                                <CheckBox Content="{DynamicResource Settings_ResolutionDefault}"
                                          IsChecked="{Binding UseDefaultResolution}"/>
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" MaxWidth="240" HorizontalAlignment="Left"
                                      IsEnabled="{Binding !UseDefaultResolution}">
                                    <NumericUpDown Value="{Binding Width}" Minimum="0" Maximum="7680"
                                                   Increment="10" FormatString="0" ShowButtonSpinner="False"/>
                                    <TextBlock Grid.Column="1" Text="&#x00D7;" VerticalAlignment="Center" Classes="faint"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding Height}" Minimum="0"
                                                   Maximum="4320" Increment="10" FormatString="0"
                                                   ShowButtonSpinner="False"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======== Look: theme, accent, language, the live background ======== -->
                <Border Name="LookSection" Classes="card" Padding="24,22">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Settings_SectionLook}" Classes="h3" FontSize="17"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Settings_Theme}" FontWeight="SemiBold"/>
                                <Border Classes="panel" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="segment" Classes.active="{Binding IsThemeDark}"
                                                Content="{DynamicResource Settings_ThemeDark}"
                                                Command="{Binding SelectThemeCommand}" CommandParameter="dark"/>
                                        <Button Classes="segment" Classes.active="{Binding IsThemeLight}"
                                                Content="{DynamicResource Settings_ThemeLight}"
                                                Command="{Binding SelectThemeCommand}" CommandParameter="light"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="{DynamicResource Settings_Accent}" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding AccentOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- Wraps: eight swatches do not fit a third of a narrow window. -->
                                            <WrapPanel ItemSpacing="8" LineSpacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccentOption">
                                            <Button Classes="swatch" Classes.selected="{Binding IsSelected}"
                                                    Background="{Binding Brush}" ToolTip.Tip="{Binding Display}"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectAccentCommand}"
                                                    CommandParameter="{Binding Key}">
                                                <PathIcon Data="{StaticResource IconCheck}" Classes="small" Foreground="{DynamicResource TextOnAccentBrush}"
                                                          IsVisible="{Binding IsSelected}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageOption">
                                            <TextBlock Text="{Binding Display}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 100 % is the designed size; the others are for a 4K desk or a small laptop. -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Settings_UiScale}" FontWeight="SemiBold"/>
                            <Border Classes="panel" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="segment" Classes.active="{Binding IsUiScale90}" Content="90 %"
                                            Command="{Binding SelectUiScaleCommand}" CommandParameter="0.9"/>
                                    <Button Classes="segment" Classes.active="{Binding IsUiScale100}" Content="100 %"
                                            Command="{Binding SelectUiScaleCommand}" CommandParameter="1.0"/>
                                    <Button Classes="segment" Classes.active="{Binding IsUiScale110}" Content="110 %"
                                            Command="{Binding SelectUiScaleCommand}" CommandParameter="1.1"/>
                                    <Button Classes="segment" Classes.active="{Binding IsUiScale125}" Content="125 %"
                                            Command="{Binding SelectUiScaleCommand}" CommandParameter="1.25"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource Settings_UiScaleHint}" Classes="faint" TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox Content="{DynamicResource Settings_AnimatedBackground}" IsChecked="{Binding AnimatedBackground}"/>
                    </StackPanel>
                </Border>

                <!-- ======== Launcher: three things, not twelve ======== -->
                <Border Name="LauncherSection" Classes="card" Padding="24,22">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Settings_SectionLauncher}" Classes="h3" FontSize="17"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Settings_AfterLaunch}" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AfterLaunchOptions}"
                                          SelectedItem="{Binding SelectedAfterLaunchOption}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AfterLaunchOption">
                                            <TextBlock Text="{Binding Display}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <StackPanel Spacing="4">
                                    <CheckBox Content="{DynamicResource Settings_DiscordPresence}" IsChecked="{Binding DiscordPresence}"/>
                                    <TextBlock Text="{DynamicResource Settings_DiscordPresenceHint}" Classes="faint"
                                               TextWrapping="Wrap" Margin="28,0,0,0"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <CheckBox Content="{DynamicResource Settings_UsageStats}" IsChecked="{Binding UsageStats}"/>
                                    <TextBlock Text="{DynamicResource Settings_UsageStatsHint}" Classes="faint"
                                               TextWrapping="Wrap" Margin="28,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======== Backups: one line, the rest folded ======== -->
                <Border Name="BackupsSection" Classes="card" Padding="24,22">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <ToggleSwitch IsChecked="{Binding BackupsEnabled}"
                                          OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_BackupsTitle}" Classes="h3" FontSize="17"/>
                                <TextBlock Text="{Binding BackupStatus}" Classes="faint" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="ghost" ToolTip.Tip="{DynamicResource Settings_OpenFolder}"
                                    Command="{Binding OpenBackupsFolderCommand}">
                                <PathIcon Data="{StaticResource IconFolder}"/>
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Content="{DynamicResource Settings_BackupNow}"
                                    Command="{Binding CreateBackupNowCommand}"/>
                        </Grid>

                        <Button Classes="plain small" HorizontalAlignment="Left" Padding="0"
                                Command="{Binding ToggleBackupDetailsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{DynamicResource Settings_BackupsDetails}" Foreground="{DynamicResource GoldBrush}" FontSize="12"/>
                                <PathIcon Data="{StaticResource IconChevronRight}" Width="10" Height="10" Foreground="{DynamicResource GoldBrush}"
                                          IsVisible="{Binding !IsBackupDetailsOpen}"/>
                                <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Foreground="{DynamicResource GoldBrush}"
                                          IsVisible="{Binding IsBackupDetailsOpen}"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Spacing="16" IsVisible="{Binding IsBackupDetailsOpen}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="28" IsEnabled="{Binding BackupsEnabled}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource Settings_BackupsWhen}" FontWeight="SemiBold"/>
                                    <CheckBox Content="{DynamicResource Settings_BackupsDaily}" IsChecked="{Binding BackupsDaily}"/>
                                    <CheckBox Content="{DynamicResource Settings_BackupsBeforeMods}" IsChecked="{Binding BackupsBeforeModChanges}"/>
                                    <CheckBox Content="{DynamicResource Settings_BackupsBeforeLaunch}" IsChecked="{Binding BackupsBeforeLaunch}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Top">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{DynamicResource Settings_BackupsMax}" FontWeight="SemiBold"/>
                                        <NumericUpDown Value="{Binding BackupsMaxCount}" Minimum="1" Maximum="200"
                                                       Increment="1" FormatString="0" ShowButtonSpinner="False"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{DynamicResource Settings_BackupsSize}" FontWeight="SemiBold"/>
                                        <NumericUpDown Value="{Binding BackupsMaxTotalMb}" Minimum="64"
                                                       Maximum="102400" Increment="256" FormatString="0"
                                                       ShowButtonSpinner="False"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings_BackupsWhat}" Classes="faint" TextWrapping="Wrap"/>

                            <!-- What there is to go back to. Each row offers the three ways back. -->
                            <StackPanel Spacing="8" IsVisible="{Binding HasBackups}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource Settings_BackupsList}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" Height="3"
                                                 IsVisible="{Binding IsRestoringBackup}" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Backups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BackupItem">
                                            <Border Classes="panel" Padding="12,10" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding BuildName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <Border Classes="tag" IsVisible="{Binding !BuildExists}" VerticalAlignment="Center">
                                                                <TextBlock Text="{DynamicResource Backup_BuildDeleted}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding DateLabel}" Classes="faint"/>
                                                            <TextBlock Text="·" Classes="faint"/>
                                                            <TextBlock Text="{Binding SizeLabel}" Classes="faint"/>
                                                            <TextBlock Text="·" Classes="faint" IsVisible="{Binding ContentsLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            <TextBlock Text="{Binding ContentsLabel}" Classes="faint"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource IconRestore}" Classes="small"/>
                                                            <TextBlock Text="{DynamicResource Backup_Restore}"/>
                                                            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"/>
                                                        </StackPanel>
                                                        <Button.Flyout>
                                                            <controls:RevealFlyout Placement="BottomEdgeAlignedRight">
                                                                <StackPanel Spacing="4" Width="300">
                                                                    <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Command="{Binding RestoreWorldsCommand}" IsEnabled="{Binding CanRestoreWorlds}">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{DynamicResource Backup_RestoreWorlds}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{DynamicResource Backup_RestoreWorldsHint}" Classes="faint" TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Command="{Binding RestoreEverythingCommand}" IsEnabled="{Binding CanRestoreEverything}">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{DynamicResource Backup_RestoreAll}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{DynamicResource Backup_RestoreAllHint}" Classes="faint" TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Command="{Binding RestoreAsNewBuildCommand}">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{DynamicResource Backup_RestoreNew}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{DynamicResource Backup_RestoreNewHint}" Classes="faint" TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </controls:RevealFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="plain small icon-danger" VerticalAlignment="Center"
                                                            ToolTip.Tip="{DynamicResource Backup_Delete}" Command="{Binding DeleteCommand}">
                                                        <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======== More: the rare settings, one line until opened ======== -->
                <Border Name="MoreSection" Classes="card" Padding="24,18">
                    <StackPanel Spacing="16">
                        <Button Classes="plain" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                                Command="{Binding ToggleMoreSettingsCommand}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource Settings_SectionMore}" Classes="h3" FontSize="17"/>
                                    <TextBlock Text="{DynamicResource Settings_MoreSummary}" Classes="faint" TextWrapping="Wrap"
                                               IsVisible="{Binding !IsMoreSettingsOpen}"/>
                                    <TextBlock Text="{DynamicResource Settings_MoreHint}" Classes="faint" TextWrapping="Wrap"
                                               IsVisible="{Binding IsMoreSettingsOpen}"/>
                                </StackPanel>
                                <PathIcon Grid.Column="1" Data="{StaticResource IconChevronRight}" Classes="small muted" VerticalAlignment="Center"
                                          IsVisible="{Binding !IsMoreSettingsOpen}"/>
                                <PathIcon Grid.Column="1" Data="{StaticResource IconChevronDown}" Classes="small muted" VerticalAlignment="Center"
                                          IsVisible="{Binding IsMoreSettingsOpen}"/>
                            </Grid>
                        </Button>

                        <StackPanel Spacing="18" IsVisible="{Binding IsMoreSettingsOpen}">
                            <!-- Where the gigabytes live. Moving copies everything, then restarts. -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Settings_DataFolder}" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Classes="ghost" ToolTip.Tip="{DynamicResource Settings_OpenFolder}"
                                            Command="{Binding OpenDataDirectoryCommand}">
                                        <PathIcon Data="{StaticResource IconFolder}"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="ghost" Content="{DynamicResource Settings_DataFolderChange}"
                                            Command="{Binding ChangeDataDirectoryCommand}" IsEnabled="{Binding !IsMovingData}"/>
                                    <Button Grid.Column="3" Classes="plain" Content="{DynamicResource Settings_DataFolderReset}"
                                            Command="{Binding ResetDataDirectoryCommand}" IsEnabled="{Binding !IsMovingData}"
                                            IsVisible="{Binding !IsDefaultDataDirectory}"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Settings_DataFolderHint}" Classes="faint" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                      IsVisible="{Binding DataMoveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsMovingData}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DataMoveStatus}" Classes="gold" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Settings_GameDirectory}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding InstanceDirectory, Mode=OneWay}" IsReadOnly="True"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Bottom"
                                        ToolTip.Tip="{DynamicResource Settings_OpenFolder}"
                                        Command="{Binding OpenGameFolderCommand}">
                                    <PathIcon Data="{StaticResource IconFolder}"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Settings_Versions}" FontWeight="SemiBold"/>
                                    <WrapPanel>
                                        <CheckBox Content="{DynamicResource Settings_VersionsSnapshot}"
                                                  IsChecked="{Binding ShowSnapshots}" Margin="0,0,18,0"/>
                                        <CheckBox Content="{DynamicResource Settings_VersionsRelease}"
                                                  IsChecked="{Binding ShowOldReleases}" Margin="0,0,18,0"/>
                                        <CheckBox Content="{DynamicResource Settings_VersionsBeta}"
                                                  IsChecked="{Binding ShowBeta}" Margin="0,0,18,0"/>
                                        <CheckBox Content="{DynamicResource Settings_VersionsAlpha}"
                                                  IsChecked="{Binding ShowAlpha}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{DynamicResource Settings_ExtraArgs}" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding ExtraGameArgs}" Watermark="--fullscreen --width 1920"/>
                                    <TextBlock Text="{DynamicResource Settings_ExtraArgsHint}" Classes="faint" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- "Nothing downloads": probe every host the launcher uses and say which answer.
                                 It also runs by itself when a download fails. -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Settings_NetworkCheck}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_NetworkCheckHint}" Classes="faint" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Settings_NetworkCopy}"
                                            Command="{Binding CopyNetworkReportCommand}" IsVisible="{Binding NetworkChecks.Count}"/>
                                    <Button Grid.Column="2" Classes="ghost" Content="{DynamicResource Settings_NetworkRun}"
                                            Command="{Binding RunNetworkCheckCommand}" IsEnabled="{Binding !IsNetworkCheckRunning}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding NetworkChecks}" IsVisible="{Binding NetworkChecks.Count}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NetworkCheckItem">
                                            <Border Classes="panel" Padding="12,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Panel Width="10" Height="10" VerticalAlignment="Center">
                                                        <Border CornerRadius="5" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsOk}"/>
                                                        <Border CornerRadius="5" Background="{DynamicResource DangerBrush}" IsVisible="{Binding IsFailed}"/>
                                                        <Border CornerRadius="5" Background="{DynamicResource DividerBrush}" IsVisible="{Binding IsPending}"/>
                                                    </Panel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" FontSize="13"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Verdict}" Classes="faint" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding NetworkCheckSummary}" Classes="gold" TextWrapping="Wrap"
                                           IsVisible="{Binding NetworkCheckSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <!-- Everything the admin asks for, in one file. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Report_Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Report_Hint}" Classes="faint" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Report_Collect}"
                                        Command="{Binding CollectSupportReportCommand}"/>
                            </Grid>

                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <CheckBox Content="{DynamicResource Settings_DiscreteGpu}" IsChecked="{Binding PreferDiscreteGpu}"/>
                                    <TextBlock Text="{DynamicResource Settings_DiscreteGpuHint}" Classes="faint"
                                               TextWrapping="Wrap" Margin="28,0,0,0"/>
                                </StackPanel>
                                <CheckBox Content="{DynamicResource Settings_ForceUpdate}" IsChecked="{Binding ForceUpdate}"/>
                                <StackPanel Spacing="4">
                                    <CheckBox Content="{DynamicResource Settings_DevConsole}" IsChecked="{Binding ShowDeveloperConsole}"/>
                                    <TextBlock Text="{DynamicResource Settings_DevConsoleHint}" Classes="faint"
                                               TextWrapping="Wrap" Margin="28,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======== Developers: under "More", only while the console is on ======== -->
                <Border Name="DevSection" Classes="card" Padding="24,22" IsVisible="{Binding ShowDeveloperConsole}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource Settings_Advanced}" Classes="h3" FontSize="17"/>
                            <TextBlock Text="{DynamicResource Settings_AdvancedHint}" Classes="faint" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="8" MaxWidth="400" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Settings_TabJava}" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding JavaChoices}" SelectedItem="{Binding SelectedJavaChoice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:JavaChoice">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- The server owner's field. Players have no use for it and no way to tell
                             what it does; it appears only with OwnerTools in settings.json. The catalog
                             address is deliberately not here at all: the catalog is the server's. -->
                        <StackPanel Spacing="8" IsVisible="{Binding ShowOwnerTools}">
                            <TextBlock Text="{DynamicResource Settings_StatsUrl}" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ServerStatsUrl}" Watermark="https://name.workers.dev/"/>
                            <TextBlock Text="{DynamicResource Settings_StatsUrlHint}" Classes="faint" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LauncherUsageLabel}" Classes="gold" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Settings_Updates}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UpdateStatus}" Classes="faint" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Classes="ghost small" Margin="0,0,8,6" Content="{DynamicResource Settings_CheckUpdates}"
                                        Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsUpdateBusy}"/>
                                <Button Classes="ghost small" Margin="0,0,8,6" Content="{DynamicResource Settings_RestartUpdate}"
                                        Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanRestartToUpdate}"/>
                                <Button Classes="ghost small" Margin="0,0,8,6" Content="{DynamicResource Update_DownloadManually}"
                                        Command="{Binding OpenReleasesPageCommand}"/>
                                <Button Classes="plain small" Margin="0,0,8,6" Content="{DynamicResource Update_OpenGithub}"
                                        Command="{Binding OpenGithubReleasesCommand}"/>
                                <Button Classes="plain small" Margin="0,0,8,6" Content="{DynamicResource Console_OpenLog}"
                                        Command="{Binding OpenLauncherLogCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
