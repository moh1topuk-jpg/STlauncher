<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:hosting="using:STlauncher.Core.Hosting"
             xmlns:sys="using:System"
             xmlns:controls="using:STlauncher.App.Controls"
             xmlns:pages="using:STlauncher.App.Views.Pages"
             x:Class="STlauncher.App.Views.Pages.HostPage"
             x:DataType="vm:MainWindowViewModel">

    <!-- Playing with friends. Two halves behind one switch, because they are two different
         errands: "My server" is a server the player runs for friends, "Join a friend" is
         where a friend's invite goes. The server's half is its card and five tabs under it,
         the first of which walks through inviting a friend step by step. -->

    <UserControl.DataTemplates>
        <!-- One line of "what will happen": the creation card, a consent panel and an
             invite all list their steps with it. A download carries an arrow, the rest a dot. -->
        <DataTemplate DataType="vm:HostPlanLine">
            <Grid ColumnDefinitions="14,*" ColumnSpacing="10" Margin="0,0,0,10">
                <Panel Width="14" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                    <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12"
                              Foreground="{DynamicResource GoldBrush}" IsVisible="{Binding IsDownload}"/>
                    <Border Width="5" Height="5" CornerRadius="3" Background="{DynamicResource TextMutedBrush}"
                            IsVisible="{Binding IsNote}"/>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" LineHeight="17"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- A wide button on the server card: start, stop, join. On glass, like the small
             square buttons of the home screen, so it reads over the card's glow. -->
        <Style Selector="Button.glass-wide">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.glass-wide /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        </Style>
        <Style Selector="Button.glass-wide:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource GlassChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GoldMutedBrush}"/>
        </Style>

        <!-- The switch between the two halves of the page: the same track of segments as
             a build's tabs, larger, and the open half filled with the accent - it decides
             what the whole page shows. -->
        <Style Selector="Border.segments.halves Button.segment">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.segments.halves Button.segment.active">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        </Style>
        <Style Selector="Border.segments.halves Button.segment.active /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.segments.halves Button.segment.active:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- A row inside a glass card: a way of connecting, a player, a friend's server. -->
        <Style Selector="Border.row">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Until this page moves to the shared "row": no hairline over these framed ones. -->
            <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}"/>
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        </Style>

        <!-- The round mark of a step: a number while it is still to do, a tick once done. -->
        <Style Selector="Border.step">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource GlassChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
        </Style>
        <Style Selector="Border.step.done">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style Selector="Border.step > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.step > PathIcon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- The same room light as the home screen; a still fill, nothing animated here. -->
        <Border IsHitTestVisible="False" Background="{DynamicResource HomeGlowBrush}"/>

        <ScrollViewer>
            <StackPanel Margin="40,30,28,26" Spacing="16" MaxWidth="1240">

                <!-- ======== Heading and the switch between the two halves ======== -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Host_Title}" Classes="greeting"/>
                        <TextBlock Text="{DynamicResource Host_Subtitle}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="segments halves" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="segment" Classes.active="{Binding IsFriendsMyServer}"
                                    Content="{DynamicResource Friends_TabMine}"
                                    Command="{Binding SelectFriendsTabCommand}" CommandParameter="MyServer"/>
                            <Button Classes="segment" Classes.active="{Binding IsFriendsJoin}"
                                    Content="{DynamicResource Friends_TabJoin}"
                                    Command="{Binding SelectFriendsTabCommand}" CommandParameter="Join"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================================
                     JOIN A FRIEND
                     ============================================================ -->
                <StackPanel Spacing="16" IsVisible="{Binding IsFriendsJoin}">

                    <!-- ======== The invite goes here: one box, at the top, in plain sight ======== -->
                    <Border Classes="hero-card">
                        <Panel>
                            <Border IsHitTestVisible="False" CornerRadius="25" Background="{DynamicResource HeroGlowBrush}"/>
                            <Border IsHitTestVisible="False" HorizontalAlignment="Right" Width="380" CornerRadius="0,25,25,0"
                                    Background="{DynamicResource HeroGoldGlowBrush}"/>

                            <StackPanel Margin="28,24,28,24" Spacing="6">
                                <TextBlock Text="{DynamicResource Friends_EntryTitle}" Classes="h1" FontSize="24"/>
                                <TextBlock Text="{DynamicResource Friends_EntryText}" Classes="muted" FontSize="13.5" LineHeight="20"
                                           TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,12,0,0">
                                    <TextBox Text="{Binding FriendInviteEntry}" Watermark="ST-XXXXX-XXXXX"
                                             Height="54" Padding="16,0" CornerRadius="13" VerticalContentAlignment="Center"
                                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="19" FontWeight="Bold"
                                             LetterSpacing="1" BorderBrush="{DynamicResource GoldMutedBrush}"
                                             IsEnabled="{Binding !IsFriendInviteLooking}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding FindFriendInviteCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Classes="glass-wide" Height="54"
                                            Command="{Binding PasteFriendInviteCommand}" IsEnabled="{Binding !IsFriendInviteLooking}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                                            <TextBlock Text="{DynamicResource Friends_EntryPaste}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="primary" Height="54" Padding="26,0" CornerRadius="13" FontSize="15"
                                            Command="{Binding FindFriendInviteCommand}" IsEnabled="{Binding !IsFriendInviteLooking}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconSearch}" Classes="small"/>
                                            <TextBlock Text="{DynamicResource Friends_EntryFind}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{DynamicResource Friends_EntryHint}" Classes="faint" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                                             IsVisible="{Binding IsFriendInviteLooking}"/>

                                <!-- Why the code led nowhere, next to the box it was typed into. -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,8,0,0"
                                      IsVisible="{Binding HasFriendInviteNote}">
                                    <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource GoldBrush}"
                                              VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FriendInviteNote}" TextWrapping="Wrap" LineHeight="19"/>
                                </Grid>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!-- ======== An invite from a friend: shown, not yet acted on ======== -->
                    <Border Classes="card glass" Padding="20" IsVisible="{Binding HasFriendInvite}" controls:Reveal.OnVisible="True">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Width="48" Height="48" CornerRadius="14" VerticalAlignment="Top"
                                    Background="{DynamicResource IconBlueBrush}">
                                <PathIcon Data="{StaticResource IconUsers}" Width="24" Height="24" Foreground="#06202F"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <TextBlock Text="{Binding FriendInviteTitle}" Classes="h2" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding FriendInviteLines}"/>
                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <Button Classes="primary" Content="{DynamicResource Friends_InviteAccept}"
                                            Command="{Binding AcceptFriendInviteCommand}" IsEnabled="{Binding !IsFriendInviteBusy}"/>
                                    <Button Classes="ghost" Content="{DynamicResource Friends_InviteDecline}"
                                            Command="{Binding DeclineFriendInviteCommand}" IsEnabled="{Binding !IsFriendInviteBusy}"/>
                                    <ProgressBar IsIndeterminate="True" Width="80" Height="3" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsFriendInviteBusy}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ======== Friends' servers: where the player was invited ======== -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Friends_Title}" Classes="h3" VerticalAlignment="Bottom"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Friends_TitleHint}" Classes="faint" FontSize="12.5"
                                   VerticalAlignment="Bottom"/>
                    </Grid>

                    <Border Classes="row" Padding="18,16" IsVisible="{Binding !HasFriendServers}">
                        <TextBlock Text="{DynamicResource Friends_Empty}" Classes="muted" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FriendServers}" IsVisible="{Binding HasFriendServers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FriendServerItem">
                                <Border Classes="card glass" Padding="14,12" CornerRadius="16">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                        <Border Width="52" Height="52" CornerRadius="14" VerticalAlignment="Top"
                                                Background="{DynamicResource IconBlueBrush}">
                                            <PathIcon Data="{StaticResource IconUsers}" Width="22" Height="22" Foreground="#06202F"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                            <!-- Whether the build this server is played with is on the computer. -->
                                            <Grid ColumnDefinitions="10,*" ColumnSpacing="8">
                                                <Panel Width="10" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource SuccessBrush}"
                                                            IsVisible="{Binding HasBuild}"/>
                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource GoldBrush}"
                                                            IsVisible="{Binding !HasBuild}"/>
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding BuildLine}" FontSize="12.5" TextWrapping="Wrap" LineHeight="17"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       IsVisible="{Binding HasNote}"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center"
                                                     IsVisible="{Binding IsBusy}"/>
                                        <Button Grid.Column="2" Classes="primary" Height="40" Padding="20,0" CornerRadius="12" VerticalAlignment="Center"
                                                IsVisible="{Binding !IsBusy}" IsEnabled="{Binding HasBuild}"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).PlayFriendServerCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconPlay}" Classes="small"/>
                                                <TextBlock Text="{DynamicResource Friends_Play}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="plain small icon-danger" VerticalAlignment="Center"
                                                ToolTip.Tip="{DynamicResource Friends_Remove}"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveFriendServerCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ============================================================
                     MY SERVER
                     ============================================================ -->
                <StackPanel Spacing="16" IsVisible="{Binding IsFriendsMyServer}">

                    <!-- ======== Nothing made yet ======== -->
                    <Border Classes="hero-card" IsVisible="{Binding ShowHostEmpty}">
                        <Panel>
                            <Border IsHitTestVisible="False" CornerRadius="25" Background="{DynamicResource HeroGlowBrush}"/>
                            <Border IsHitTestVisible="False" HorizontalAlignment="Right" Width="380" CornerRadius="0,25,25,0"
                                    Background="{DynamicResource HeroGoldGlowBrush}"/>

                            <Grid Margin="28,26,28,28" ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                <Border Width="76" Height="76" CornerRadius="20" VerticalAlignment="Top"
                                        Background="{DynamicResource HeroGradientBrush}">
                                    <PathIcon Data="{StaticResource IconHost}" Width="36" Height="36"
                                              Foreground="{DynamicResource TextOnAccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="14">
                                    <TextBlock Text="{DynamicResource Host_EmptyTitle}" Classes="display hero" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Host_EmptyText}" Classes="muted" FontSize="14" LineHeight="21"
                                               TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"/>
                                    <Button Classes="primary hero" HorizontalAlignment="Left" Margin="0,4,0,0"
                                            Command="{Binding OpenHostCreateCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <PathIcon Data="{StaticResource IconPlus}" Classes="large"/>
                                            <TextBlock Text="{DynamicResource Host_Create}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>

                    <!-- ======== Creating a server: the choices on the left, what they lead to on the right ======== -->
                    <Border Classes="card glass" Padding="24" IsVisible="{Binding IsHostCreateOpen}" controls:Reveal.OnVisible="True">
                        <StackPanel Spacing="18">
                            <TextBlock Text="{DynamicResource Host_CreateTitle}" Classes="h1" FontSize="24"/>

                            <Grid ColumnDefinitions="330,*" ColumnSpacing="26">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_CreateBuild}" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding HostCreateBuilds}" SelectedItem="{Binding HostCreateInstance}"
                                                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsHostBusy}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="inst:Instance">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasHostCreateBuild}">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding HostCreateVersionLabel}"/>
                                            </Border>
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding HostCreateLoaderLabel}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{DynamicResource Host_CreateBuildHint}" Classes="faint" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_CreateName}" Classes="label"/>
                                        <TextBox Text="{Binding HostCreateName}" Watermark="{DynamicResource Host_CreateNameHint}"
                                                 MaxLength="48" IsEnabled="{Binding !IsHostBusy}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_CreateWorld}" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding HostCreateWorlds}" SelectedItem="{Binding HostCreateWorld}"
                                                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsHostBusy}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HostWorldChoice">
                                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{DynamicResource Host_CreateMemory}" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HostCreateMemoryLabel}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider Minimum="1024" Maximum="{Binding MemorySliderMax}" TickFrequency="512"
                                                IsSnapToTickEnabled="True" Value="{Binding HostCreateMemoryMb}"
                                                IsEnabled="{Binding !IsHostBusy}"/>
                                        <TextBlock Text="{DynamicResource Host_MemoryHint}" Classes="faint" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- As tall as the form beside it, so the licence and the button below stay
                                     on screen; a long list scrolls inside, the downloads at its top. -->
                                <Border Grid.Column="1" Classes="panel" CornerRadius="16" Padding="20,18,8,10" MaxHeight="400">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                                        <StackPanel Spacing="12" Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource Host_PlanTitle}" Classes="h3"/>

                                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsHostPlanBusy}">
                                                <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Host_PlanBusy}" Classes="faint" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Why this build cannot become a server, said plainly. -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasHostCreateProblem}">
                                                <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource GoldBrush}"
                                                          VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding HostCreateProblem}" TextWrapping="Wrap" LineHeight="19"/>
                                            </Grid>
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1">
                                            <ItemsControl ItemsSource="{Binding HostPlanLines}" Margin="0,0,14,0"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- The licence: the player's own tick, with the text one click away. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <WrapPanel ItemSpacing="4" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding HostEulaAccepted}" Content="{DynamicResource Host_Eula}"
                                              IsEnabled="{Binding !IsHostBusy}" VerticalAlignment="Center"/>
                                    <Button Classes="plain small" VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}"
                                            Content="{DynamicResource Host_EulaLink}" Command="{Binding OpenHostEulaCommand}"/>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="ghost" Height="42" Padding="18,0" Content="{DynamicResource Common_Cancel}"
                                            Command="{Binding CloseHostCreateCommand}" IsEnabled="{Binding !IsHostBusy}"/>
                                    <Button Classes="primary" Height="42" Padding="22,0" CornerRadius="12"
                                            Content="{DynamicResource Host_CreateConfirm}"
                                            Command="{Binding CreateHostServerCommand}" IsEnabled="{Binding CanCreateHostServer}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="7" IsVisible="{Binding IsHostBusy}">
                                <TextBlock Text="{Binding HostBusyText}" Classes="muted" FontSize="13"/>
                                <ProgressBar Value="{Binding HostProgress}" Minimum="0" Maximum="100" Height="6"
                                             IsIndeterminate="{Binding IsHostProgressUnknown}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ======== The server: what it is, whether it runs, the buttons that run it ======== -->
                    <Border Classes="hero-card" IsVisible="{Binding ShowHostServer}">
                        <Panel>
                            <Border IsHitTestVisible="False" CornerRadius="25" Background="{DynamicResource HeroGlowBrush}"/>
                            <Border IsHitTestVisible="False" HorizontalAlignment="Right" Width="380" CornerRadius="0,25,25,0"
                                    Background="{DynamicResource HeroGoldGlowBrush}"/>

                            <StackPanel Margin="24,22,24,22" Spacing="16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource HeroGradientBrush}"
                                            VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconHost}" Width="30" Height="30"
                                                  Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                            <TextBlock Text="{Binding HostServerName}" Classes="display hero" FontSize="26"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                            <Border Grid.Column="1" Classes="pill small" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsHostOnline}"/>
                                                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource GoldBrush}" IsVisible="{Binding IsHostWorking}"/>
                                                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsHostOff}"/>
                                                    <TextBlock Text="{Binding HostStateLabel}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding HostVersionLabel}"/>
                                            </Border>
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding HostLoaderLabel}"/>
                                            </Border>
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding HostMemoryLabel}"/>
                                            </Border>
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding HostPortLabel}"/>
                                            </Border>
                                            <TextBlock Text="{Binding HostBuildLabel}" Classes="faint" FontSize="12.5"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="glass-wide"
                                                Command="{Binding PlayOnHostServerCommand}" ToolTip.Tip="{DynamicResource Host_PlaySelfHint}"
                                                IsVisible="{Binding CanPlayOnHost}" IsEnabled="{Binding !IsBusy}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconPlay}" Classes="small"/>
                                                <TextBlock Text="{DynamicResource Host_PlaySelf}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="primary" Height="46" Padding="22,0" CornerRadius="13" FontSize="15"
                                                Command="{Binding StartHostServerCommand}"
                                                IsVisible="{Binding IsHostOff}" IsEnabled="{Binding CanStartHost}">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <PathIcon Data="{StaticResource IconPlay}" Classes="small"/>
                                                <TextBlock Text="{DynamicResource Host_Start}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="glass-wide"
                                                Command="{Binding StopHostServerCommand}"
                                                IsVisible="{Binding !IsHostOff}" IsEnabled="{Binding CanStopHost}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconStop}" Classes="small"/>
                                                <TextBlock Text="{DynamicResource Host_Stop}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- The server's settings have a tab of their own; the gear leads there. -->
                                        <Button Classes="glass-icon" Width="46" Height="46" ToolTip.Tip="{DynamicResource Host_TabSettings}"
                                                Command="{Binding SelectHostTabCommand}" CommandParameter="Settings">
                                            <PathIcon Data="{StaticResource IconSettings}" Classes="small"/>
                                        </Button>
                                        <Button Classes="glass-icon" Width="46" Height="46" ToolTip.Tip="{DynamicResource Host_OpenFolder}"
                                                Command="{Binding OpenHostFolderCommand}">
                                            <PathIcon Data="{StaticResource IconFolder}" Classes="small"/>
                                        </Button>
                                        <Button Classes="glass-icon" Width="46" Height="46" ToolTip.Tip="{DynamicResource Host_Remove}">
                                            <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                            <Button.Flyout>
                                                <controls:RevealFlyout Placement="BottomEdgeAlignedRight">
                                                    <StackPanel Spacing="10" Width="300">
                                                        <TextBlock Text="{DynamicResource Host_RemoveHint}" Classes="muted" TextWrapping="Wrap"/>
                                                        <Button Classes="danger small" HorizontalAlignment="Left"
                                                                Content="{DynamicResource Host_Remove}"
                                                                Command="{Binding RemoveHostServerCommand}" IsEnabled="{Binding CanEditHost}"/>
                                                    </StackPanel>
                                                </controls:RevealFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- A lookup, a download or a copy in progress. -->
                                <StackPanel Spacing="7" IsVisible="{Binding IsHostBusy}">
                                    <TextBlock Text="{Binding HostBusyText}" Classes="muted" FontSize="13"/>
                                    <ProgressBar Value="{Binding HostProgress}" Minimum="0" Maximum="100" Height="6"
                                                 IsIndeterminate="{Binding IsHostProgressUnknown}"/>
                                </StackPanel>

                                <!-- Why the server is not running although it was asked to. -->
                                <Border Classes="panel" CornerRadius="14" Padding="14,12" IsVisible="{Binding HasHostNotice}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource GoldBrush}"
                                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HostNotice}" TextWrapping="Wrap" LineHeight="19"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Center"
                                                Content="{DynamicResource Host_UseFreePort}"
                                                Command="{Binding UseFreeHostPortCommand}" IsVisible="{Binding HostNoticeOffersPort}"/>
                                    </Grid>
                                </Border>

                                <!-- Something has to be downloaded or agreed to first: what, from where, how big. -->
                                <Border Classes="panel" CornerRadius="14" Padding="18,16,18,14" IsVisible="{Binding IsHostConsentOpen}"
                                        controls:Reveal.OnVisible="True">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding HostConsentTitle}" Classes="h3"/>
                                        <ItemsControl ItemsSource="{Binding HostConsentLines}"/>
                                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                                            <Button Classes="primary small" Content="{Binding HostConsentAction}"
                                                    Command="{Binding ConfirmHostConsentCommand}"/>
                                            <Button Classes="ghost small" Content="{DynamicResource Common_Cancel}"
                                                    Command="{Binding CancelHostConsentCommand}"/>
                                            <Button Classes="plain small" Foreground="{DynamicResource GoldBrush}"
                                                    Content="{DynamicResource Host_EulaLink}"
                                                    Command="{Binding OpenHostEulaCommand}" IsVisible="{Binding HostConsentHasEula}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!-- ======== The server's tabs; beside them, the other servers and a new one ======== -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding ShowHostServer}">
                        <Border Classes="segments">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="segment" Classes.active="{Binding IsHostOverview}"
                                        Content="{DynamicResource Host_TabOverview}"
                                        Command="{Binding SelectHostTabCommand}" CommandParameter="Overview"/>
                                <Button Classes="segment" Classes.active="{Binding IsHostPlayersTab}"
                                        Content="{DynamicResource Host_TabPlayers}"
                                        Command="{Binding SelectHostTabCommand}" CommandParameter="Players"/>
                                <Button Classes="segment" Classes.active="{Binding IsHostModsTab}"
                                        Content="{DynamicResource Host_TabMods}"
                                        Command="{Binding SelectHostTabCommand}" CommandParameter="Mods"/>
                                <Button Classes="segment" Classes.active="{Binding IsHostSettingsTab}"
                                        Content="{DynamicResource Host_TabSettings}"
                                        Command="{Binding SelectHostTabCommand}" CommandParameter="Settings"/>
                                <Button Classes="segment" Classes.active="{Binding IsHostConsoleTab}"
                                        Content="{DynamicResource Host_TabConsole}"
                                        Command="{Binding SelectHostTabCommand}" CommandParameter="Console"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding HostServers}" SelectedItem="{Binding SelectedHostServer}"
                                      MinWidth="180" MaxWidth="240" IsVisible="{Binding HasManyHostServers}"
                                      ToolTip.Tip="{DynamicResource Host_PickServer}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="hosting:HostedServer">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="ghost small" Height="36" Command="{Binding OpenHostCreateCommand}"
                                    IsVisible="{Binding HasHostServers}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconPlus}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Host_Another}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Panel IsVisible="{Binding ShowHostServer}">

                        <!-- ================= Overview ================= -->
                        <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="16" IsVisible="{Binding IsHostOverview}">

                            <!-- How to invite a friend: three steps, each showing where it stands. -->
                            <Border Classes="card glass" Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="{DynamicResource Host_InviteTitle}" Classes="label"/>

                                    <!-- 1. The server runs -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Panel>
                                            <Border Classes="step done" IsVisible="{Binding IsHostOnline}">
                                                <PathIcon Data="{StaticResource IconCheck}"/>
                                            </Border>
                                            <Border Classes="step" IsVisible="{Binding !IsHostOnline}">
                                                <TextBlock Text="1"/>
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <Panel>
                                                <TextBlock Text="{DynamicResource Host_Step1Done}" FontWeight="SemiBold" FontSize="14"
                                                           IsVisible="{Binding IsHostOnline}"/>
                                                <TextBlock Text="{DynamicResource Host_Step1Todo}" FontWeight="SemiBold" FontSize="14"
                                                           IsVisible="{Binding !IsHostOnline}"/>
                                            </Panel>
                                            <Panel>
                                                <TextBlock Text="{DynamicResource Host_Step1DoneNote}" Classes="faint" TextWrapping="Wrap" LineHeight="17"
                                                           IsVisible="{Binding IsHostOnline}"/>
                                                <TextBlock Text="{DynamicResource Host_Step1TodoNote}" Classes="faint" TextWrapping="Wrap" LineHeight="17"
                                                           IsVisible="{Binding IsHostOff}"/>
                                                <TextBlock Text="{DynamicResource Host_Step1WorkingNote}" Classes="faint" TextWrapping="Wrap" LineHeight="17"
                                                           IsVisible="{Binding IsHostWorking}"/>
                                            </Panel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 2. The friend's nickname is on the list -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Panel>
                                            <Border Classes="step done" IsVisible="{Binding HasHostFriendListed}">
                                                <PathIcon Data="{StaticResource IconCheck}"/>
                                            </Border>
                                            <Border Classes="step" IsVisible="{Binding !HasHostFriendListed}">
                                                <TextBlock Text="2"/>
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{DynamicResource Host_Step2}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{DynamicResource Host_Step2Note}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox Text="{Binding HostWhitelistEntry}" Watermark="{DynamicResource Host_WhitelistAdd}"
                                                         MaxLength="16" Height="38">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding AddHostWhitelistCommand}"/>
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="1" Classes="ghost small" Height="38" Padding="14,0"
                                                        Content="{DynamicResource Host_WhitelistAddButton}"
                                                        Command="{Binding AddHostWhitelistCommand}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding HostWhitelist}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="6" LineSpacing="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sys:String">
                                                        <Border Classes="chip" Padding="10,2,2,2">
                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                                <Button Classes="plain small icon-danger" Padding="5,4" MinWidth="0"
                                                                        ToolTip.Tip="{DynamicResource Host_WhitelistRemoveTip}"
                                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveHostWhitelistCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. The code goes to the friend -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Panel>
                                            <Border Classes="step done" IsVisible="{Binding HasHostInviteCode}">
                                                <PathIcon Data="{StaticResource IconCheck}"/>
                                            </Border>
                                            <Border Classes="step" IsVisible="{Binding !HasHostInviteCode}">
                                                <TextBlock Text="3"/>
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="{DynamicResource Host_Step3}" FontWeight="SemiBold" FontSize="14"/>

                                            <Border CornerRadius="14" Padding="16,12,12,12" Background="{DynamicResource PillBrush}"
                                                    BorderBrush="{DynamicResource GoldMutedBrush}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <Panel VerticalAlignment="Center">
                                                        <!-- The short code: large, to be read out or retyped. -->
                                                        <SelectableTextBlock Text="{Binding HostInviteCode}" IsVisible="{Binding IsHostInviteShort}"
                                                                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="26" FontWeight="ExtraBold"
                                                                             LetterSpacing="1.5" Foreground="{DynamicResource GoldBrush}"/>
                                                        <!-- The long line cannot be read out; it is only said that it was copied. -->
                                                        <StackPanel Spacing="2" IsVisible="{Binding IsHostInviteLong}">
                                                            <TextBlock Text="{DynamicResource Host_InviteLongCopied}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding HostInviteCode}" Classes="mono" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{DynamicResource Host_InvitePlaceholder}" Classes="muted" FontSize="13"
                                                                   TextWrapping="Wrap" LineHeight="18"
                                                                   IsVisible="{Binding !HasHostInviteCode}"/>
                                                    </Panel>
                                                    <!-- The main thing to do once the server is up; a quiet outline until then. -->
                                                    <Button Grid.Column="1" Classes.primary="{Binding IsHostOnline}" Classes.ghost="{Binding !IsHostOnline}"
                                                            Height="40" Padding="16,0" CornerRadius="12" VerticalAlignment="Center"
                                                            ToolTip.Tip="{DynamicResource Host_CopyInvite}"
                                                            Command="{Binding CopyHostInviteCommand}" IsEnabled="{Binding !IsHostInviteBusy}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                                                            <TextBlock Text="{DynamicResource Host_InviteCopy}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsHostInviteBusy}"/>
                                            <TextBlock Text="{DynamicResource Host_Step3Note}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="12">

                                <!-- How friends connect: the two ways, each with its own switch. -->
                                <Border Classes="card glass" Padding="16">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{DynamicResource Host_WaysTitle}" Classes="label"/>
                                            <TextBlock Text="{DynamicResource Host_WaysHint}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding HostWays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HostWayItem">
                                                    <Border Classes="row">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                <Panel VerticalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource IconUsers}" Classes="small gold" IsVisible="{Binding IsRelay}"/>
                                                                    <PathIcon Data="{StaticResource IconDirect}" Classes="small gold" IsVisible="{Binding IsDirect}"/>
                                                                </Panel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                <!-- The switch shows the state and changes it; the view model decides what flipping it does. -->
                                                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsOn, Mode=OneWay}"
                                                                              OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                                                              IsEnabled="{Binding CanSwitch}"
                                                                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleHostWayCommand}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Grid>

                                                            <Grid ColumnDefinitions="10,*" ColumnSpacing="8">
                                                                <Panel Width="10" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource TextMutedBrush}"
                                                                            IsVisible="{Binding IsOff}"/>
                                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource GoldBrush}"
                                                                            IsVisible="{Binding IsWorking}"/>
                                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource SuccessBrush}"
                                                                            IsVisible="{Binding IsReady}"/>
                                                                    <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource DangerBrush}"
                                                                            IsVisible="{Binding IsFailed}"/>
                                                                </Panel>
                                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="17"/>
                                                            </Grid>

                                                            <!-- Voice chat, when the server has it: carried, or whether the router opened its port. -->
                                                            <TextBlock Text="{Binding VoiceText}" IsVisible="{Binding HasVoiceText}" Classes="muted"
                                                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="17" Margin="18,0,0,0"/>

                                                            <TextBlock Text="{Binding Description}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>

                                                            <Border CornerRadius="10" Padding="10,8" Background="{DynamicResource TileGoldBrush}"
                                                                    BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" IsVisible="{Binding HasWarning}">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                    <PathIcon Data="{StaticResource IconWarning}" Classes="small gold" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12.5" LineHeight="17"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- The address friends type in, when the way has one of its own. -->
                                                            <Border Classes="panel" Padding="10,4,4,4" IsVisible="{Binding HasAddress}">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding Address}" Classes="mono" FontSize="13" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Button Grid.Column="1" Classes="plain small" ToolTip.Tip="{DynamicResource Server_CopyAddress}"
                                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyHostWayAddressCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Who is on the server right now. -->
                                <Border Classes="card glass" Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{DynamicResource Host_OnlineLabel}" Classes="label"/>
                                        <TextBlock Text="{Binding HostPlayersLabel}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding HostPlayers}" IsVisible="{Binding HasHostPlayers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Border Classes="row" Padding="12,9">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                                    Background="{DynamicResource SuccessBrush}"/>
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ================= Players: who may join, who is there ================= -->
                        <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="16" IsVisible="{Binding IsHostPlayersTab}">
                            <Border Classes="card glass" Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{DynamicResource Host_Whitelist}" Classes="h3"/>
                                    <TextBlock Text="{DynamicResource Host_WhitelistHint}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox Text="{Binding HostWhitelistEntry}" Watermark="{DynamicResource Host_WhitelistAdd}" MaxLength="16">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding AddHostWhitelistCommand}"/>
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Classes="primary small" Height="36" Padding="14,0"
                                                Content="{DynamicResource Host_WhitelistAddButton}"
                                                Command="{Binding AddHostWhitelistCommand}"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding HostWhitelist}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <Border Classes="row" Padding="14,6,6,6">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1" Classes="plain small icon-danger"
                                                                ToolTip.Tip="{DynamicResource Host_WhitelistRemoveTip}"
                                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveHostWhitelistCommand}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card glass" Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{DynamicResource Host_OnlineTitle}" Classes="h3"/>
                                    <TextBlock Text="{Binding HostPlayersLabel}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding HostPlayers}" IsVisible="{Binding HasHostPlayers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <Border Classes="row" Padding="14,10">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                                Background="{DynamicResource SuccessBrush}"/>
                                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ================= Mods: a view of its own, so it can grow a catalog ================= -->
                        <pages:HostModsView IsVisible="{Binding IsHostModsTab}"/>

                        <!-- ================= The server's settings ================= -->
                        <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="16" IsVisible="{Binding IsHostSettingsTab}">
                            <Border Classes="card glass" Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{DynamicResource Host_TabSettings}" Classes="h3"/>
                                        <TextBlock Text="{DynamicResource Host_SettingsHint}" Classes="faint" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_CreateName}" Classes="label"/>
                                        <TextBox Text="{Binding HostNameEntry}" Watermark="{DynamicResource Host_CreateNameHint}"
                                                 MaxLength="48" IsEnabled="{Binding CanEditHost}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{DynamicResource Host_CreateMemory}" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HostMemoryLabel}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider Minimum="1024" Maximum="{Binding MemorySliderMax}" TickFrequency="512"
                                                IsSnapToTickEnabled="True" Value="{Binding HostMemoryMb}"
                                                IsEnabled="{Binding CanEditHost}"/>
                                        <TextBlock Text="{DynamicResource Host_MemoryHint}" Classes="faint" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_SettingsPort}" Classes="label"/>
                                        <NumericUpDown Value="{Binding HostPortValue}" Minimum="1024" Maximum="65535"
                                                       Increment="1" FormatString="0" Width="160" HorizontalAlignment="Left"
                                                       IsEnabled="{Binding CanEditHost}"/>
                                        <TextBlock Text="{DynamicResource Host_SettingsPortHint}" Classes="faint" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card glass" Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{DynamicResource Host_FilesTitle}" Classes="h3"/>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_FolderHint}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>
                                        <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding OpenHostFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconFolder}" Classes="small"/>
                                                <TextBlock Text="{DynamicResource Host_OpenFolder}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{DynamicResource Host_RemoveHint}" Classes="faint" TextWrapping="Wrap" LineHeight="17"/>
                                        <!-- Still two clicks: the button opens the question, the question removes. -->
                                        <Button Classes="ghost" HorizontalAlignment="Left" IsEnabled="{Binding CanEditHost}"
                                                Content="{DynamicResource Host_Remove}">
                                            <Button.Flyout>
                                                <controls:RevealFlyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel Spacing="10" Width="280">
                                                        <TextBlock Text="{DynamicResource Host_RemoveAsk}" Classes="muted" TextWrapping="Wrap"/>
                                                        <Button Classes="danger small" HorizontalAlignment="Left"
                                                                Content="{DynamicResource Host_Remove}"
                                                                Command="{Binding RemoveHostServerCommand}" IsEnabled="{Binding CanEditHost}"/>
                                                    </StackPanel>
                                                </controls:RevealFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ================= Console ================= -->
                        <Border Classes="card glass" Padding="20" IsVisible="{Binding IsHostConsoleTab}">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Text="{DynamicResource Host_Console}" Classes="h3"/>

                                <!-- Sized so the command line under it is on screen in a window of the
                                     launcher's usual size, without scrolling the page. -->
                                <Border Grid.Row="1" Classes="panel" Height="286" Padding="0">
                                    <Panel>
                                        <TextBlock Text="{DynamicResource Host_ConsoleEmpty}" Classes="faint"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasHostConsole}"/>
                                        <!-- Plain lines in a scroller rather than a list box: log lines are not
                                             rows to select, and with every line measured the view can follow
                                             the last one exactly. The view model keeps it to a few hundred. -->
                                        <ScrollViewer Name="ConsoleScroll">
                                            <!-- The gap is the content's margin, not the scroller's padding:
                                                 padding is left out of the scroll range and hides the last line. -->
                                            <ItemsControl ItemsSource="{Binding HostConsole}" Margin="12,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sys:String">
                                                        <TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Panel>
                                </Border>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding HostCommand}" Watermark="{DynamicResource Host_CommandHint}"
                                             IsEnabled="{Binding CanStopHost}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SendHostCommandCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Classes="ghost small" Height="36" Padding="14,0"
                                            Command="{Binding SendHostCommandCommand}" IsEnabled="{Binding CanStopHost}"
                                            ToolTip.Tip="{DynamicResource Host_Send}">
                                        <PathIcon Data="{StaticResource IconSend}" Classes="small"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Panel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
