<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:content="using:STlauncher.Core.Content"
             x:Class="STlauncher.App.Views.Pages.ContentPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="22" RowDefinitions="Auto,*" RowSpacing="14">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Nav_Content}" Classes="label"/>
                <TextBlock Text="{Binding CatalogStatus}" Classes="faint" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Content_Reload}"
                    Command="{Binding LoadCatalogCommand}" IsEnabled="{Binding !IsCatalogBusy}"
                    VerticalAlignment="Top"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding CatalogSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="content:CatalogSection">
                        <StackPanel Spacing="10" Margin="0,0,0,22">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Classes="faint" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="content:CatalogItem">
                                        <Border Classes="panel" Padding="14" Margin="0,3">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Classes="faint"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="ghost small"
                                                        Content="{DynamicResource Content_Install}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InstallCatalogItemCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
