<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:content="using:STlauncher.Core.Content"
             x:Class="STlauncher.App.Views.Pages.ContentPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="22" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <!-- Recommended builds -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Content_Builds}" Classes="label"/>
                <ComboBox ItemsSource="{Binding CatalogBuilds}"
                          SelectedItem="{Binding SelectedBuild}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="{DynamicResource Content_BuildsHint}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="content:CatalogBuild">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Classes="faint"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Content_Reload}"
                    Command="{Binding LoadCatalogCommand}" IsEnabled="{Binding !IsCatalogBusy}"
                    VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding CatalogFilter}"
                     Watermark="{DynamicResource Content_FilterHint}"/>
            <CheckBox Grid.Column="1" Content="{DynamicResource Content_OnlyRequired}"
                      IsChecked="{Binding CatalogOnlyRequired}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock Text="{Binding CatalogStatus}" Classes="faint" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding CatalogViews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogSectionView">
                            <StackPanel Spacing="10" Margin="0,0,0,22">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Classes="faint"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CatalogItemView">
                                            <Border Classes="panel" Padding="14" Margin="0,3">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{DynamicResource Content_Required}"
                                                                       Classes="gold"
                                                                       IsVisible="{Binding Item.Required}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Item.Description}" Classes="faint"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Classes="ghost small"
                                                            Content="{DynamicResource Content_Install}"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InstallCatalogItemCommand}"
                                                            CommandParameter="{Binding Item}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
