<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:sys="using:System"
             xmlns:conv="using:STlauncher.App.Converters"
             xmlns:controls="using:STlauncher.App.Controls"
             x:Class="STlauncher.App.Views.Pages.ServerPage"
             x:DataType="vm:MainWindowViewModel">

    <!-- The Showtime server: its name and whether it answers, the one button that plays on
         it, the build that button starts and how that build stands against the catalog,
         then the figures of its online and the ways to its community - all as rows on the
         ground, nothing in a card. -->

    <UserControl.Styles>
        <!-- One figure of the online: a caption, the number, what the number counts. -->
        <Style Selector="TextBlock.figure">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="LetterSpacing" Value="-0.4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="48,26,48,28" MaxWidth="1180">

            <!-- ======== The server and the one thing to do with it ======== -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <Border Width="60" Height="60" CornerRadius="14" Background="{DynamicResource FieldBrush}"
                        ClipToBounds="True" VerticalAlignment="Center">
                    <Image Source="{Binding ServerIcon}" Stretch="UniformToFill" Width="60" Height="60"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ServerName}" Classes="page-title large"/>

                    <!-- Alive or not, how many are on, what it runs. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <StackPanel Classes="meta">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Classes="dot" IsVisible="{Binding IsServerOnline}"/>
                                <Ellipse Classes="dot off" IsVisible="{Binding !IsServerOnline}"/>
                                <TextBlock Text="{DynamicResource Server_Online}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding IsServerOnline}"/>
                                <TextBlock Text="{DynamicResource Server_OfflineTag}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding !IsServerOnline}"/>
                            </StackPanel>
                            <Ellipse IsVisible="{Binding IsServerOnline}"/>
                            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsServerOnline}">
                                <TextBlock Text="{Binding ServerOnlineValue}" Classes="strong" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ServerOnlineCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse IsVisible="{Binding IsServerOnline}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ServerVersion}" Classes="mono" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding IsServerOnline}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="icon" Width="40" Height="40" Command="{Binding RefreshServerStatusCommand}"
                            IsEnabled="{Binding !IsServerStatusBusy}"
                            ToolTip.Tip="{DynamicResource Server_Refresh}">
                        <PathIcon Data="{StaticResource IconRefresh}"/>
                    </Button>
                    <Button Classes="play" Command="{Binding PlayOnServerCommand}" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="{Binding ServerJoinHint}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconPlay}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayOnServerLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The address, to hand to a friend or another launcher, and what the server says of itself. -->
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,16,0,0">
                <TextBlock Text="{Binding ServerAddress}" Classes="mono" FontSize="13" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="icon" Command="{Binding CopyServerAddressCommand}"
                        ToolTip.Tip="{DynamicResource Server_CopyAddress}">
                    <PathIcon Data="{StaticResource IconCopy}"/>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding ServerMotd}" Classes="sub" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding ServerMotd}"/>
            </Grid>

            <!-- ======== The build the button starts, against the server's catalog ======== -->
            <controls:Caption Text="{DynamicResource Server_BuildCaption}" Margin="12,28,0,6"/>

            <Border Classes="row first"
                    IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="icon-tile"
                            Background="{Binding SelectedInstance.Name, Converter={x:Static conv:TintBrushConverter.Instance}}">
                        <PathIcon Data="{StaticResource IconBuilds}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedInstance.Name, FallbackValue=''}" Classes="strong" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Classes="dot" IsVisible="{Binding !IsBuildSyncBusy}"/>
                            <Ellipse Classes="dot warn" IsVisible="{Binding IsBuildSyncBusy}"/>
                            <TextBlock Text="{Binding BuildStateLabel}" Classes="sub" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Server_BuildOpen}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Builds"/>
                </Grid>
            </Border>

            <!-- The catalog changed the build, or offers to: what is different, and the answer. -->
            <Border Classes="row" IsVisible="{Binding HasBuildChangeNotice}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="icon-tile" Background="{DynamicResource FieldBrush}" VerticalAlignment="Top">
                        <PathIcon Data="{StaticResource IconUpdate}" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BuildChangeTitle}" Classes="strong" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding BuildChangeLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3">
                                        <Ellipse Width="4" Height="4" Margin="1,7,0,0" VerticalAlignment="Top"
                                                 Fill="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted" TextWrapping="Wrap" LineHeight="17"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource BuildChange_Hint}" Classes="sub" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPendingBuildSync}"/>
                        <!-- Nothing has happened yet: the player decides. -->
                        <TextBlock Text="{DynamicResource BuildChange_PendingHint}" Classes="sub" TextWrapping="Wrap"
                                   IsVisible="{Binding HasPendingBuildSync}"/>
                    </StackPanel>
                    <Panel Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPendingBuildSync}">
                            <Button Content="{DynamicResource BuildChange_Apply}"
                                    Command="{Binding ApplyPendingBuildSyncCommand}" IsEnabled="{Binding !IsBuildSyncBusy}"/>
                            <Button Classes="ghost" Content="{DynamicResource BuildChange_Later}"
                                    Command="{Binding DeclinePendingBuildSyncCommand}"/>
                        </StackPanel>
                        <Button Classes="icon" IsVisible="{Binding !HasPendingBuildSync}"
                                Command="{Binding DismissBuildChangeNoticeCommand}"
                                ToolTip.Tip="{DynamicResource WhatsNew_Close}">
                            <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11"/>
                        </Button>
                    </Panel>
                </Grid>
            </Border>

            <!-- ======== The online, in figures ======== -->
            <controls:Caption Text="{DynamicResource Server_Monitoring}" Margin="12,28,0,10"/>

            <UniformGrid Columns="5" Margin="12,0,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Server_TileOnline}" Classes="sub"/>
                    <TextBlock Text="{Binding ServerOnlineValue}" Classes="figure"/>
                    <TextBlock Text="{Binding ServerOnlineCaption}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Server_TileAverageWeek}" Classes="sub"/>
                    <TextBlock Text="{Binding ServerAverageWeekValue}" Classes="figure"/>
                    <TextBlock Text="{DynamicResource Server_TilePlayers}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Server_TileRecord}" Classes="sub"/>
                    <TextBlock Text="{Binding ServerRecordValue}" Classes="figure"/>
                    <TextBlock Text="{Binding ServerRecordCaption}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Server_TileUptime}" Classes="sub"/>
                    <TextBlock Text="{Binding ServerUptimeValue}" Classes="figure"/>
                    <TextBlock Text="{DynamicResource Server_TileUptimeCaption}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Server_TileRank}" Classes="sub"/>
                    <TextBlock Text="{Binding ServerRankValue}" Classes="figure"/>
                    <TextBlock Text="Top-Minecrafter" Classes="sub" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </UniformGrid>

            <!-- ======== The chart ======== -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="12,26,0,12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChartTitle}" Classes="strong" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ServerAverage}" Classes="sub"/>
                        <TextBlock Text="·" Classes="sub" IsVisible="{Binding ServerPeak, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ServerPeak}" Classes="sub"/>
                        <TextBlock Text="·" Classes="sub" IsVisible="{Binding ServerStatsSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ServerStatsSource}" Classes="sub"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="segment" Classes.active="{Binding IsDayRange}"
                                Content="{DynamicResource Server_RangeDay}"
                                Command="{Binding SelectMonitoringRangeCommand}" CommandParameter="Day"/>
                        <Button Classes="segment" Classes.active="{Binding IsWeekRange}"
                                Content="{DynamicResource Server_RangeWeek}"
                                Command="{Binding SelectMonitoringRangeCommand}" CommandParameter="Week"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid RowDefinitions="160,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="6" Margin="12,0,0,0"
                  IsVisible="{Binding HasServerHistory}">
                <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*,Auto" MinWidth="28">
                    <TextBlock Grid.Row="0" Text="{Binding ChartTopLabel}" Classes="sub" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="0" Classes="sub" HorizontalAlignment="Right"/>
                </Grid>

                <controls:OnlineChart Grid.Row="0" Grid.Column="1" Bars="{Binding ServerChartBars}"/>

                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding ChartStartLabel}" Classes="sub"/>
                    <TextBlock Grid.Column="2" Text="{Binding ChartEndLabel}" Classes="sub"/>
                </Grid>
            </Grid>

            <TextBlock Text="{DynamicResource Server_ChartEmpty}" Classes="sub" Margin="12,0,0,0" TextWrapping="Wrap"
                       IsVisible="{Binding !HasServerHistory}"/>

            <TextBlock Text="{Binding ServerMonitoringNote}" Classes="sub" TextWrapping="Wrap" Margin="12,6,0,0"
                       IsVisible="{Binding ServerMonitoringNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- ======== Community ======== -->
            <controls:Caption Text="{DynamicResource Server_Community}" Margin="12,28,0,6"/>

            <StackPanel>
                <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="icon-tile" Background="{DynamicResource FieldBrush}">
                            <PathIcon Data="{StaticResource IconGlobe}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Server_Site}" Classes="strong"/>
                            <TextBlock Text="showtime.su" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenWebsiteCommand}"/>
                    </Grid>
                </Border>
                <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="icon-tile" Background="{DynamicResource FieldBrush}">
                            <PathIcon Data="{StaticResource IconSend}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Telegram" Classes="strong"/>
                            <TextBlock Text="t.me/ShowTimeMc" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenUrlCommand}" CommandParameter="https://t.me/ShowTimeMc"/>
                    </Grid>
                </Border>
                <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="icon-tile" Background="{DynamicResource FieldBrush}">
                            <PathIcon Data="{StaticResource IconChat}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Discord" Classes="strong"/>
                            <TextBlock Text="discord.gg/showtimes" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenUrlCommand}" CommandParameter="https://discord.gg/showtimes"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
