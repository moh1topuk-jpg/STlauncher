<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             x:Class="STlauncher.App.Views.Pages.ServerPage"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="22" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="{DynamicResource Nav_Server}" Classes="label"/>

            <!-- The server is part of the launcher, not a user setting -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Width="64" Height="64" CornerRadius="10" Background="#2A2028"
                                ClipToBounds="True">
                            <Image Source="{Binding ServerLogo}" Stretch="UniformToFill"
                                   Width="64" Height="64"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ServerName}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ServerAddress}" Classes="faint"/>
                        </StackPanel>
                    </Grid>

                    <Button Classes="primary" Content="{DynamicResource Server_Join}"
                            Command="{Binding PlayOnServerCommand}" IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="44"/>

                    <Border Classes="hairline"/>
                    <TextBlock Text="{DynamicResource Server_PortHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Server_GlobalHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Website -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource Server_Site}" Classes="label"/>
                    <TextBlock Text="showtime.su" FontWeight="SemiBold"/>
                    <Button Classes="ghost" HorizontalAlignment="Left"
                            Content="{DynamicResource Server_OpenSite}"
                            Command="{Binding OpenWebsiteCommand}"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <TextBlock Text="{DynamicResource Server_More}" Classes="faint" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
