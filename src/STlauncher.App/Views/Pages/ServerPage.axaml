<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             x:Class="STlauncher.App.Views.Pages.ServerPage"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="22" Spacing="14" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="{DynamicResource Nav_Server}" Classes="label"/>

            <!-- The server is part of the launcher, not a user setting -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="64" Height="64" CornerRadius="10" Background="#2A2028"
                                ClipToBounds="True">
                            <Image Source="{Binding ServerIcon}" Stretch="UniformToFill"
                                   Width="64" Height="64"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ServerName}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ServerAddress}" Classes="faint"/>
                            <TextBlock Text="{Binding ServerMotd}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ServerPlayers}" Classes="gold"
                                       IsVisible="{Binding IsServerOnline}"/>
                            <TextBlock Text="{Binding ServerVersion}" Classes="faint"
                                       IsVisible="{Binding IsServerOnline}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Top"
                                Content="{DynamicResource Server_Refresh}"
                                Command="{Binding RefreshServerStatusCommand}"
                                IsEnabled="{Binding !IsServerStatusBusy}"/>
                    </Grid>

                    <Button Classes="primary" Content="{DynamicResource Server_Join}"
                            Command="{Binding PlayOnServerCommand}" IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="44"/>

                    <Border Classes="hairline"/>
                    <TextBlock Text="{DynamicResource Server_PortHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Server_GlobalHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Monitoring -->
            <Border Classes="card">
                <StackPanel Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock Text="{DynamicResource Server_Monitoring}" Classes="label"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Classes="segment small" Classes.active="{Binding IsDayRange}"
                                    Content="{DynamicResource Server_RangeDay}"
                                    Command="{Binding SelectMonitoringRangeCommand}" CommandParameter="Day"/>
                            <Button Classes="segment small" Classes.active="{Binding IsWeekRange}"
                                    Content="{DynamicResource Server_RangeWeek}"
                                    Command="{Binding SelectMonitoringRangeCommand}" CommandParameter="Week"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14">
                        <TextBlock Text="{Binding ServerAverage}" Classes="gold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ServerPeak}" Classes="faint"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Figures from the monitoring site. They are worth their own row
                         because they are there from the very first launch, before the
                         chart has anything in it. -->
                    <Border Classes="panel" Padding="12" IsVisible="{Binding HasServerSummary}">
                        <WrapPanel>
                            <TextBlock Text="{Binding ServerAverageWeek}" Classes="gold" Margin="0,0,16,0"
                                       IsVisible="{Binding ServerAverageWeek, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding ServerRecord}" Margin="0,0,16,0"
                                       IsVisible="{Binding ServerRecord, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding ServerUptime}" Classes="faint" Margin="0,0,16,0"
                                       IsVisible="{Binding ServerUptime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding ServerRank}" Classes="faint"
                                       IsVisible="{Binding ServerRank, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Chart. Bars fill the width through a UniformGrid, so the picture
                         stays readable whether it holds 24 or 28 columns. -->
                    <Border Classes="panel" Padding="10" IsVisible="{Binding HasServerHistory}">
                        <Grid RowDefinitions="Auto,96,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="{Binding ChartTopLabel}" Classes="faint"
                                       HorizontalAlignment="Left"/>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ServerChartBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerChartBar">
                                        <Grid Margin="1,0">
                                            <!-- A slice the launcher was not running for:
                                                 a baseline tick, not a zero-height bar. -->
                                            <Border VerticalAlignment="Bottom" Height="2" CornerRadius="1"
                                                    Background="{DynamicResource DividerBrush}"
                                                    IsVisible="{Binding !HasData}"/>

                                            <Border VerticalAlignment="Bottom" CornerRadius="2,2,0,0"
                                                    Height="{Binding Height}"
                                                    Background="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding HasData}"
                                                    ToolTip.Tip="{Binding Tooltip}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding ChartStartLabel}" Classes="faint"/>
                                <TextBlock Grid.Column="2" Text="{Binding ChartEndLabel}" Classes="faint"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Classes="panel" Padding="14" IsVisible="{Binding !HasServerHistory}">
                        <TextBlock Text="{DynamicResource Server_ChartEmpty}" Classes="faint"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding ServerMonitoringNote}" Classes="gold" TextWrapping="Wrap"
                               IsVisible="{Binding ServerMonitoringNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBlock Text="{Binding ServerStatsSource}" Classes="faint" TextWrapping="Wrap"
                               IsVisible="{Binding ServerStatsSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <TextBlock Text="{DynamicResource Server_MonitoringHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Community -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource Server_Community}" Classes="label"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="showtime.su" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Server_Open}" Command="{Binding OpenWebsiteCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="t.me/ShowTimeMc" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://t.me/ShowTimeMc"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="discord.gg/showtimes" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://discord.gg/showtimes"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>