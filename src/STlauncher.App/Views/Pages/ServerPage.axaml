<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             x:Class="STlauncher.App.Views.Pages.ServerPage"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="22" Spacing="14" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="{DynamicResource Nav_Server}" Classes="label"/>

            <!-- The server is part of the launcher, not a user setting -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="64" Height="64" CornerRadius="10" Background="#2A2028"
                                ClipToBounds="True">
                            <Image Source="{Binding ServerIcon}" Stretch="UniformToFill"
                                   Width="64" Height="64"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ServerName}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ServerAddress}" Classes="faint"/>
                            <TextBlock Text="{Binding ServerMotd}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ServerPlayers}" Classes="gold"/>
                        </StackPanel>

                        <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Top"
                                Content="{DynamicResource Server_Refresh}"
                                Command="{Binding RefreshServerStatusCommand}"
                                IsEnabled="{Binding !IsServerStatusBusy}"/>
                    </Grid>

                    <Button Classes="primary" Content="{DynamicResource Server_Join}"
                            Command="{Binding PlayOnServerCommand}" IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="44"/>

                    <Border Classes="hairline"/>
                    <TextBlock Text="{DynamicResource Server_PortHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Server_GlobalHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Monitoring -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <TextBlock Text="{DynamicResource Server_Monitoring}" Classes="label"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ServerAverage}" Classes="gold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ServerPeak}" Classes="faint"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="80" Classes="panel" Padding="8" IsVisible="{Binding HasServerHistory}">
                        <ItemsControl ItemsSource="{Binding ServerHistoryBars}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerHistoryBarView">
                                    <Panel>
                                        <Border Width="4" CornerRadius="2" VerticalAlignment="Bottom"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                Height="{Binding Height}" IsVisible="{Binding IsEmpty}"/>
                                        <Border Width="4" CornerRadius="2" VerticalAlignment="Bottom"
                                                Background="{DynamicResource AccentBrush}"
                                                Height="{Binding Height}" IsVisible="{Binding !IsEmpty}"
                                                ToolTip.Tip="{Binding Tooltip}"/>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{DynamicResource Server_MonitoringHint}" Classes="faint"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ServerMonitoringNote}" Classes="gold"
                               IsVisible="{Binding !HasServerHistory}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Community -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource Server_Community}" Classes="label"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="showtime.su" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Server_Open}" Command="{Binding OpenWebsiteCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="t.me/ShowTimeMc" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://t.me/ShowTimeMc"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="discord.gg/showtimes" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Server_Open}"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://discord.gg/showtimes"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>