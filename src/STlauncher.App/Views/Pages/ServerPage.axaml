<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:controls="using:STlauncher.App.Controls"
             x:Class="STlauncher.App.Views.Pages.ServerPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ======== Banner ======== -->
        <Border Grid.Row="0" Padding="40,28" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#3A1A25"/>
                    <GradientStop Offset="0.55" Color="#1A1119"/>
                    <GradientStop Offset="1" Color="#0F0C11"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" MaxWidth="1000">
                <Border Width="84" Height="84" CornerRadius="20" Background="{DynamicResource ElevatedBrush}"
                        ClipToBounds="True" BorderBrush="#14FFFFFF" BorderThickness="2">
                    <Image Source="{Binding ServerIcon}" Stretch="UniformToFill" Width="84" Height="84"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding ServerName}" Classes="h1" FontSize="32"/>
                        <Border Classes="tag" Background="#1E3A28" VerticalAlignment="Center" IsVisible="{Binding IsServerOnline}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Server_Online}" Foreground="#7DD39A"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="tag" VerticalAlignment="Center" IsVisible="{Binding !IsServerOnline}">
                            <TextBlock Text="{DynamicResource Server_OfflineTag}"/>
                        </Border>
                        <TextBlock Text="{Binding ServerVersion}" Classes="faint" VerticalAlignment="Center"
                                   IsVisible="{Binding IsServerOnline}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ServerAddress}" Classes="mono" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Classes="plain small" Command="{Binding CopyServerAddressCommand}"
                                ToolTip.Tip="{DynamicResource Server_CopyAddress}">
                            <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                        </Button>
                        <TextBlock Text="{Binding ServerMotd}" Classes="muted" FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="plain" Command="{Binding RefreshServerStatusCommand}"
                            IsEnabled="{Binding !IsServerStatusBusy}"
                            ToolTip.Tip="{DynamicResource Server_Refresh}">
                        <PathIcon Data="{StaticResource IconRefresh}"/>
                    </Button>
                    <Button Classes="primary" Height="46" Padding="22,0" CornerRadius="12"
                            Command="{Binding PlayOnServerCommand}" IsEnabled="{Binding !IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconPlay}"/>
                            <TextBlock Text="{DynamicResource Server_Join}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="40,20,40,28" Spacing="16" MaxWidth="1000">

                <!-- ======== Metrics ======== -->
                <UniformGrid Columns="5" ColumnSpacing="12">
                    <Border Classes="tile" Background="#1F1218">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Server_TileOnline}" Classes="label"/>
                            <TextBlock Text="{Binding ServerOnlineValue}" Classes="value" Foreground="{DynamicResource GoldBrush}"/>
                            <TextBlock Text="{Binding ServerOnlineCaption}" Classes="faint" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Server_TileAverageWeek}" Classes="label"/>
                            <TextBlock Text="{Binding ServerAverageWeekValue}" Classes="value"/>
                            <TextBlock Text="{DynamicResource Server_TilePlayers}" Classes="faint"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Server_TileRecord}" Classes="label"/>
                            <TextBlock Text="{Binding ServerRecordValue}" Classes="value"/>
                            <TextBlock Text="{Binding ServerRecordCaption}" Classes="faint"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Server_TileUptime}" Classes="label"/>
                            <TextBlock Text="{Binding ServerUptimeValue}" Classes="value"/>
                            <TextBlock Text="{DynamicResource Server_TileUptimeCaption}" Classes="faint"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="tile">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Server_TileRank}" Classes="label"/>
                            <TextBlock Text="{Binding ServerRankValue}" Classes="value"/>
                            <TextBlock Text="Top-Minecrafter" Classes="faint"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ======== Chart ======== -->
                <Border Classes="card" Padding="20,18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ChartTitle}" Classes="h3"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ServerAverage}" Classes="faint"/>
                                    <TextBlock Text="·" Classes="faint" IsVisible="{Binding ServerPeak, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding ServerPeak}" Classes="faint"/>
                                    <TextBlock Text="·" Classes="faint" IsVisible="{Binding ServerStatsSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding ServerStatsSource}" Classes="faint"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="panel" Padding="3" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="segment small" Classes.active="{Binding IsDayRange}"
                                            Content="{DynamicResource Server_RangeDay}"
                                            Command="{Binding SelectMonitoringRangeCommand}" CommandParameter="Day"/>
                                    <Button Classes="segment small" Classes.active="{Binding IsWeekRange}"
                                            Content="{DynamicResource Server_RangeWeek}"
                                            Command="{Binding SelectMonitoringRangeCommand}" CommandParameter="Week"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid RowDefinitions="170,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="6"
                              IsVisible="{Binding HasServerHistory}">
                            <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*,Auto" MinWidth="28">
                                <TextBlock Grid.Row="0" Text="{Binding ChartTopLabel}" Classes="faint" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="0" Classes="faint" HorizontalAlignment="Right"/>
                            </Grid>

                            <controls:OnlineChart Grid.Row="0" Grid.Column="1" Bars="{Binding ServerChartBars}"/>

                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding ChartStartLabel}" Classes="faint"/>
                                <TextBlock Grid.Column="2" Text="{Binding ChartEndLabel}" Classes="faint"/>
                            </Grid>
                        </Grid>

                        <Border Classes="panel" Padding="24" IsVisible="{Binding !HasServerHistory}">
                            <TextBlock Text="{DynamicResource Server_ChartEmpty}" Classes="muted"
                                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding ServerMonitoringNote}" Classes="gold" TextWrapping="Wrap"
                                   IsVisible="{Binding ServerMonitoringNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <!-- ======== Community ======== -->
                <UniformGrid Columns="3" ColumnSpacing="12">
                    <Button Classes="link-tile" Command="{Binding OpenWebsiteCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource ElevatedBrush}">
                                <PathIcon Data="{StaticResource IconGlobe}" Classes="gold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Server_Site}" FontWeight="SemiBold"/>
                                <TextBlock Text="showtime.su" Classes="faint"/>
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconOpenExternal}" Classes="small muted" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="link-tile" Command="{Binding OpenUrlCommand}" CommandParameter="https://t.me/ShowTimeMc">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource ElevatedBrush}">
                                <PathIcon Data="{StaticResource IconSend}" Classes="gold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Telegram" FontWeight="SemiBold"/>
                                <TextBlock Text="t.me/ShowTimeMc" Classes="faint"/>
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconOpenExternal}" Classes="small muted" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="link-tile" Command="{Binding OpenUrlCommand}" CommandParameter="https://discord.gg/showtimes">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource ElevatedBrush}">
                                <PathIcon Data="{StaticResource IconChat}" Classes="gold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Discord" FontWeight="SemiBold"/>
                                <TextBlock Text="discord.gg/showtimes" Classes="faint"/>
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconOpenExternal}" Classes="small muted" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
