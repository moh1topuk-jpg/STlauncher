<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:m="using:STlauncher.Core.Metadata"
             xmlns:loaders="using:STlauncher.Core.Loaders"
             xmlns:mods="using:STlauncher.Core.Mods"
             xmlns:content="using:STlauncher.Core.Content"
             xmlns:conv="using:STlauncher.App.Converters"
             xmlns:controls="using:STlauncher.App.Controls"
             xmlns:sys="using:System"
             x:Class="STlauncher.App.Views.Pages.BuildsPage"
             x:DataType="vm:MainWindowViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Resources>
        <!-- One mod of the build. The list shows two of these on a line and creates only
             the lines on screen, so the card lives here and the line template places it. -->
        <DataTemplate x:Key="InstalledModCard" x:DataType="vm:InstalledModItem">
            <Border Classes="mod-line" Classes.off="{Binding !Enabled}" Classes.new="{Binding IsNew}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                              IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsModSelectMode}"/>
                    <!-- The mod's own icon from inside the jar; a cube until it is read, or when there is none. -->
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="11" ClipToBounds="True"
                            Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                        <Panel>
                            <PathIcon Data="{StaticResource IconBuilds}" Classes="muted" IsVisible="{Binding !HasIcon}"/>
                            <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="UniformToFill"/>
                        </Panel>
                    </Border>
                    <!-- Title on top, its version and size under it. A grid, not a stack:
                         a stack never limits the name, so a long one ran under the buttons. -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                            <Border Classes="tag" IsVisible="{Binding IsCatalog}" Margin="0,0,7,0"
                                    ToolTip.Tip="{DynamicResource Mods_CatalogPinnedHint}">
                                <TextBlock Text="{DynamicResource Builds_TagCatalog}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding MetaLine}" Classes="faint"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <!-- A newer version exists; the button is the whole offer. -->
                    <Button Grid.Column="3" Classes="small" IsVisible="{Binding HasUpdate}"
                            Foreground="{DynamicResource GoldBrush}"
                            ToolTip.Tip="{DynamicResource Mods_UpdateOne}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UpdateModCommand}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="{Binding UpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                    </Button>
                    <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="40" Height="3"
                                 VerticalAlignment="Center" IsVisible="{Binding IsUpdating}"/>
                    <!-- The switch shows the state and changes it:
                         one button labelled "On/Off" did neither. -->
                    <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled, Mode=OneWay}"
                                  OnContent="" OffContent=""
                                  MinWidth="0" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleModCommand}"
                                  CommandParameter="{Binding}"/>
                    <Button Grid.Column="5" Classes="plain small icon-danger"
                            ToolTip.Tip="{DynamicResource Mods_Delete}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UninstallModCommand}"
                            CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One resource pack. The switched-on and the switched-off lists show the same row;
             a pack that is off is not dimmed, its list's heading already says so. -->
        <DataTemplate x:Key="ResourcePackCard" x:DataType="vm:ResourcePackItem">
            <Border Classes="mod-line" Classes.selected="{Binding IsSelected}"
                    Cursor="Hand" PointerPressed="OnPackRowPressed">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Border Width="44" Height="44" CornerRadius="11" ClipToBounds="True"
                            Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                        <Panel>
                            <PathIcon Data="{StaticResource IconPalette}" Classes="muted"
                                      IsVisible="{Binding !HasPreview}"/>
                            <Image Source="{Binding Preview}" Stretch="UniformToFill" Width="44" Height="44"
                                   IsVisible="{Binding HasPreview}"/>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding FileName}"/>
                        <TextBlock Text="{Binding Description}" Classes="faint" FontSize="12"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}"/>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="2">
                            <TextBlock Classes="faint" FontSize="12" Text="{Binding CompatibilityLabel}"
                                       IsVisible="{Binding IsFit}"/>
                            <TextBlock Classes="gold" FontSize="12" Text="{Binding CompatibilityLabel}"
                                       IsVisible="{Binding Mismatch}"/>
                            <TextBlock Classes="faint" FontSize="12"
                                       Text="{Binding Size, Converter={x:Static conv:FileSizeConverter.Instance}}"/>
                            <Border Classes="tag" IsVisible="{Binding IsCatalog}"
                                    ToolTip.Tip="{DynamicResource Mods_CatalogPinnedHint}">
                                <TextBlock Text="{DynamicResource Builds_TagCatalog}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <!-- A newer version exists; the button is the whole offer. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Classes="small" IsVisible="{Binding HasUpdate}" Foreground="{DynamicResource GoldBrush}"
                                ToolTip.Tip="{DynamicResource Packs_UpdateOne}" Margin="0,0,6,0"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UpdateResourcePackCommand}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding UpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Width="40" Height="3" VerticalAlignment="Center"
                                     IsVisible="{Binding IsUpdating}" Margin="0,0,6,0"/>
                        <!-- Order arrows exist only on enabled packs: order is meaningless when off. -->
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                                    IsVisible="{Binding IsEnabled}">
                            <Button Classes="plain small" ToolTip.Tip="{DynamicResource Packs_MoveUp}"
                                    IsEnabled="{Binding !IsFirst}"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoveResourcePackUpCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IconArrowUp}" Classes="small"/>
                            </Button>
                            <Button Classes="plain small" ToolTip.Tip="{DynamicResource Packs_MoveDown}"
                                    IsEnabled="{Binding !IsLast}"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).MoveResourcePackDownCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource IconArrowDown}" Classes="small"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                  OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                  IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanEditPacks}"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleResourcePackCommand}"
                                  CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The same warm light as on the home screen, standing still: nothing on this page moves. -->
        <Border IsHitTestVisible="False" Background="{DynamicResource HomeGlowBrush}"/>

        <Grid Margin="22,20,22,18" ColumnDefinitions="256,*" ColumnSpacing="18">

            <!-- ============ Build list ============ -->
            <!-- Only the list and the ways to add to it. Everything that acts on one build
                 lives next to that build, on the right. -->
            <Border Classes="card glass" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,2,0,0">
                        <TextBlock Text="{DynamicResource Builds_Title}" Classes="h2"
                                   VerticalAlignment="Center"/>

                        <!-- Every way a build comes into existence, in one menu. -->
                        <Button Grid.Column="1" Classes="primary small" CornerRadius="10"
                                Content="{DynamicResource Builds_Add}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{DynamicResource Builds_AddNew}"
                                              Command="{Binding OpenNewBuildCommand}"/>
                                    <!-- The entries live in a popup, out of reach of a
                                         $parent binding, so the click is handled in code. -->
                                    <MenuItem Classes="catalog-root"
                                              Header="{DynamicResource Builds_AddFromCatalog}"
                                              ItemsSource="{Binding CatalogBuilds}"
                                              Click="OnCatalogBuildClick">
                                        <MenuItem.Styles>
                                            <Style Selector="MenuItem:not(.catalog-root)" x:DataType="content:CatalogBuild">
                                                <Setter Property="Header" Value="{Binding Name}"/>
                                            </Style>
                                        </MenuItem.Styles>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Builds_FromCode}"
                                              Command="{Binding AddBuildFromCodeCommand}"/>
                                    <MenuItem Header="{DynamicResource Import_Open}"
                                              Command="{Binding OpenImportCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource Builds_AddCopy}"
                                              Command="{Binding DuplicateInstanceCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding BuildFilter}"
                             Watermark="{DynamicResource Builds_SearchHint}"/>

                    <ListBox Grid.Row="2" Classes="builds" ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding SelectedInstance}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="inst:Instance">
                                <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="9">
                                    <Border Classes="selection-bar" CornerRadius="2" VerticalAlignment="Stretch"/>
                                    <!-- A colour of its own, so a build is found by eye before its name is read. -->
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center"
                                            Background="{Binding Id, Converter={x:Static conv:TintBrushConverter.Instance}}">
                                        <PathIcon Data="{StaticResource IconBuilds}" Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" Spacing="3" Margin="0,9,10,9">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Separate TextBlocks rather than a MultiBinding: a
                                             {DynamicResource} used as a MultiBinding source
                                             binds to the markup extension object itself, and
                                             the row printed its type name to the user. -->
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Classes="faint" FontSize="11.5" Text="{Binding VersionId, TargetNullValue=—}"/>
                                            <TextBlock Classes="faint" FontSize="11.5" Text="·"/>
                                            <TextBlock Classes="faint" FontSize="11.5" Text="{Binding Loader}"/>
                                            <TextBlock Classes="faint" FontSize="11.5" Text="·"/>
                                            <TextBlock Classes="faint" FontSize="11.5"
                                                       Text="{Binding ModCount, Converter={x:Static conv:ModCountConverter.Instance}}"/>
                                        </StackPanel>

                                        <!-- Where the build came from, at a glance. -->
                                        <WrapPanel>
                                            <Border Classes="tag accent" Margin="0,0,6,0"
                                                    IsVisible="{Binding CatalogBuildId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{DynamicResource Builds_TagCatalog}"/>
                                            </Border>
                                            <Border Classes="tag" Margin="0,0,6,0"
                                                    IsVisible="{Binding ExternalGameDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{DynamicResource Builds_TagLinked}"/>
                                            </Border>
                                            <Border Classes="tag" Margin="0,0,6,0"
                                                    IsVisible="{Binding ProfileVersionId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{DynamicResource Builds_TagImported}"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Spacing="8">
                        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBuildImportBusy}"/>

                        <!-- The offer, when the startup scan found something to bring over. -->
                        <Border Classes="panel" Padding="12" CornerRadius="12" IsVisible="{Binding HasImportSuggestion}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ImportSuggestionText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Button Classes="primary small" HorizontalAlignment="Stretch"
                                            Content="{DynamicResource Import_SuggestAccept}"
                                            Command="{Binding AcceptImportSuggestionCommand}"/>
                                    <Button Grid.Column="1" Classes="plain small"
                                            Command="{Binding DismissImportSuggestionCommand}"
                                            ToolTip.Tip="{DynamicResource Import_SuggestDismiss}">
                                        <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Always here, quietly: the menu alone was not found by everyone. -->
                        <Button Classes="ghost small" HorizontalAlignment="Stretch" CornerRadius="10"
                                Command="{Binding AddBuildFromCodeCommand}"
                                ToolTip.Tip="{DynamicResource Builds_FromCode}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                                <TextBlock Text="{DynamicResource Builds_FromCodeShort}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost small" HorizontalAlignment="Stretch" CornerRadius="10"
                                Command="{Binding OpenImportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconDownload}" Classes="small"/>
                                <TextBlock Text="{DynamicResource Import_Open}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Build editor ============ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12" MaxWidth="1100"
                  HorizontalAlignment="Stretch">

                <!-- The build that is open: what it is, and the way into the game. The layers
                     are plain fills with their own corners, as on the home card: no clip. -->
                <Border Classes="hero-card" CornerRadius="22">
                    <Panel>
                        <Border IsHitTestVisible="False" CornerRadius="21" Background="{DynamicResource HeroGlowBrush}"/>
                        <controls:Mosaic IsHitTestVisible="False" CornerRadius="21" Fill="{DynamicResource MosaicBrush}"/>

                        <Grid Margin="18,15" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Width="56" Height="56" CornerRadius="16" VerticalAlignment="Center"
                                    Background="{Binding SelectedInstance.Id, Converter={x:Static conv:TintBrushConverter.Instance}}">
                                <PathIcon Data="{StaticResource IconBuilds}" Width="26" Height="26"
                                          Foreground="{DynamicResource TextOnAccentBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedInstance.Name}" Classes="h1" FontSize="24"
                                           TextTrimming="CharacterEllipsis"/>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding SelectedInstance.VersionId, TargetNullValue=—}"/>
                                    </Border>
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding SelectedInstance.Loader}"/>
                                    </Border>
                                    <Border Classes="chip">
                                        <TextBlock Classes="gold" Text="{Binding BuildModCountLabel}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource SuccessBrush}" IsVisible="{Binding !IsBuildSyncBusy}"/>
                                        <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource GoldBrush}" IsVisible="{Binding IsBuildSyncBusy}"/>
                                        <TextBlock Text="{Binding BuildStateLabel}" Classes="muted" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- The build's own settings open beside the page, not instead of it. -->
                                <Button Classes="glass-icon" Command="{Binding OpenBuildSettingsCommand}"
                                        ToolTip.Tip="{DynamicResource Builds_TabSettings}">
                                    <PathIcon Data="{StaticResource IconSettings}"/>
                                </Button>
                                <!-- The build as one line of text for a friend. -->
                                <Button Classes="glass-icon" Command="{Binding CopyBuildCodeCommand}"
                                        ToolTip.Tip="{DynamicResource Builds_ShareHint}">
                                    <PathIcon Data="{StaticResource IconShare}"/>
                                </Button>
                                <!-- The rare actions, out of the way but one click deep. -->
                                <Button Classes="glass-icon" ToolTip.Tip="{DynamicResource Builds_More}">
                                    <PathIcon Data="{StaticResource IconDots}"/>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{DynamicResource Builds_SyncWithCatalog}"
                                                      Command="{Binding SyncSelectedBuildCommand}"
                                                      IsVisible="{Binding IsCatalogInstance}"/>
                                            <MenuItem Header="{DynamicResource Builds_Repair}"
                                                      Command="{Binding RepairBuildCommand}"
                                                      IsEnabled="{Binding CanRepairBuild}"/>
                                            <MenuItem Header="{DynamicResource Builds_OpenFolder}"
                                                      Command="{Binding OpenGameFolderCommand}"/>
                                            <MenuItem Header="{DynamicResource Builds_AddCopy}"
                                                      Command="{Binding DuplicateInstanceCommand}"/>
                                            <MenuItem Header="{DynamicResource Builds_Export}" Click="OnExportModpackClick"/>
                                            <MenuItem Header="{DynamicResource Builds_CopyCode}"
                                                      Command="{Binding CopyBuildCodeCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource Game_DeleteInstance}"
                                                      Command="{Binding DeleteInstanceCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <!-- Starting from here saves the trip back to the main screen. -->
                                <Button Classes="play" Command="{Binding PlayCommand}" IsEnabled="{Binding !IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <PathIcon Data="{StaticResource IconPlay}"/>
                                        <TextBlock Text="{DynamicResource Game_Play}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Panel>
                </Border>

                <!-- What the build holds, tab by tab; the catalog is the last of them. Where the
                     catalog looks sits beside the tabs, and only once there is a second place
                     to look. A wrap panel: in a narrow window the switch drops under the tabs. -->
                <WrapPanel Grid.Row="1" ItemSpacing="12" LineSpacing="8">
                    <Border Classes="segments">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="segment" Classes.active="{Binding IsBuildMods}"
                                    Content="{Binding ModsTabLabel}"
                                    Command="{Binding SelectBuildTabCommand}" CommandParameter="Mods"/>
                            <Button Classes="segment" Classes.active="{Binding IsBuildResourcePacks}"
                                    Content="{Binding ResourcePacksTabLabel}"
                                    Command="{Binding SelectBuildTabCommand}" CommandParameter="ResourcePacks"/>
                            <Button Classes="segment" Classes.active="{Binding IsBuildShaders}"
                                    Content="{Binding ShadersTabLabel}"
                                    Command="{Binding SelectBuildTabCommand}" CommandParameter="Shaders"/>
                            <Button Classes="segment" Classes.active="{Binding IsBuildScreenshots}"
                                    Content="{Binding ScreenshotsTabLabel}"
                                    Command="{Binding SelectBuildTabCommand}" CommandParameter="Screenshots"/>
                            <Button Classes="segment" Classes.active="{Binding IsBuildCatalog}"
                                    Command="{Binding SelectBuildTabCommand}" CommandParameter="Catalog">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconSearch}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Builds_TabAddMods}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Panel IsVisible="{Binding IsBuildCatalog}">
                        <Border Classes="segments" IsVisible="{Binding IsCurseForgeAvailable}"
                                ToolTip.Tip="{DynamicResource Catalog_SourceHint}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="segment" Classes.active="{Binding IsSourceAll}"
                                        Content="{DynamicResource Catalog_SourceAll}"
                                        Command="{Binding SelectBrowserSourceCommand}" CommandParameter="All"/>
                                <Button Classes="segment" Classes.active="{Binding IsSourceModrinth}"
                                        Content="Modrinth"
                                        Command="{Binding SelectBrowserSourceCommand}" CommandParameter="Modrinth"/>
                                <Button Classes="segment" Classes.active="{Binding IsSourceCurseForge}"
                                        Content="CurseForge"
                                        Command="{Binding SelectBrowserSourceCommand}" CommandParameter="CurseForge"/>
                            </StackPanel>
                        </Border>
                    </Panel>
                </WrapPanel>

                <Panel Grid.Row="2">

                    <!-- ======== Mods of the build ======== -->
                    <Grid IsVisible="{Binding IsBuildMods}" RowDefinitions="Auto,Auto,*" RowSpacing="10" controls:Reveal.OnVisible="True">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <!-- Search on the left, the actions on the right; the slices wrap on their own row below. -->
                            <Border Classes="field" MaxWidth="360" HorizontalAlignment="Left">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <PathIcon Data="{StaticResource IconSearch}" Classes="small muted" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Classes="bare" Text="{Binding ModsFilter}"
                                             Watermark="{DynamicResource Mods_FilterPlaceholder}"/>
                                </Grid>
                            </Border>
                            <!-- Several mods at once: cards grow a tick box and a bar of actions appears. -->
                            <Button Grid.Column="1" Classes="ghost small" Classes.active="{Binding IsModSelectMode}"
                                    Content="{DynamicResource Mods_Select}"
                                    Command="{Binding ToggleModSelectModeCommand}"/>
                            <!-- Adding lives where the mods are, and opens the catalog on mods. -->
                            <Button Grid.Column="2" Classes="primary small" CornerRadius="10"
                                    Command="{Binding OpenCatalogForModsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconPlus}" Classes="small"/>
                                    <TextBlock Text="{DynamicResource Mods_AddButton}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Classes="ghost small" ToolTip.Tip="{DynamicResource Builds_More}" MinWidth="36">
                                <PathIcon Data="{StaticResource IconDots}" Classes="small"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <!-- Updates are shown, never applied on their own: the player
                                             decides, mod by mod or all at once. -->
                                        <MenuItem Header="{DynamicResource Mods_CheckUpdates}"
                                                  Command="{Binding CheckModUpdatesCommand}"/>
                                        <MenuItem Header="{Binding UpdateAllLabel}"
                                                  Command="{Binding UpdateAllModsCommand}" IsVisible="{Binding HasModUpdates}"/>
                                        <MenuItem Header="{DynamicResource Mods_DisableOwn}"
                                                  Command="{Binding DisableOwnModsCommand}" IsVisible="{Binding HasOwnModsEnabled}"/>
                                        <MenuItem Header="{DynamicResource Mods_EnableOwn}"
                                                  Command="{Binding EnableOwnModsCommand}" IsVisible="{Binding HasOwnModsDisabled}"/>
                                        <MenuItem Header="{DynamicResource Mods_Import}" Click="OnImportModpackClick"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Mods_OpenFolder}"
                                                  Command="{Binding OpenModsFolderCommand}"/>
                                        <MenuItem Header="{DynamicResource Mods_Refresh}"
                                                  Command="{Binding RefreshModsCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!-- Everything between the toolbar and the list in one stack: what is not
                             on screen takes no room there, where empty grid rows each left a gap. -->
                        <StackPanel Grid.Row="1" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <WrapPanel ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                    <Button Classes="chip" Classes.active="{Binding IsScopeAll}"
                                            Command="{Binding SelectModsScopeCommand}" CommandParameter="All">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{DynamicResource Mods_ScopeAll}"/>
                                            <TextBlock Text="{Binding ModsCountAll}" Opacity="0.7"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="chip" Classes.active="{Binding IsScopeCatalog}"
                                            Command="{Binding SelectModsScopeCommand}" CommandParameter="Catalog">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{DynamicResource Mods_ScopeCatalog}"/>
                                            <TextBlock Text="{Binding ModsCountCatalog}" Opacity="0.7"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="chip" Classes.active="{Binding IsScopeOwn}"
                                            Command="{Binding SelectModsScopeCommand}" CommandParameter="Own">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{DynamicResource Mods_ScopeOwn}"/>
                                            <TextBlock Text="{Binding ModsCountOwn}" Opacity="0.7"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="chip" Classes.active="{Binding IsScopeDisabled}"
                                            Command="{Binding SelectModsScopeCommand}" CommandParameter="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{DynamicResource Mods_ScopeDisabled}"/>
                                            <TextBlock Text="{Binding ModsCountDisabled}" Opacity="0.7"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <!-- The order of the list, remembered between starts. -->
                                <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding ModsSortLabel}"/>
                                        <PathIcon Data="{StaticResource IconChevronDown}" Classes="small"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{DynamicResource Mods_SortDefault}"
                                                      Command="{Binding SelectModsSortCommand}" CommandParameter="Default"/>
                                            <MenuItem Header="{DynamicResource Mods_SortName}"
                                                      Command="{Binding SelectModsSortCommand}" CommandParameter="Name"/>
                                            <MenuItem Header="{DynamicResource Mods_SortSize}"
                                                      Command="{Binding SelectModsSortCommand}" CommandParameter="Size"/>
                                            <MenuItem Header="{DynamicResource Mods_SortAdded}"
                                                      Command="{Binding SelectModsSortCommand}" CommandParameter="Added"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- What to do with the ticked mods. Deleting asks twice. -->
                            <Border Classes="panel glass" CornerRadius="14" Padding="12,8" IsVisible="{Binding IsModSelectMode}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <TextBlock Text="{Binding SelectedModsLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Right">
                                        <Button Classes="ghost small" Content="{DynamicResource Mods_SelectVisible}"
                                                Command="{Binding SelectVisibleModsCommand}"/>
                                        <Button Classes="ghost small" Content="{DynamicResource Mods_BulkEnable}"
                                                Command="{Binding EnableSelectedModsCommand}" IsEnabled="{Binding HasSelectedMods}"/>
                                        <Button Classes="ghost small" Content="{DynamicResource Mods_BulkDisable}"
                                                Command="{Binding DisableSelectedModsCommand}" IsEnabled="{Binding HasSelectedMods}"/>
                                        <Button Classes="ghost small" Content="{Binding BulkDeleteLabel}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DeleteSelectedModsCommand}" IsEnabled="{Binding HasSelectedMods}"/>
                                        <Button Classes="plain small" Content="{DynamicResource Common_Done}"
                                                Command="{Binding ToggleModSelectModeCommand}"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- The pre-launch check, in full. -->
                            <Border Classes="panel glass" CornerRadius="14" Padding="14,10" IsVisible="{Binding HasBuildIssues}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding BuildCheckSummary}" Classes="gold" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding BuildIssues}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BuildIssueItem">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Title}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="ghost small" Content="{Binding FixLabel}" VerticalAlignment="Center"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyBuildFixCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2" Classes="ghost small" Content="{Binding AltFixLabel}" VerticalAlignment="Center"
                                                            IsVisible="{Binding HasAltFix}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyBuildAltFixCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel>
                                        <Button Classes="primary small" Margin="0,0,8,0" IsVisible="{Binding HasBulkBuildFix}"
                                                Content="{DynamicResource Check_FixAll}" Command="{Binding ApplyAllBuildFixesCommand}"/>
                                        <Button Classes="ghost small" IsVisible="{Binding HasBulkKeepOld}"
                                                Content="{DynamicResource Check_KeepOld}" Command="{Binding KeepOlderVersionsCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- The verdict of the last check. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                  IsVisible="{Binding ModUpdatesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center"
                                             IsVisible="{Binding IsCheckingModUpdates}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ModUpdatesSummary}" Classes="gold" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Panel Grid.Row="2">
                            <Border Classes="panel glass" Padding="20" VerticalAlignment="Top"
                                    IsVisible="{Binding HasNoInstalledMods}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{DynamicResource Mods_Empty}" Classes="muted" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <Button Classes="primary small" HorizontalAlignment="Left" CornerRadius="10"
                                            Content="{DynamicResource Mods_GoCatalog}"
                                            Command="{Binding OpenCatalogForModsCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- The build has mods; the search or the slice left none of them. -->
                            <Border Classes="panel glass" Padding="20" VerticalAlignment="Top"
                                    IsVisible="{Binding HasNoShownMods}">
                                <TextBlock Text="{DynamicResource Mods_NothingShown}" Classes="muted" FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Hidden while empty: an empty list still catches clicks meant for the panel above. -->
                            <ScrollViewer Name="ModsScroll" IsVisible="{Binding !HasNoInstalledMods}" SizeChanged="OnModsSizeChanged">
                                <!-- Lines of one or two cards, and only the lines on screen exist: a
                                     build of two hundred mods costs what a build of twelve does. -->
                                <ItemsControl Name="ModsItems" ItemsSource="{Binding ModRows}" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModRow">
                                            <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,8">
                                                <ContentControl Grid.ColumnSpan="{Binding LeftSpan}" Content="{Binding Left}"
                                                                ContentTemplate="{StaticResource InstalledModCard}"/>
                                                <ContentControl Grid.Column="2" Content="{Binding Right}" IsVisible="{Binding HasRight}"
                                                                ContentTemplate="{StaticResource InstalledModCard}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Panel>
                    </Grid>

                    <!-- ======== Resource packs of the build ======== -->
                    <Grid IsVisible="{Binding IsBuildResourcePacks}" RowDefinitions="Auto,*" RowSpacing="10" controls:Reveal.OnVisible="True">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{DynamicResource Packs_Hint}" Classes="faint" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Top"
                                        Command="{Binding CheckPackUpdatesCommand}" IsEnabled="{Binding !IsCheckingPackUpdates}"
                                        ToolTip.Tip="{DynamicResource Packs_CheckUpdatesHint}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconUpdate}" Classes="small"/>
                                        <TextBlock Text="{DynamicResource Mods_CheckUpdates}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Top"
                                        Content="{DynamicResource Packs_OpenFolder}"
                                        Command="{Binding OpenResourcePacksFolderCommand}"/>
                                <Button Grid.Column="3" Classes="primary small" CornerRadius="10" VerticalAlignment="Top"
                                        Command="{Binding AddResourcePacksCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconPlus}" Classes="small"/>
                                        <TextBlock Text="{DynamicResource Packs_FromCatalog}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                  IsVisible="{Binding PackUpdatesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" IsVisible="{Binding IsCheckingPackUpdates}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PackUpdatesSummary}" Classes="gold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="1" Classes="panel glass" Padding="20" VerticalAlignment="Top"
                                IsVisible="{Binding HasNoResourcePacks}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource Packs_Empty}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                                <Button Classes="primary small" HorizontalAlignment="Left" CornerRadius="10"
                                        Content="{DynamicResource Packs_FromCatalog}"
                                        Command="{Binding AddResourcePacksCommand}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="12" IsVisible="{Binding !HasNoResourcePacks}">
                            <ScrollViewer>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding EnabledPacksHeader}" Classes="faint" FontSize="12" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding EnabledResourcePacks}"
                                                  ItemTemplate="{StaticResource ResourcePackCard}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding DisabledPacksHeader}" Classes="faint" FontSize="12" FontWeight="SemiBold"
                                               Margin="0,8,0,0" IsVisible="{Binding HasDisabledResourcePacks}"/>
                                    <ItemsControl ItemsSource="{Binding DisabledResourcePacks}"
                                                  ItemTemplate="{StaticResource ResourcePackCard}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Details of the selected pack: what the pack says about itself. -->
                            <Border Grid.Column="1" Classes="card glass" Padding="16" VerticalAlignment="Top">
                                <Panel>
                                    <TextBlock Text="{DynamicResource Packs_Pick}" Classes="faint" TextWrapping="Wrap"
                                               IsVisible="{Binding HasNoSelectedResourcePack}"/>
                                    <StackPanel Spacing="12" DataContext="{Binding SelectedResourcePack}"
                                                IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
                                                x:DataType="vm:ResourcePackItem">
                                        <Border Height="150" CornerRadius="12" ClipToBounds="True"
                                                Background="{DynamicResource ElevatedBrush}">
                                            <Panel>
                                                <PathIcon Data="{StaticResource IconPalette}" Classes="muted" Width="36" Height="36"
                                                          IsVisible="{Binding !HasPreview}"/>
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" IsVisible="{Binding HasPreview}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" Classes="h3" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StateLabel}" Classes="faint" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{DynamicResource Packs_DescriptionFrom}" Classes="faint" FontSize="11"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                                            <TextBlock Text="{DynamicResource Packs_NoDescription}" Classes="faint" TextWrapping="Wrap"
                                                       IsVisible="{Binding !HasDescription}"/>
                                        </StackPanel>
                                        <Border Classes="hairline"/>
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                            <TextBlock Text="{DynamicResource Packs_Format}" Classes="faint"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding FormatLabel}"/>
                                                <TextBlock Text="{Binding CompatibilityLabel}" Classes="faint" IsVisible="{Binding IsFit}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CompatibilityLabel}" Classes="gold" IsVisible="{Binding Mismatch}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Packs_Size}" Classes="faint"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding Size, Converter={x:Static conv:FileSizeConverter.Instance}}"/>
                                            <TextBlock Grid.Row="2" Text="{DynamicResource Packs_Source}" Classes="faint"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceLabel}" TextWrapping="Wrap"/>
                                        </Grid>
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Button Classes="primary small" IsVisible="{Binding HasUpdate}"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UpdateResourcePackCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding UpdateLabel}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentBrush}"/>
                                            </Button>
                                            <Button Classes="ghost small" Content="{DynamicResource Packs_OnModrinth}"
                                                    IsVisible="{Binding HasModrinthPage}"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenResourcePackOnModrinthCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="ghost small" Content="{DynamicResource Packs_Delete}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanEditPacks}"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteResourcePackCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ======== Shaders of the build ======== -->
                    <Grid IsVisible="{Binding IsBuildShaders}" RowDefinitions="Auto,*" RowSpacing="10" controls:Reveal.OnVisible="True">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{DynamicResource Shaders_Hint}" Classes="faint" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Top"
                                        Command="{Binding CheckPackUpdatesCommand}" IsEnabled="{Binding !IsCheckingPackUpdates}"
                                        ToolTip.Tip="{DynamicResource Packs_CheckUpdatesHint}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconUpdate}" Classes="small"/>
                                        <TextBlock Text="{DynamicResource Mods_CheckUpdates}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Top"
                                        Content="{DynamicResource Shaders_OpenFolder}"
                                        Command="{Binding OpenShaderPacksFolderCommand}"/>
                                <Button Grid.Column="3" Classes="primary small" CornerRadius="10" VerticalAlignment="Top"
                                        Command="{Binding AddShadersCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconPlus}" Classes="small"/>
                                        <TextBlock Text="{DynamicResource Shaders_FromCatalog}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                  IsVisible="{Binding PackUpdatesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" IsVisible="{Binding IsCheckingPackUpdates}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PackUpdatesSummary}" Classes="gold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Shaders without Iris or Oculus are files in a folder; say so once, up top. -->
                            <Border Classes="panel glass" CornerRadius="14" Padding="14,12" IsVisible="{Binding !HasShaderLoader}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <PathIcon Data="{StaticResource IconWarning}" Classes="small" Foreground="{DynamicResource GoldBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ShaderLoaderMissingText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Classes="ghost small" Content="{Binding FindShaderLoaderLabel}"
                                            Command="{Binding FindShaderLoaderCommand}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Classes="panel glass" Padding="20" VerticalAlignment="Top"
                                IsVisible="{Binding HasNoShaderPacks}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource Shaders_Empty}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                                <Button Classes="primary small" HorizontalAlignment="Left" CornerRadius="10"
                                        Content="{DynamicResource Shaders_FromCatalog}"
                                        Command="{Binding AddShadersCommand}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" IsVisible="{Binding !HasNoShaderPacks}">
                            <StackPanel Spacing="8">
                                <!-- "No shaders" is a row like the others, so the choice reads as one list. -->
                                <Border Classes="mod-line" Classes.selected="{Binding NoShaderActive}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ElevatedBrush}">
                                            <PathIcon Data="{StaticResource IconClose}" Classes="muted"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{DynamicResource Shaders_None}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource Shaders_NoneHint}" Classes="faint" FontSize="12"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="tag accent" VerticalAlignment="Center" IsVisible="{Binding NoShaderActive}">
                                            <TextBlock Text="{DynamicResource Shaders_Active}"/>
                                        </Border>
                                        <Button Grid.Column="2" Classes="ghost small" Content="{DynamicResource Shaders_Activate}"
                                                IsVisible="{Binding !NoShaderActive}" IsEnabled="{Binding CanEditPacks}"
                                                Command="{Binding DisableShadersCommand}"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ShaderPacks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ShaderPackItem">
                                            <Border Classes="mod-line" Classes.selected="{Binding IsActive}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource ElevatedBrush}">
                                                        <PathIcon Data="{StaticResource IconStar}" Classes="muted"/>
                                                    </Border>
                                                    <Button Grid.Column="2" Classes="small" IsVisible="{Binding HasUpdate}" Foreground="{DynamicResource GoldBrush}"
                                                            ToolTip.Tip="{DynamicResource Packs_UpdateOne}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UpdateShaderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding UpdateLabel}" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}"/>
                                                    </Button>
                                                    <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="40" Height="3" VerticalAlignment="Center" IsVisible="{Binding IsUpdating}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Classes="faint" FontSize="12"
                                                                       Text="{Binding Size, Converter={x:Static conv:FileSizeConverter.Instance}}"/>
                                                            <Border Classes="tag" IsVisible="{Binding IsCatalog}"
                                                                    ToolTip.Tip="{DynamicResource Mods_CatalogPinnedHint}">
                                                                <TextBlock Text="{DynamicResource Builds_TagCatalog}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="3" Classes="tag accent" VerticalAlignment="Center" IsVisible="{Binding IsActive}">
                                                        <TextBlock Text="{DynamicResource Shaders_Active}"/>
                                                    </Border>
                                                    <Button Grid.Column="3" Classes="ghost small" Content="{DynamicResource Shaders_Activate}"
                                                            IsVisible="{Binding IsNotActive}"
                                                            IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanEditPacks}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ActivateShaderCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="4" Classes="plain small" IsVisible="{Binding HasModrinthPage}"
                                                            ToolTip.Tip="{DynamicResource Packs_OnModrinth}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenShaderOnModrinthCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource IconOpenExternal}" Classes="small"/>
                                                    </Button>
                                                    <Button Grid.Column="5" Classes="plain small icon-danger"
                                                            ToolTip.Tip="{DynamicResource Shaders_Delete}"
                                                            IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanEditPacks}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteShaderCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======== Screenshots of the build ======== -->
                    <Grid IsVisible="{Binding IsBuildScreenshots}" RowDefinitions="Auto,*" RowSpacing="10" controls:Reveal.OnVisible="True">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Text="{DynamicResource Shots_Hint}" Classes="faint" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Top"
                                    Content="{DynamicResource Shots_OpenFolder}" Command="{Binding OpenScreenshotsFolderCommand}"/>
                        </Grid>

                        <Border Grid.Row="1" Classes="panel glass" Padding="20" VerticalAlignment="Top" IsVisible="{Binding HasNoScreenshots}">
                            <TextBlock Text="{DynamicResource Shots_Empty}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" IsVisible="{Binding !HasNoScreenshots}">
                            <ItemsControl ItemsSource="{Binding Screenshots}" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScreenshotItem">
                                        <Border Classes="mod-line" Width="236" ClipToBounds="True" Padding="0">
                                            <StackPanel>
                                                <!-- The picture is the button: a click opens it full size. -->
                                                <Button Classes="plain" Padding="0" CornerRadius="0" Cursor="Hand"
                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenScreenshotCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Width="236" Height="133" Background="{DynamicResource ElevatedBrush}" ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Button>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" Margin="10,6,6,6">
                                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DateLabel}" FontSize="12"/>
                                                        <TextBlock Classes="faint" FontSize="11"
                                                                   Text="{Binding Size, Converter={x:Static conv:FileSizeConverter.Instance}}"/>
                                                    </StackPanel>
                                                    <!-- Delete asks once, right here; the answer is the second click. -->
                                                    <Button Grid.Column="1" Classes="plain small" IsVisible="{Binding !IsConfirmingDelete}"
                                                            ToolTip.Tip="{DynamicResource Shots_Copy}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyScreenshotCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="plain small icon-danger" IsVisible="{Binding !IsConfirmingDelete}"
                                                            ToolTip.Tip="{DynamicResource Shots_Delete}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteScreenshotCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                                    </Button>
                                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4"
                                                                IsVisible="{Binding IsConfirmingDelete}">
                                                        <Button Classes="danger small" Content="{DynamicResource Shots_DeleteConfirm}"
                                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteScreenshotCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Classes="plain small" Content="{DynamicResource Common_Cancel}"
                                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CancelDeleteScreenshotCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======== The catalog: large cards, details on the right ======== -->
                    <Grid IsVisible="{Binding IsBuildCatalog}" RowDefinitions="Auto,*" RowSpacing="10" controls:Reveal.OnVisible="True">
                        <StackPanel Spacing="10">
                            <Border Classes="panel glass" CornerRadius="14" Padding="14,12" IsVisible="{Binding !IsBuildConfigured}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Builds_NotConfigured}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                                    <Button Classes="ghost small" HorizontalAlignment="Left"
                                            Content="{DynamicResource Builds_GoSettings}"
                                            Command="{Binding OpenBuildSettingsCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- The way back to the tab the catalog was opened from, what kind of
                                 thing is being looked for, and the words to look for it by. Packs and
                                 shaders go to their own folders and fit a vanilla build too. -->
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <Button Classes="glass-icon" Command="{Binding CloseCatalogCommand}"
                                        ToolTip.Tip="{DynamicResource Catalog_Back}">
                                    <PathIcon Data="{StaticResource IconChevronLeft}"/>
                                </Button>
                                <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="segment small" Classes.active="{Binding IsBrowsingMods}"
                                                Content="{DynamicResource Content_Mods}"
                                                Command="{Binding SelectBrowserKindCommand}" CommandParameter="mod"/>
                                        <Button Classes="segment small" Classes.active="{Binding IsBrowsingResourcePacks}"
                                                Content="{DynamicResource Content_ResourcePacks}"
                                                Command="{Binding SelectBrowserKindCommand}" CommandParameter="resourcepack"/>
                                        <Button Classes="segment small" Classes.active="{Binding IsBrowsingShaders}"
                                                Content="{DynamicResource Content_Shaders}"
                                                Command="{Binding SelectBrowserKindCommand}" CommandParameter="shader"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="field">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <PathIcon Data="{StaticResource IconSearch}" Classes="small muted" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="bare" Text="{Binding ModSearchQuery}"
                                                 Watermark="{DynamicResource Mods_SearchPlaceholder}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding SearchModsCommand}"/>
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <!-- With one source its name sits here; with two the switch above says it. -->
                                        <TextBlock Grid.Column="2" Text="Modrinth" Classes="faint" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsCurseForgeAvailable}"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="3" Classes="primary" Height="40" CornerRadius="11"
                                        Content="{DynamicResource Mods_Search}"
                                        Command="{Binding SearchModsCommand}" IsEnabled="{Binding !IsBrowserBusy}"/>
                            </Grid>

                            <!-- One row of chips that scrolls sideways: wrapped, nineteen of them
                                 took a third of a small window. -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              Name="ChipScroll" PointerWheelChanged="OnChipWheel">
                                    <ItemsControl ItemsSource="{Binding ModCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModCategoryOption">
                                                <Button Classes="chip" Classes.active="{Binding IsSelected}"
                                                        Content="{Binding Display}"
                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectCategoryCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ModSortOptions}" SelectedItem="{Binding SelectedModSort}"
                                          MinWidth="160" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModSortOption">
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Grid.Column="2" Content="{DynamicResource Mods_HideInstalled}"
                                          IsChecked="{Binding HideInstalledMods}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="14">

                            <!-- Cards -->
                            <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                <Border Classes="panel glass" Padding="20" VerticalAlignment="Top" IsVisible="{Binding IsBrowserEmpty}">
                                    <TextBlock Text="{DynamicResource Catalog_Empty}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                                </Border>

                                <ScrollViewer Name="BrowserScroll" SizeChanged="OnBrowserSizeChanged">
                                    <ItemsControl Name="BrowserItems" ItemsSource="{Binding ModBrowserItems}" VerticalAlignment="Top">
                                        <!-- A card the "hide installed" tick takes away gives up its
                                             cell too: the grid counts only the containers it can see. -->
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl#BrowserItems > ContentPresenter" x:DataType="vm:ModBrowserItem">
                                                <Setter Property="IsVisible" Value="{Binding !IsHidden}"/>
                                            </Style>
                                        </ItemsControl.Styles>
                                        <!-- Columns are set from the code-behind by the width available. -->
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1" ColumnSpacing="12" RowSpacing="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModBrowserItem">
                                                <Border Classes="mod-tile" Classes.selected="{Binding IsSelected}"
                                                        PointerPressed="OnModRowPressed" Cursor="Hand">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <!-- The strip: a colour of the mod's own, squares over it, and
                                                             where the mod is from. Plain fills with their own corners. -->
                                                        <Panel Height="46">
                                                            <Border CornerRadius="17,17,0,0"
                                                                    Background="{Binding Result.Slug, Converter={x:Static conv:TintBrushConverter.Instance}}"/>
                                                            <controls:Mosaic IsHitTestVisible="False" CornerRadius="17,17,0,0" Cell="12"
                                                                             Fill="{DynamicResource TintMosaicBrush}"/>
                                                            <Border Classes="source-badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"
                                                                    IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsCurseForgeAvailable}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                                            Background="{DynamicResource ModrinthDotBrush}" IsVisible="{Binding IsModrinth}"/>
                                                                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                                            Background="{DynamicResource CurseForgeDotBrush}" IsVisible="{Binding IsCurseForge}"/>
                                                                    <TextBlock Text="{Binding SourceLabel}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Panel>

                                                        <!-- The logo stands on the strip's edge; a letter on the mod's
                                                             colour holds its place until it loads, or when there is none. -->
                                                        <Border Grid.RowSpan="2" Width="54" Height="54" CornerRadius="15" Margin="14,18,0,0"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="3" ClipToBounds="True"
                                                                Background="{Binding Result.Slug, Converter={x:Static conv:TintBrushConverter.Instance}}">
                                                            <Panel>
                                                                <TextBlock Text="{Binding Initial}" Classes="tile-letter" IsVisible="{Binding !HasIcon}"/>
                                                                <Border Background="{DynamicResource ElevatedBrush}" IsVisible="{Binding HasIcon}">
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                                </Border>
                                                            </Panel>
                                                        </Border>

                                                        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="14,6,14,12">
                                                            <!-- Who made it and how many have taken it. The number stays whole;
                                                                 a long author's name is what gives way. -->
                                                            <StackPanel Margin="64,0,0,0" Spacing="1">
                                                                <TextBlock Text="{Binding Result.Title}" Classes="h3" FontSize="15"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding Result.Author}" Classes="faint" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                                                ToolTip.Tip="{Binding DownloadsLabel}">
                                                                        <PathIcon Data="{StaticResource IconDownload}" Classes="muted" Width="10" Height="10"/>
                                                                        <TextBlock Text="{Binding DownloadsShort}" Classes="faint"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="1" Text="{Binding DisplayDescription}" Classes="muted" FontSize="12.5"
                                                                       MaxLines="2" Height="36" VerticalAlignment="Top"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <!-- One line high and wrapping: a tag with no room goes to a second
                                                                     line nobody sees, instead of being cut in the middle of a word. -->
                                                                <ItemsControl ItemsSource="{Binding CategoryLabels}" VerticalAlignment="Center"
                                                                              Height="18" ClipToBounds="True">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sys:String">
                                                                            <Border Classes="tag"><TextBlock Text="{Binding}"/></Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <!-- One state at a time: add it, it is being added, it is in. -->
                                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                                    <Button Classes="primary add" IsVisible="{Binding NotInstalled}"
                                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InstallBrowserItemCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11"/>
                                                                            <TextBlock Text="{DynamicResource Mods_Add}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Border Classes="in-build" IsVisible="{Binding Installed}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11"
                                                                                      Foreground="{DynamicResource InstalledTagTextBrush}"/>
                                                                            <TextBlock Text="{DynamicResource Mods_InBuild}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                                                                 IsVisible="{Binding IsInstalling}"/>
                                                                </Panel>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding BrowserSummary}" Classes="faint" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Classes="ghost small" Content="{DynamicResource Mods_PrevPage}"
                                            Command="{Binding PreviousBrowserPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding BrowserPageLabel}" Classes="faint" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Classes="ghost small" Content="{DynamicResource Mods_NextPage}"
                                            Command="{Binding NextBrowserPageCommand}" IsEnabled="{Binding CanGoToNextPage}"/>
                                </Grid>
                            </Grid>

                            <!-- Details of the selected card. What "Add" will bring - the file, where it
                                 is from, how big, and what comes with it - is the first thing under
                                 the title, before the description: it is read before anything is
                                 downloaded. Only while a card is open: an empty panel took a third
                                 of a small window for a hint nobody needed twice. -->
                            <Border Grid.Column="1" Classes="card glass" Padding="0" Width="320"
                                    IsVisible="{Binding IsProjectOpen}">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Panel>
                                        <Border CornerRadius="17,17,0,0" Background="{DynamicResource ProjectHeaderBrush}"/>
                                        <Grid Margin="14,12,8,12" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                            <Border Width="48" Height="48" CornerRadius="13" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource ElevatedBrush}" ClipToBounds="True">
                                                <Image Source="{Binding OpenedProjectIcon}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OpenedProject.Title}" Classes="h3"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OpenedProjectByline}" Classes="faint"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="plain small" Command="{Binding TranslateProjectCommand}"
                                                    ToolTip.Tip="{DynamicResource Builds_Translate}">
                                                <PathIcon Data="{StaticResource IconGlobe}" Classes="small"/>
                                            </Button>
                                            <Button Grid.Column="3" Classes="plain small" Command="{Binding OpenProjectPageCommand}"
                                                    ToolTip.Tip="{Binding OpenProjectPageLabel}">
                                                <PathIcon Data="{StaticResource IconOpenExternal}" Classes="small"/>
                                            </Button>
                                            <Button Grid.Column="4" Classes="plain small"
                                                    Command="{Binding CloseProjectCommand}" ToolTip.Tip="{DynamicResource Common_Close2}">
                                                <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                                            </Button>
                                        </Grid>
                                    </Panel>

                                    <ScrollViewer Grid.Row="1" Name="ProjectScroll">
                                        <StackPanel Spacing="12" Margin="16,12,16,12">

                                            <!-- A file its author keeps to the site: said plainly, with the way to get it. -->
                                            <Border Classes="panel" CornerRadius="12" Padding="12,10" IsVisible="{Binding IsOpenedProjectBlocked}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <PathIcon Data="{StaticResource IconWarning}" Classes="small gold" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="{DynamicResource Mods_BlockedNote}" FontSize="12"
                                                               TextWrapping="Wrap" LineHeight="17"/>
                                                </Grid>
                                            </Border>

                                            <!-- What pressing "Add" will download: the file, where it is from,
                                                 and everything that comes with it. -->
                                            <Border Classes="panel" CornerRadius="12" Padding="12,10">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding VersionForLabel}" Classes="faint"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding OpenedProjectFileLabel}" HorizontalAlignment="Right"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <TextBlock Text="{DynamicResource Mods_From}" Classes="faint"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding OpenedProjectSourceLabel}" HorizontalAlignment="Right"
                                                                   FontSize="12"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding OpenedProjectDependencies}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ModDependencyItem">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                    <TextBlock Text="{DynamicResource Mods_Requires}" Classes="faint"
                                                                               IsVisible="{Binding Required}"/>
                                                                    <TextBlock Text="{DynamicResource Mods_WorksWith}" Classes="faint"
                                                                               IsVisible="{Binding !Required}"/>
                                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                                   HorizontalAlignment="Right"/>
                                                                        <TextBlock Text="{Binding StateLabel}" FontSize="11.5" HorizontalAlignment="Right"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource GoldBrush}"
                                                                                   IsVisible="{Binding !OffersPage}"/>
                                                                        <!-- A needed mod the launcher may not fetch: the words open its page. -->
                                                                        <Button Classes="plain small" Padding="0" HorizontalAlignment="Right" Cursor="Hand"
                                                                                IsVisible="{Binding OffersPage}"
                                                                                ToolTip.Tip="{DynamicResource Mods_OpenModPage}"
                                                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenUrlCommand}"
                                                                                CommandParameter="{Binding PageUrl}">
                                                                            <TextBlock Text="{Binding StateLabel}" FontSize="11.5" TextDecorations="Underline"
                                                                                       Foreground="{DynamicResource GoldBrush}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding OpenedProjectTotalLabel}" FontSize="12" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" IsVisible="{Binding HasOpenedProjectTotal}"/>
                                                    <!-- The list above may be short of a file: "Add" waits for a whole one. -->
                                                    <TextBlock Text="{DynamicResource Mods_DepsIncomplete}" FontSize="12" TextWrapping="Wrap"
                                                               LineHeight="17" Foreground="{DynamicResource GoldBrush}"
                                                               IsVisible="{Binding IsOpenedProjectListIncomplete}"/>
                                                    <!-- The source marks this mod, or one it brings, as not going with a mod of the build. -->
                                                    <TextBlock Text="{Binding OpenedProjectConflictLabel}" FontSize="12" TextWrapping="Wrap"
                                                               LineHeight="17" Foreground="{DynamicResource GoldBrush}"
                                                               IsVisible="{Binding HasOpenedProjectConflict}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Every compatible version, when asked for. -->
                                            <ListBox ItemsSource="{Binding OpenedProjectVersions}" MaxHeight="200"
                                                     IsVisible="{Binding ShowOtherVersions}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="mods:ModVersion">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding VersionNumber}" FontWeight="SemiBold" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Name}" Classes="faint" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="ghost small" Content="{DynamicResource Mods_UseVersion}"
                                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).InstallVersionCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding OpenedProjectDescription}" Classes="muted" FontSize="13"
                                                           TextWrapping="Wrap" LineHeight="19" MaxHeight="{Binding DescriptionMaxHeight}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Bodies run to pages; the card opens with a preview and unfolds on request. -->
                                                <Button Classes="plain small" HorizontalAlignment="Left" Padding="0"
                                                        Command="{Binding ToggleDescriptionCommand}"
                                                        IsVisible="{Binding OpenedProjectDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{DynamicResource Mods_ShowFullDescription}" FontSize="12"
                                                                   Foreground="{DynamicResource GoldBrush}" IsVisible="{Binding !IsDescriptionExpanded}"/>
                                                        <TextBlock Text="{DynamicResource Mods_ShowLessDescription}" FontSize="12"
                                                                   Foreground="{DynamicResource GoldBrush}" IsVisible="{Binding IsDescriptionExpanded}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Screenshots: a click opens the same image over the whole window. -->
                                            <ItemsControl ItemsSource="{Binding OpenedProjectGallery}" IsVisible="{Binding OpenedProjectGallery.Count}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="plain" Padding="0" Cursor="Hand"
                                                                ToolTip.Tip="{DynamicResource Gallery_Open}"
                                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenGalleryImageCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Border Width="90" Height="54" CornerRadius="8" Background="{DynamicResource ElevatedBrush}"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2" Margin="16,0,16,16" Spacing="8">
                                        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsProjectBusy}"/>
                                        <!-- Nothing to install from here: the mod's own page is the offer. -->
                                        <Button Classes="primary" HorizontalAlignment="Stretch"
                                                IsVisible="{Binding OffersModPageInstead}"
                                                Command="{Binding OpenProjectPageCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconOpenExternal}" Classes="small"/>
                                                <TextBlock Text="{DynamicResource Mods_OpenModPage}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- The quiet button takes what its words need; the one that acts gets the rest. -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Button Classes="ghost" Padding="11,8" Content="{DynamicResource Mods_OtherVersions}"
                                                    Command="{Binding ToggleOtherVersionsCommand}" IsEnabled="{Binding HasOpenedProjectVersion}"/>
                                            <Button Grid.Column="1" Classes="primary" Padding="8" HorizontalAlignment="Stretch"
                                                    IsVisible="{Binding CanInstallOpenedProject}" IsEnabled="{Binding CanAddOpenedProject}"
                                                    Content="{DynamicResource Mods_AddToBuild}" Command="{Binding InstallOpenedProjectCommand}"/>
                                            <Button Grid.Column="1" Classes="danger" Padding="8" HorizontalAlignment="Stretch"
                                                    IsVisible="{Binding OpenedProjectInstalled}"
                                                    Content="{DynamicResource Mods_RemoveFromBuild}" Command="{Binding UninstallOpenedProjectCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Panel>
            </Grid>
        </Grid>

        <!-- ============ Import from other launchers ============ -->
        <Border Background="{DynamicResource OverlayScrimBrush}" IsVisible="{Binding IsImportOpen}" controls:Reveal.OnVisible="True">
            <Border Classes="card" Width="620" MaxHeight="560" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="22">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Import_Title}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ImportStatus}" Classes="faint" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding ImportFolder}"
                                 Watermark="{DynamicResource Import_FolderHint}"/>
                        <Button Grid.Column="1" Classes="ghost small"
                                Content="{DynamicResource Import_Folder}"
                                Command="{Binding ScanFolderCommand}"
                                IsEnabled="{Binding !IsImportBusy}"/>
                        <Button Grid.Column="2" Classes="ghost small"
                                Content="{DynamicResource Import_Rescan}"
                                Command="{Binding ScanForInstancesCommand}"
                                IsEnabled="{Binding !IsImportBusy}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding ImportCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImportCandidate">
                                    <Border Classes="panel" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding IsUsable}"
                                                      VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" Classes="faint"/>

                                                <!-- A build that cannot be imported is still listed,
                                                     with the reason: one that vanishes looks like a
                                                     build the launcher lost. -->
                                                <TextBlock Text="{Binding ProblemLabel}" Classes="gold"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding !IsUsable}"/>
                                                <TextBlock Text="{Binding Note}" Classes="gold"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasNote}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SourceLabel}"
                                                       Classes="faint" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Spacing="8">
                        <TextBlock Text="{DynamicResource Import_ModeTitle}" Classes="label"/>

                        <RadioButton GroupName="ImportMode" IsChecked="{Binding ImportByLinking}"
                                     Content="{DynamicResource Import_ModeLink}"/>
                        <TextBlock Text="{DynamicResource Import_ModeLinkHint}" Classes="faint"
                                   TextWrapping="Wrap" Margin="26,0,0,0"/>

                        <RadioButton GroupName="ImportMode" IsChecked="{Binding ImportByCopying}"
                                     Content="{DynamicResource Import_ModeCopy}"/>
                        <TextBlock Text="{DynamicResource Import_ModeCopyHint}" Classes="faint"
                                   TextWrapping="Wrap" Margin="26,0,0,0"/>

                        <TextBlock Text="{Binding ImportSummary}" Classes="gold" TextWrapping="Wrap"
                                   IsVisible="{Binding ImportSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <ProgressBar IsVisible="{Binding IsImportBusy}" IsIndeterminate="True"
                                     Height="3" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost"
                                Content="{DynamicResource Common_Close2}"
                                Command="{Binding CloseImportCommand}"/>
                        <Button Grid.Column="2" Classes="primary"
                                Content="{DynamicResource Import_Apply}"
                                Command="{Binding ImportSelectedCommand}"
                                IsEnabled="{Binding !IsImportBusy}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============ New build wizard ============ -->
        <Border Background="{DynamicResource OverlayScrimBrush}" IsVisible="{Binding IsNewBuildOpen}" controls:Reveal.OnVisible="True">
            <Border Classes="card" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="{DynamicResource Builds_WizardTitle}" FontSize="17"
                               FontWeight="SemiBold"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Builds_WizardName}" Classes="faint"/>
                        <TextBox Text="{Binding NewBuildName}"
                                 Watermark="{DynamicResource Game_InstanceNameHint}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Builds_WizardVersion}" Classes="faint"/>
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding NewBuildVersion}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:VersionSummary">
                                    <TextBlock Text="{Binding Id}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Builds_WizardLoader}" Classes="faint"/>
                        <ComboBox ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding NewBuildLoader}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <CheckBox Content="{Binding NewBuildCopySettingsLabel}" IsChecked="{Binding NewBuildCopySettings}"
                              IsVisible="{Binding CanCopyNewBuildSettings}"/>

                    <TextBlock Text="{DynamicResource Builds_WizardHint}" Classes="faint"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{DynamicResource Common_Cancel}"
                                Command="{Binding CloseNewBuildCommand}"/>
                        <Button Classes="primary" Content="{DynamicResource Builds_WizardCreate}"
                                Command="{Binding CreateBuildFromWizardCommand}"
                                IsEnabled="{Binding CanCreateBuild}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ Build settings: a sheet on the right; the page stays put ============ -->
        <Border Background="{DynamicResource OverlayScrimBrush}" IsVisible="{Binding IsBuildSettingsOpen}" controls:Reveal.OnVisible="True">
            <Border Classes="card" Width="460" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    CornerRadius="0" Padding="22">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Builds_TabSettings}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="plain small" Command="{Binding CloseBuildSettingsCommand}"
                                ToolTip.Tip="{DynamicResource WhatsNew_Close}">
                            <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Builds_Selected}" Classes="label"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding InstanceNameEdit}"
                                             Watermark="{DynamicResource Game_InstanceNameHint}"/>
                                    <Button Grid.Column="1" Classes="ghost"
                                            Content="{DynamicResource Builds_Rename}"
                                            Command="{Binding RenameInstanceCommand}"/>
                                </Grid>
                            </StackPanel>

                            <Border Classes="hairline"/>

                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource Game_Profile}" Classes="label"/>

                                <!-- An imported build starts from its own profile: its version and
                                     loader are fixed by it, so they are stated, not offered. -->
                                <TextBlock Text="{Binding ProfileBuildHint}" Classes="faint"
                                           TextWrapping="Wrap" IsVisible="{Binding IsProfileBuild}"/>

                                <StackPanel Spacing="12" IsVisible="{Binding IsNotProfileBuild}">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{DynamicResource Game_Version}" Classes="faint"/>
                                            <ComboBox ItemsSource="{Binding Versions}"
                                                      SelectedItem="{Binding SelectedVersion}"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="m:VersionSummary">
                                                        <TextBlock Text="{Binding Id}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{DynamicResource Game_Loader}" Classes="faint"/>
                                            <ComboBox ItemsSource="{Binding LoaderKinds}"
                                                      SelectedItem="{Binding SelectedLoader}"
                                                      HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{DynamicResource Game_LoaderVersion}" Classes="faint"/>
                                        <ComboBox ItemsSource="{Binding LoaderVersions}"
                                                  SelectedItem="{Binding SelectedLoaderVersion}"
                                                  IsEnabled="{Binding !IsLoaderBusy}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="loaders:LoaderVersion">
                                                    <TextBlock Text="{Binding Version}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Memory and the window are on the settings page, for the build that is
                                     open; two copies of the same number in two places argued with each other. -->
                                <TextBlock Text="{DynamicResource Builds_MemoryHint}" Classes="faint" TextWrapping="Wrap"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource Settings_ExtraArgs}" Classes="faint"/>
                                    <TextBox Text="{Binding ExtraGameArgs}"
                                             Watermark="--fullscreen --width 1920"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Classes="hairline" IsVisible="{Binding HasOtherInstances}"/>

                            <StackPanel Spacing="10" IsVisible="{Binding HasOtherInstances}">
                                <TextBlock Text="{DynamicResource Transfer_Title}" Classes="label"/>
                                <TextBlock Text="{DynamicResource Transfer_Hint}" Classes="faint" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding OtherInstances}" SelectedItem="{Binding CopySettingsSource}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="inst:Instance">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Transfer_Copy}"
                                            Command="{Binding CopyGameSettingsCommand}" IsEnabled="{Binding !IsGameRunning}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Deleting sits apart from everything else, and "Done" is the way out. -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Classes="danger small" Content="{DynamicResource Game_DeleteInstance}"
                                Command="{Binding DeleteInstanceCommand}"/>
                        <Button Grid.Column="2" Classes="primary" Content="{DynamicResource Common_Done}"
                                Command="{Binding CloseBuildSettingsCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Where a dragged file will land. Not hit-testable: the drop goes to the page. -->
        <Border IsVisible="{Binding IsDropHover}" IsHitTestVisible="False" Margin="22"
                Background="{DynamicResource LightboxScrimBrush}" CornerRadius="18"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <PathIcon Data="{StaticResource IconPlus}" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{DynamicResource Mods_DropHere}" Classes="h3" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Mods_DropHint}" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
