<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:m="using:STlauncher.Core.Metadata"
             xmlns:loaders="using:STlauncher.Core.Loaders"
             x:Class="STlauncher.App.Views.Pages.BuildsPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="22" ColumnDefinitions="300,*" ColumnSpacing="16">

        <!-- Build list -->
        <Border Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="{DynamicResource Builds_Title}" Classes="label"/>
                    <TextBlock Text="{DynamicResource Builds_Hint}" Classes="faint" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Instances}"
                         SelectedItem="{Binding SelectedInstance}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="inst:Instance">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="faint">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}">
                                            <Binding Path="VersionId" TargetNullValue="—"/>
                                            <Binding Path="Loader"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding NewInstanceName}"
                             Watermark="{DynamicResource Game_InstanceNameHint}"/>
                    <Button Grid.Column="1" Classes="ghost small"
                            Content="{DynamicResource Game_NewInstance}"
                            Command="{Binding CreateInstanceCommand}"/>
                    <Button Grid.Column="2" Classes="ghost small"
                            Content="{DynamicResource Builds_Duplicate}"
                            Command="{Binding DuplicateInstanceCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Selected build -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Builds_Selected}" Classes="label"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding InstanceNameEdit}"
                                     Watermark="{DynamicResource Game_InstanceNameHint}"/>
                            <Button Grid.Column="1" Classes="ghost"
                                    Content="{DynamicResource Builds_Rename}"
                                    Command="{Binding RenameInstanceCommand}"/>
                        </Grid>

                        <Border Classes="hairline"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource Game_Version}" Classes="faint"/>
                                <ComboBox ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:VersionSummary">
                                            <TextBlock Text="{Binding Id}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource Game_Loader}" Classes="faint"/>
                                <ComboBox ItemsSource="{Binding LoaderKinds}"
                                          SelectedItem="{Binding SelectedLoader}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Game_LoaderVersion}" Classes="faint"/>
                            <ComboBox ItemsSource="{Binding LoaderVersions}"
                                      SelectedItem="{Binding SelectedLoaderVersion}"
                                      IsEnabled="{Binding !IsLoaderBusy}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="loaders:LoaderVersion">
                                        <TextBlock Text="{Binding Version}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Builds_Contents}" Classes="label"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource Builds_Mods}" Classes="faint"/>
                                <TextBlock Text="{Binding BuildModCount}" FontSize="20" FontWeight="SemiBold"
                                           Classes="gold"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost"
                                    Content="{DynamicResource Builds_EditMods}"
                                    Command="{Binding SelectSectionCommand}"
                                    CommandParameter="Content"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <Border Classes="hairline"/>
                        <TextBlock Text="{DynamicResource Builds_ModsHint}" Classes="faint"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Builds_Danger}" Classes="label"/>
                        <Button Classes="danger" HorizontalAlignment="Left"
                                Content="{DynamicResource Game_DeleteInstance}"
                                Command="{Binding DeleteInstanceCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

