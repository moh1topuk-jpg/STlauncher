<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             xmlns:inst="using:STlauncher.Core.Instances"
             xmlns:m="using:STlauncher.Core.Metadata"
             xmlns:loaders="using:STlauncher.Core.Loaders"
             xmlns:controls="using:STlauncher.App.Controls"
             x:Class="STlauncher.App.Views.Pages.BuildDialogs"
             x:DataType="vm:MainWindowViewModel">

    <!-- What opens over the builds page: bringing builds over from other launchers, the
         new build, and the settings of the build that is open. The page only places this
         view above itself; while nothing is open it draws nothing and catches no clicks. -->

    <UserControl.Styles>
        <!-- The name of a field, above the field. -->
        <Style Selector="TextBlock.field-name">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- What a choice will do to the player's files: always on screen, under the choice. -->
        <Style Selector="TextBlock.consent">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <!-- The quiet button on a dialog: the dialog is the colour the quiet button has on
             the page, so here it is one step lighter, or it would be bare words. -->
        <Style Selector="Button.raised /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        </Style>
        <Style Selector="Button.raised:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- ============ Import from other launchers ============ -->
        <Border Classes="scrim" IsVisible="{Binding IsImportOpen}" controls:Reveal.OnVisible="True">
            <Border Classes="dialog" Width="640" MaxHeight="640" Margin="20">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Import_Title}" Classes="group"/>
                        <TextBlock Text="{Binding ImportStatus}" Classes="consent"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Border Classes="field">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconFolder}" Classes="small muted" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Classes="bare" Text="{Binding ImportFolder}"
                                             Watermark="{DynamicResource Import_FolderHint}"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Classes="raised" Height="36" Padding="14,0"
                                    Content="{DynamicResource Import_Folder}"
                                    Command="{Binding ScanFolderCommand}"
                                    IsEnabled="{Binding !IsImportBusy}"/>
                            <Button Grid.Column="2" Classes="icon" Height="36" Width="36"
                                    ToolTip.Tip="{DynamicResource Import_Rescan}"
                                    Command="{Binding ScanForInstancesCommand}"
                                    IsEnabled="{Binding !IsImportBusy}">
                                <PathIcon Data="{StaticResource IconRefresh}"/>
                            </Button>
                        </Grid>

                        <!-- Walking whole drives is slow and nobody asked for it, so it
                             happens only on this button; the same button stops it. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Button Classes="link"
                                    Content="{Binding SweepButtonLabel}"
                                    Command="{Binding SweepDrivesCommand}"
                                    IsEnabled="{Binding CanSweep}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Import_SweepHint}"
                                       Classes="consent" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" MinHeight="96">
                        <StackPanel Margin="0,0,10,0">
                            <StackPanel IsVisible="{Binding HasSweepFolders}" Margin="0,0,0,12">
                                <controls:Caption Text="{DynamicResource Import_SweepFoldersTitle}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding SweepFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SweepFolder">
                                            <Border Classes="row" Padding="0,9">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Path}" Classes="strong"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Path}"/>
                                                        <TextBlock Text="{Binding KindLabel}" Classes="sub"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="small raised" VerticalAlignment="Center"
                                                            Content="{DynamicResource Import_SweepShow}"
                                                            IsVisible="{Binding !IsShown}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ShowSweepFolderCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Result}" Classes="sub"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsShown}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ImportCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImportCandidate">
                                        <Border Classes="row" Padding="0,10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding IsUsable}"
                                                          MinWidth="0" Padding="0" VerticalAlignment="Top" Margin="0,1,0,0"/>

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Classes="strong"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" Classes="sub" TextWrapping="Wrap"/>

                                                    <!-- Found behind a root that is a link: the real
                                                         folder that will be read, said before the import. -->
                                                    <TextBlock Text="{Binding ReadsFromLabel}" Classes="consent"
                                                               IsVisible="{Binding HasReadsFrom}"/>

                                                    <!-- A build that cannot be imported is still listed,
                                                         with the reason: one that vanishes looks like a
                                                         build the launcher lost. -->
                                                    <TextBlock Text="{Binding ProblemLabel}" Classes="warn"
                                                               IsVisible="{Binding !IsUsable}"/>
                                                    <TextBlock Text="{Binding Note}" Classes="warn"
                                                               IsVisible="{Binding HasNote}"/>

                                                    <!-- What comes along from the old launcher's settings
                                                         of this build, and what is left behind. -->
                                                    <TextBlock Text="{Binding CarriedLabel}" Classes="consent"
                                                               IsVisible="{Binding HasCarried}"/>
                                                    <TextBlock Text="{Binding DroppedLabel}" Classes="warn"
                                                               IsVisible="{Binding HasDropped}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}"
                                                           Classes="mono" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- What happens to the files: both answers and what each means stay on screen. -->
                    <StackPanel Grid.Row="3" Spacing="6">
                        <controls:Caption Text="{DynamicResource Import_ModeTitle}"/>

                        <RadioButton GroupName="ImportMode" IsChecked="{Binding ImportByLinking}"
                                     Content="{DynamicResource Import_ModeLink}"/>
                        <TextBlock Text="{DynamicResource Import_ModeLinkHint}" Classes="consent" Margin="28,-4,0,0"/>

                        <RadioButton GroupName="ImportMode" IsChecked="{Binding ImportByCopying}"
                                     Content="{DynamicResource Import_ModeCopy}"/>
                        <TextBlock Text="{DynamicResource Import_ModeCopyHint}" Classes="consent" Margin="28,-4,0,0"/>
                        <TextBlock Text="{DynamicResource Import_SharedCopyHint}" Classes="consent" Margin="28,0,0,0"
                                   IsVisible="{Binding ImportCopiesFromShared}"/>

                        <TextBlock Text="{Binding ImportSummary}" Classes="warn" Margin="0,4,0,0"
                                   IsVisible="{Binding ImportSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <ProgressBar IsVisible="{Binding IsImportBusy}" IsIndeterminate="True"
                                     Height="3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Classes="ghost"
                                Content="{DynamicResource Common_Close2}"
                                Command="{Binding CloseImportCommand}"/>
                        <Button Grid.Column="2" Classes="primary"
                                Content="{DynamicResource Import_Apply}"
                                Command="{Binding ImportSelectedCommand}"
                                IsEnabled="{Binding !IsImportBusy}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============ New build ============ -->
        <Border Classes="scrim" IsVisible="{Binding IsNewBuildOpen}" controls:Reveal.OnVisible="True">
            <Border Classes="dialog" Width="460" Margin="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{DynamicResource Builds_WizardTitle}" Classes="group"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Builds_WizardName}" Classes="field-name"/>
                        <TextBox Text="{Binding NewBuildName}"
                                 Watermark="{DynamicResource Game_InstanceNameHint}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Builds_WizardVersion}" Classes="field-name"/>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding NewBuildVersion}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:VersionSummary">
                                        <TextBlock Text="{Binding Id}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{DynamicResource Builds_WizardLoader}" Classes="field-name"/>
                            <ComboBox ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding NewBuildLoader}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Builds_WizardHint}" Classes="consent" Margin="0,-6,0,0"/>

                    <CheckBox Content="{Binding NewBuildCopySettingsLabel}" IsChecked="{Binding NewBuildCopySettings}"
                              IsVisible="{Binding CanCopyNewBuildSettings}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{DynamicResource Common_Cancel}"
                                Command="{Binding CloseNewBuildCommand}"/>
                        <Button Classes="primary" Content="{DynamicResource Builds_WizardCreate}"
                                Command="{Binding CreateBuildFromWizardCommand}"
                                IsEnabled="{Binding CanCreateBuild}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ Build settings: a sheet on the right; the page stays put ============ -->
        <Border Classes="scrim" IsVisible="{Binding IsBuildSettingsOpen}" controls:Reveal.OnVisible="True">
            <Border Width="470" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="1,0,0,0"
                    BoxShadow="{DynamicResource DialogShadow}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="26,20,18,6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Builds_TabSettings}" Classes="group"/>
                            <TextBlock Text="{Binding SelectedInstance.Name}" Classes="sub" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseBuildSettingsCommand}"
                                ToolTip.Tip="{DynamicResource WhatsNew_Close}">
                            <PathIcon Data="{StaticResource IconClose}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="26,0,26,12">

                            <Border Classes="setting">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource Builds_WizardName}" Classes="strong"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding InstanceNameEdit}"
                                                 Watermark="{DynamicResource Game_InstanceNameHint}"/>
                                        <Button Grid.Column="1" Classes="raised"
                                                Content="{DynamicResource Builds_Rename}"
                                                Command="{Binding RenameInstanceCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- An imported build starts from its own profile: its version and
                                 loader are fixed by it, so they are stated, not offered. -->
                            <Border Classes="setting" IsVisible="{Binding IsProfileBuild}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Game_Profile}" Classes="strong"/>
                                    <TextBlock Text="{Binding ProfileBuildHint}" Classes="sub"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="setting" IsVisible="{Binding IsNotProfileBuild}">
                                <Grid ColumnDefinitions="*,200" ColumnSpacing="20">
                                    <TextBlock Text="{DynamicResource Game_Version}" Classes="strong" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="m:VersionSummary">
                                                <TextBlock Text="{Binding Id}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Classes="setting" IsVisible="{Binding IsNotProfileBuild}">
                                <Grid ColumnDefinitions="*,200" ColumnSpacing="20">
                                    <TextBlock Text="{DynamicResource Game_Loader}" Classes="strong" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderKinds}"
                                              SelectedItem="{Binding SelectedLoader}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting" IsVisible="{Binding IsNotProfileBuild}">
                                <Grid ColumnDefinitions="*,200" ColumnSpacing="20">
                                    <TextBlock Text="{DynamicResource Game_LoaderVersion}" Classes="strong" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderVersions}"
                                              SelectedItem="{Binding SelectedLoaderVersion}"
                                              IsEnabled="{Binding !IsLoaderBusy}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="loaders:LoaderVersion">
                                                <TextBlock Text="{Binding Version}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Memory and the window are on the settings page, for the build that is
                                 open; two copies of the same number in two places argued with each other. -->
                            <Border Classes="setting">
                                <StackPanel Spacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings_ExtraArgs}" Classes="strong"/>
                                        <TextBlock Text="{DynamicResource Builds_MemoryHint}" Classes="sub"/>
                                    </StackPanel>
                                    <TextBox Classes="mono" Text="{Binding ExtraGameArgs}"
                                             Watermark="--fullscreen --width 1920"/>
                                </StackPanel>
                            </Border>

                            <!-- Checked when focus leaves the field, not on every key: half
                                 an option is not an option yet. -->
                            <Border Classes="setting">
                                <StackPanel Spacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings_JvmArgs}" Classes="strong"/>
                                        <TextBlock Text="{DynamicResource Settings_JvmArgsHint}" Classes="sub"/>
                                    </StackPanel>
                                    <TextBox Classes="mono" Text="{Binding BuildJvmArgs, UpdateSourceTrigger=LostFocus}"
                                             Watermark="-XX:+UseG1GC -XX:MaxGCPauseMillis=50"/>
                                </StackPanel>
                            </Border>

                            <!-- The skin in the game: off until asked for, and the click is the consent
                                 to a download - so what it downloads and who sees the skin is said here. -->
                            <Border Classes="setting">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SkinInGame_Title}" Classes="strong"/>
                                            <TextBlock Text="{DynamicResource SkinInGame_Switch}" Classes="sub"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkinInGameSwitch}"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="{Binding CanToggleSkinInGame}"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource SkinInGame_About}" Classes="consent"/>
                                    <TextBlock Text="{Binding SkinInGameNote}" TextWrapping="Wrap" FontSize="12.5"
                                               IsVisible="{Binding HasSkinInGameNote}"/>
                                    <TextBlock Text="{Binding SkinInGameProblem}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource DangerBrush}"
                                               IsVisible="{Binding HasSkinInGameProblem}"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="setting" IsVisible="{Binding HasOtherInstances}">
                                <StackPanel Spacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Transfer_Title}" Classes="strong"/>
                                        <TextBlock Text="{DynamicResource Transfer_Hint}" Classes="sub"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding OtherInstances}" SelectedItem="{Binding CopySettingsSource}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="inst:Instance">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1" Classes="raised" Content="{DynamicResource Transfer_Copy}"
                                                Command="{Binding CopyGameSettingsCommand}" IsEnabled="{Binding !IsGameRunning}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Deleting sits apart from everything else, and "Done" is the way out. -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button Classes="danger raised" Content="{DynamicResource Builds_DeleteBuild}"
                                    Command="{Binding DeleteInstanceCommand}"/>
                            <Button Grid.Column="2" Classes="primary" Content="{DynamicResource Common_Done}"
                                    Command="{Binding CloseBuildSettingsCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Panel>
</UserControl>
