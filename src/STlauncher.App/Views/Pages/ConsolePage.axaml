<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             x:Class="STlauncher.App.Views.Pages.ConsolePage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="12">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource Nav_Console}" Classes="h2" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="ghost small" Content="{DynamicResource Console_Clear}"
                    Command="{Binding ClearConsoleCommand}"/>
        </Grid>

        <Border Grid.Row="1" Classes="panel" Padding="0">
            <ListBox ItemsSource="{Binding Console}" Background="Transparent" Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
