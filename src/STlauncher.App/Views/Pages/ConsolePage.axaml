<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:STlauncher.App.ViewModels"
             x:Class="STlauncher.App.Views.Pages.ConsolePage"
             x:DataType="vm:MainWindowViewModel">

    <!-- The technical log: a title with its three actions as real buttons, and the lines
         in mono on an inset panel: a well in the ground, with an edge. -->

    <UserControl.Styles>
        <!-- A log line is text, not a list item: close together, a faint tone when aimed at. -->
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.log ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.log ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.log ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.log ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="24,8,24,18" RowDefinitions="Auto,*" RowSpacing="14">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{DynamicResource Nav_Console}" Classes="page-title" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="small" Click="OnCopyClick" ToolTip.Tip="{DynamicResource Console_CopyHint}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconCopy}" Classes="small"/>
                        <TextBlock Text="{DynamicResource Console_Copy}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="small" Command="{Binding ClearConsoleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconSkinDelete}" Classes="small"/>
                        <TextBlock Text="{DynamicResource Console_Clear}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="small" Command="{Binding OpenLauncherLogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconFolder}" Classes="small"/>
                        <TextBlock Text="{DynamicResource Console_OpenLog}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="panel inset" Padding="0" ClipToBounds="True">
            <Panel>
                <ListBox Name="Lines" Classes="log" ItemsSource="{Binding Console}" SelectionMode="Multiple"
                         Background="Transparent" Padding="0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Classes="empty" IsVisible="{Binding !Console.Count}" IsHitTestVisible="False">
                    <Border Classes="empty-icon"><PathIcon Data="{StaticResource IconConsole}"/></Border>
                    <TextBlock Classes="sub" Text="{DynamicResource Console_Empty}"/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
