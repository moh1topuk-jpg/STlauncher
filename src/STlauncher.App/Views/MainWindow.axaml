<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STlauncher.App.ViewModels"
        xmlns:pages="using:STlauncher.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="STlauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720"
        MinWidth="920" MinHeight="600"
        Background="{DynamicResource AppBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="/Assets/app.ico"
        Title="STlauncher">

    <Grid RowDefinitions="40,Auto,*,28">

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0" Background="#0F0C11" PointerPressed="OnTitleBarPressed">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" ClipToBounds="True">
                        <Image Source="/Assets/server-logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="STlauncher" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Classes="chrome" Click="OnMinimizeClick" ToolTip.Tip="{DynamicResource Common_Minimize}">
                        <PathIcon Data="{StaticResource IconMinimize}"/>
                    </Button>
                    <Button Classes="chrome" Click="OnMaximizeClick" ToolTip.Tip="{DynamicResource Common_Maximize}">
                        <PathIcon Data="{StaticResource IconMaximize}"/>
                    </Button>
                    <Button Classes="chrome chrome-close" Click="OnCloseClick" ToolTip.Tip="{DynamicResource Common_Close}">
                        <PathIcon Data="{StaticResource IconClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Update notification ============ -->
        <!-- Appears only when a release was actually found. One button does the whole
             job: download if needed, then apply and relaunch. -->
        <Border Grid.Row="1" IsVisible="{Binding IsUpdateBannerVisible}"
                Background="#1C1420" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <PathIcon Data="{StaticResource IconDownload}" Classes="accent" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Text="{Binding UpdateBannerText}" TextWrapping="Wrap"/>

                <Button Grid.Column="2" Classes="primary small"
                        Content="{Binding UpdateBannerAction}"
                        Command="{Binding InstallUpdateCommand}"
                        IsEnabled="{Binding !IsUpdateBusy}"/>

                <Button Grid.Column="3" Classes="plain small"
                        Command="{Binding DismissUpdateBannerCommand}"
                        IsEnabled="{Binding !IsUpdateBusy}"
                        ToolTip.Tip="{DynamicResource Update_Dismiss}">
                    <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                </Button>
            </Grid>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="2" ColumnDefinitions="224,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <Grid RowDefinitions="*,Auto">

                    <StackPanel Grid.Row="0" Margin="12,14" Spacing="2">
                        <Button Classes="nav" Classes.active="{Binding IsGameSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Game">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconPlay}"/>
                                <TextBlock Text="{DynamicResource Nav_Game}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsBuildsSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Builds">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconBuilds}"/>
                                <TextBlock Text="{DynamicResource Nav_Builds}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsServerSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Server">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconServer}"/>
                                <TextBlock Text="{DynamicResource Nav_Server}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsConsoleSection}"
                                IsVisible="{Binding ShowDeveloperConsole}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Console">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconConsole}"/>
                                <TextBlock Text="{DynamicResource Nav_Console}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsSettingsSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconSettings}"/>
                                <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Update + profile footer -->
                    <StackPanel Grid.Row="1" Margin="12,0,12,12" Spacing="10">

                        <!-- Always visible, never in the way: one row that either offers
                             a check or the update it already found. -->
                        <StackPanel Spacing="4">
                            <Button Classes="update-row" Classes.available="{Binding HasUpdate}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding UpdateActionCommand}"
                                    IsEnabled="{Binding !IsUpdateBusy}"
                                    Content="{Binding UpdateActionLabel}"/>

                            <!-- A launcher that cannot update itself must not be a dead end. -->
                            <Button Classes="plain small" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    IsVisible="{Binding CanDownloadManually}"
                                    Content="{DynamicResource Update_DownloadManually}"
                                    Command="{Binding OpenReleasesPageCommand}"/>

                            <TextBlock Text="{Binding UpdateStateLabel}" Classes="faint"
                                       ToolTip.Tip="{Binding UpdateStatus}"
                                       TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                        </StackPanel>

                        <Border Classes="panel" Padding="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource ElevatedBrush}"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Avatar}" Stretch="Uniform" Width="34" Height="34"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedInstance.Name}" Classes="faint"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Panel Grid.Column="1">
                <pages:GamePage IsVisible="{Binding IsGameSection}"/>
                <pages:BuildsPage IsVisible="{Binding IsBuildsSection}"/>
                <pages:ServerPage IsVisible="{Binding IsServerSection}"/>
                <pages:ConsolePage IsVisible="{Binding IsConsoleSection}"/>
                <pages:SettingsPage IsVisible="{Binding IsSettingsSection}"/>
            </Panel>
        </Grid>

        <!-- ============ Status bar ============ -->
        <!-- Quiet by default: the progress bar only exists while something is loading. -->
        <Border Grid.Row="3" Background="#0F0C11" Padding="16,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Classes="faint" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" Value="{Binding Progress}" Minimum="0" Maximum="100" Width="160"
                             VerticalAlignment="Center" IsVisible="{Binding ShowLaunchProgress}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
