<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STlauncher.App.ViewModels"
        xmlns:pages="using:STlauncher.App.Views.Pages"
        xmlns:views="using:STlauncher.App.Views"
        xmlns:controls="using:STlauncher.App.Controls"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="STlauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="/Assets/app.ico"
        Title="STlauncher">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseLightboxCommand}"/>
    </Window.KeyBindings>

    <!-- On a small screen the whole interface is scaled down a notch rather than clipped:
         everything keeps its place, only smaller. The factor is set from the window size. -->
    <LayoutTransformControl Name="Zoom">
    <Panel>
    <!-- The window's ground: one soft light of the accent, off to the right. A still
         gradient, painted once; pages lie on it without a fill of their own. -->
    <Border Background="{DynamicResource GroundGlowBrush}" IsHitTestVisible="False"/>

    <Grid ColumnDefinitions="76,*">

        <!-- ============ Rail ============
             76 px, the full height of the window: the mark, the sections, and at the foot
             the version, settings and the player. Its empty parts drag the window. -->
        <Border Grid.Column="0" Background="Transparent"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
                PointerPressed="OnTitleBarPressed">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,16,0,14">

                <Border Name="RailLogo" Grid.Row="0" Width="36" Height="36" CornerRadius="10" ClipToBounds="True"
                        Margin="0,0,0,14" HorizontalAlignment="Center">
                    <Image Source="/Assets/server-logo.png" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center">
                    <Button Classes="rail" Classes.active="{Binding IsGameSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Game">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconHome}"/>
                            <TextBlock Text="{DynamicResource Nav_Game}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsBuildsSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Builds">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconBuilds}"/>
                            <TextBlock Text="{DynamicResource Nav_Builds}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Skins: the library and the editor. -->
                    <Button Classes="rail" Classes.active="{Binding IsSkinsSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Skins">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconSkins}"/>
                            <TextBlock Text="{DynamicResource Nav_Skins}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Friends: the player's own server for friends, and the servers friends invited them to. -->
                    <Button Classes="rail" Classes.active="{Binding IsHostSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Host">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconHost}"/>
                            <TextBlock Text="{DynamicResource Nav_Host}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsServerSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Server">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconStar}"/>
                            <!-- The server has a name; the tab wears it. -->
                            <TextBlock Text="{Binding ServerName}" HorizontalAlignment="Center"
                                       MaxWidth="56" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsConsoleSection}"
                            IsVisible="{Binding ShowDeveloperConsole}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Console">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconConsole}"/>
                            <TextBlock Text="{DynamicResource Nav_Console}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center">
                    <!-- Always visible, never in the way: the version, or the update waiting. -->
                    <Button Classes="version-pill" Classes.available="{Binding HasUpdate}"
                            HorizontalAlignment="Center"
                            Command="{Binding UpdateActionCommand}"
                            IsEnabled="{Binding !IsUpdateBusy}"
                            ToolTip.Tip="{Binding UpdateStatus}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13"
                                      IsVisible="{Binding HasUpdate}"/>
                            <TextBlock Text="{Binding RailVersionLabel}" HorizontalAlignment="Center"
                                       MaxWidth="54" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="icon" IsVisible="{Binding CanDownloadManually}"
                            HorizontalAlignment="Center"
                            Command="{Binding OpenReleasesPageCommand}"
                            ToolTip.Tip="{DynamicResource Update_DownloadManually}">
                        <PathIcon Data="{StaticResource IconOpenExternal}"/>
                    </Button>

                    <Button Classes="rail" Classes.active="{Binding IsSettingsSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Settings">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconSettings}"/>
                            <TextBlock Text="{DynamicResource Nav_Settings}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- The player: the face opens the model, the name and saved names. -->
                    <Button Classes="avatar" Width="34" Height="34" Margin="0,6,0,0" HorizontalAlignment="Center"
                            ToolTip.Tip="{Binding Username}">
                        <controls:SkinFace Skin="{Binding PlayerSkin}" Width="34" Height="34" CornerRadius="9"/>
                        <Button.Flyout>
                            <controls:RevealFlyout Placement="RightEdgeAlignedBottom">
                                <StackPanel Spacing="12" Width="364">
                                    <controls:SkinViewer Skin="{Binding PlayerSkin}" Height="260"/>
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Game_OfflineMode}" Classes="faint" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Which skin system to look in; a player can have one in several. -->
                                    <Border Classes="segments" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="segment small" Classes.active="{Binding IsSkinSourceAuto}" Content="{DynamicResource Skin_SourceAuto}"
                                                    Command="{Binding SelectSkinSourceCommand}" CommandParameter="Auto"/>
                                            <Button Classes="segment small" Classes.active="{Binding IsSkinSourceMojang}" Content="Mojang"
                                                    Command="{Binding SelectSkinSourceCommand}" CommandParameter="Mojang"/>
                                            <Button Classes="segment small" Classes.active="{Binding IsSkinSourceTLauncher}" Content="TLauncher"
                                                    Command="{Binding SelectSkinSourceCommand}" CommandParameter="TLauncher"/>
                                            <Button Classes="segment small" Classes.active="{Binding IsSkinSourceElyBy}" Content="ely.by"
                                                    Command="{Binding SelectSkinSourceCommand}" CommandParameter="ElyBy"/>
                                            <!-- Skins: a file from the player's own library. -->
                                            <Button Classes="segment small" Classes.active="{Binding IsSkinSourceLibrary}" Content="{DynamicResource Skins_SourceOwn}"
                                                    Command="{Binding SelectSkinSourceCommand}" CommandParameter="Library"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Game_ViewerHint}" Classes="faint" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SkinSourceLabel}" Classes="faint" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
                                </StackPanel>
                            </controls:RevealFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1" RowDefinitions="52,Auto,*,Auto">

            <!-- The strip above every page, 52 px. It is the window's title bar as well: it
                 drags the window and holds the window buttons.
                   left   the context label: one TextBlock per section, class "context". A page
                          that wants other words there changes its own line below.
                   right  TopStripSlot, kept empty for the Ctrl+K search; whatever is put in
                          it sits just left of the window buttons. -->
            <Border Grid.Row="0" Background="Transparent" PointerPressed="OnTitleBarPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Name="TopStripContext" Margin="28,0,0,0" VerticalAlignment="Center">
                        <TextBlock Classes="context" IsVisible="{Binding IsGameSection}">
                            <Run Text="STlauncher"/> <Run Text="{Binding CurrentVersionLabel}"/>
                        </TextBlock>
                        <TextBlock Classes="context" IsVisible="{Binding IsBuildsSection}" Text="{DynamicResource Nav_Builds}"/>
                        <TextBlock Classes="context" IsVisible="{Binding IsSkinsSection}" Text="{DynamicResource Nav_Skins}"/>
                        <TextBlock Classes="context" IsVisible="{Binding IsHostSection}" Text="{DynamicResource Nav_Host}"/>
                        <TextBlock Classes="context" IsVisible="{Binding IsServerSection}" Text="{Binding ServerName}"/>
                        <TextBlock Classes="context" IsVisible="{Binding IsSettingsSection}" Text="{DynamicResource Nav_Settings}"/>
                        <TextBlock Classes="context" IsVisible="{Binding IsConsoleSection}" Text="{DynamicResource Nav_Console}"/>
                    </Panel>

                    <Panel Name="TopStripSlot" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="12,0,12,0">
                        <!-- The way into the search for everything. It looks like a field and
                             is a button: the typing happens in the palette it opens. On a strip
                             too narrow for it, the class "compact" (set from the window's code)
                             leaves the icon. -->
                        <Button Name="SearchEntry" Classes="search-entry" Command="{Binding OpenSearchCommand}"
                                ToolTip.Tip="{DynamicResource Search_Entry}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <PathIcon Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Search_Entry}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Classes="kbd" Text="Ctrl K" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Panel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Classes="chrome" Click="OnMinimizeClick" ToolTip.Tip="{DynamicResource Common_Minimize}">
                            <PathIcon Data="{StaticResource IconMinimize}"/>
                        </Button>
                        <Button Classes="chrome" Click="OnMaximizeClick" ToolTip.Tip="{DynamicResource Common_Maximize}">
                            <PathIcon Data="{StaticResource IconMaximize}"/>
                        </Button>
                        <Button Classes="chrome chrome-close" Click="OnCloseClick" ToolTip.Tip="{DynamicResource Common_Close}">
                            <PathIcon Data="{StaticResource IconClose}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Update notification ============
                 A raised line under the strip. Gold says "there is something new"; the
                 button is a quiet one, the accent stays with the page's own main action. -->
            <Border Grid.Row="1" IsVisible="{Binding IsUpdateBannerVisible}"
                    Background="{DynamicResource UpdateBannerBrush}" CornerRadius="12"
                    Margin="28,0,28,10" Padding="14,8,8,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <PathIcon Data="{StaticResource IconDownload}" Classes="gold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding UpdateBannerText}" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Classes="small"
                            Content="{Binding UpdateBannerAction}"
                            Command="{Binding InstallUpdateCommand}"
                            IsEnabled="{Binding !IsUpdateBusy}"/>
                    <Button Grid.Column="3" Classes="icon"
                            Command="{Binding DismissUpdateBannerCommand}"
                            IsEnabled="{Binding !IsUpdateBusy}"
                            ToolTip.Tip="{DynamicResource Update_Dismiss}">
                        <PathIcon Data="{StaticResource IconClose}" Classes="small"/>
                    </Button>
                </Grid>
            </Border>

            <Panel Grid.Row="2">
                <pages:GamePage IsVisible="{Binding IsGameSection}" controls:Reveal.OnVisible="True"/>
                <pages:BuildsPage IsVisible="{Binding IsBuildsSection}" controls:Reveal.OnVisible="True"/>
                <pages:ServerPage IsVisible="{Binding IsServerSection}" controls:Reveal.OnVisible="True"/>
                <pages:ConsolePage IsVisible="{Binding IsConsoleSection}" controls:Reveal.OnVisible="True"/>
                <pages:SettingsPage IsVisible="{Binding IsSettingsSection}" controls:Reveal.OnVisible="True"/>
                <!-- Skins -->
                <pages:SkinsPage IsVisible="{Binding IsSkinsSection}" controls:Reveal.OnVisible="True"/>
                <!-- Playing with friends -->
                <pages:HostPage IsVisible="{Binding IsHostSection}" controls:Reveal.OnVisible="True"/>
            </Panel>

            <!-- Status line: quiet by default, a progress bar only while loading. -->
            <Border Grid.Row="3" Padding="28,0" Height="28">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                               Classes="faint" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Column="1" Value="{Binding Progress}" Minimum="0" Maximum="100" Width="160"
                                 VerticalAlignment="Center" IsVisible="{Binding ShowLaunchProgress}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- First run only. Above everything, including the title bar, so it reads as a
         stage rather than a dialog. -->
    <views:OnboardingOverlay IsVisible="{Binding IsOnboardingOpen}"/>

    <!-- A catalog screenshot at full size. The scrim is a button, so a click anywhere
         outside the picture closes it; the picture and its controls sit above it. -->
    <Panel IsVisible="{Binding IsLightboxOpen}" controls:Reveal.OnVisible="True">
        <Button Classes="scrim" Command="{Binding CloseLightboxCommand}"/>
        <Grid RowDefinitions="Auto,*,Auto" Margin="48,44,48,28">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LightboxCounter}" Classes="faint" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center"
                                 IsVisible="{Binding IsLightboxLoading}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost small" Content="{DynamicResource Gallery_OpenExternal}"
                        Command="{Binding OpenLightboxInBrowserCommand}"/>
                <Button Grid.Column="2" Classes="plain small" Command="{Binding CloseLightboxCommand}"
                        ToolTip.Tip="{DynamicResource Common_Close}">
                    <PathIcon Data="{StaticResource IconClose}"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                <Button Classes="plain" VerticalAlignment="Center" Width="44" Height="44" CornerRadius="22"
                        IsVisible="{Binding HasPreviousLightboxImage}" Command="{Binding PreviousLightboxImageCommand}"
                        ToolTip.Tip="{DynamicResource Gallery_Previous}">
                    <PathIcon Data="{StaticResource IconChevronLeft}"/>
                </Button>
                <Border Grid.Column="1" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource LightboxBorderBrush}" BorderThickness="1" Background="{DynamicResource LightboxFrameBrush}">
                    <Image Source="{Binding LightboxImage}" Stretch="Uniform"/>
                </Border>
                <Button Grid.Column="2" Classes="plain" VerticalAlignment="Center" Width="44" Height="44" CornerRadius="22"
                        IsVisible="{Binding HasNextLightboxImage}" Command="{Binding NextLightboxImageCommand}"
                        ToolTip.Tip="{DynamicResource Gallery_Next}">
                    <PathIcon Data="{StaticResource IconChevronRight}"/>
                </Button>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding LightboxTitle}" Classes="faint" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Panel>

    <!-- My server: closing the launcher would stop a running server, so it asks first.
         Above every page, because the window can be closed from any of them. -->
    <Border Classes="scrim" IsVisible="{Binding IsHostCloseOpen}" controls:Reveal.OnVisible="True">
        <Border Classes="dialog" Width="480">
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding HostCloseTitle}" Classes="h2" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding HostCloseText}" Classes="muted" FontSize="13.5" LineHeight="20" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsHostClosing}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{DynamicResource Host_CloseCancel}"
                            Command="{Binding CancelHostCloseCommand}" IsEnabled="{Binding !IsHostClosing}"/>
                    <Button Classes="primary" Content="{Binding HostCloseAction}"
                            Command="{Binding ConfirmHostCloseCommand}" IsEnabled="{Binding !IsHostClosing}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- The search for everything (Ctrl+K). Empty until it is first opened: the window's
         code puts a SearchPalette in it then, so a search nobody uses costs nothing. -->
    <ContentControl Name="SearchHost" IsVisible="{Binding IsSearchOpen}"/>

    <!-- The start: sparks, the mark, and the screen showing through when the build is ready. -->
    <views:SplashOverlay Name="Splash" IsReady="{Binding IsStartupReady}"/>
    </Panel>
    </LayoutTransformControl>
</Window>
