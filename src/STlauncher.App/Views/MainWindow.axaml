<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STlauncher.App.ViewModels"
        xmlns:pages="using:STlauncher.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="STlauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="720"
        MinWidth="920" MinHeight="600"
        Background="{DynamicResource AppBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="/Assets/app.ico"
        Title="STlauncher">

    <Grid RowDefinitions="40,Auto,*,30">

        <!-- ============ Title bar ============ -->
        <Border Grid.Row="0" Background="#0F0C11" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPressed">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                    <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="STLAUNCHER" Classes="label" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Classes="chrome" Content="&#x2014;" Click="OnMinimizeClick"
                            ToolTip.Tip="{DynamicResource Common_Minimize}"/>
                    <Button Classes="chrome" Content="&#x25A1;" Click="OnMaximizeClick"
                            ToolTip.Tip="{DynamicResource Common_Maximize}"/>
                    <Button Classes="chrome chrome-close" Content="&#x2715;" Click="OnCloseClick"
                            ToolTip.Tip="{DynamicResource Common_Close}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Update notification ============ -->
        <!-- Appears only when a release was actually found. One button does the whole
             job: download if needed, then apply and relaunch. -->
        <Border Grid.Row="1" IsVisible="{Binding IsUpdateBannerVisible}"
                Background="#1C1420" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                           Text="{Binding UpdateBannerText}" TextWrapping="Wrap"/>

                <Button Grid.Column="2" Classes="primary" Margin="0,0,8,0"
                        Content="{Binding UpdateBannerAction}"
                        Command="{Binding InstallUpdateCommand}"
                        IsEnabled="{Binding !IsUpdateBusy}"/>

                <Button Grid.Column="3" Classes="ghost" Content="&#x2715;"
                        Command="{Binding DismissUpdateBannerCommand}"
                        IsEnabled="{Binding !IsUpdateBusy}"
                        ToolTip.Tip="{DynamicResource Update_Dismiss}"/>
            </Grid>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="2" ColumnDefinitions="228,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto">

                    <StackPanel Grid.Row="0" Margin="10,12" Spacing="1">
                        <Button Classes="nav" Classes.active="{Binding IsGameSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Game">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x25B6;" Width="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_Game}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsBuildsSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Builds">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x25C8;" Width="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_Builds}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsServerSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Server">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x25C9;" Width="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_Server}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsConsoleSection}"
                                IsVisible="{Binding ShowDeveloperConsole}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Console">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x25AE;" Width="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_Console}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" Classes.active="{Binding IsSettingsSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2699;" Width="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Update + profile footer -->
                    <StackPanel Grid.Row="1">

                        <!-- Always visible, never in the way: one row that either offers
                             a check or the update it already found. -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                Padding="10,10">
                            <StackPanel Spacing="4">
                                <Button Classes="update-row" Classes.available="{Binding HasUpdate}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding UpdateActionCommand}"
                                        IsEnabled="{Binding !IsUpdateBusy}"
                                        Content="{Binding UpdateActionLabel}"/>

                                <TextBlock Text="{Binding UpdateStateLabel}" Classes="faint" ToolTip.Tip="{Binding UpdateStatus}" TextTrimming="CharacterEllipsis"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                            Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Width="34" Height="34" CornerRadius="6" Background="#2A2028"
                                    ClipToBounds="True">
                                <Image Source="{Binding Avatar}" Stretch="Uniform" Width="34" Height="34"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedInstance.Name}" Classes="faint"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Panel Grid.Column="1">
                <pages:GamePage IsVisible="{Binding IsGameSection}"/>
                <pages:BuildsPage IsVisible="{Binding IsBuildsSection}"/>
                <pages:ServerPage IsVisible="{Binding IsServerSection}"/>
                <pages:ConsolePage IsVisible="{Binding IsConsoleSection}"/>
                <pages:SettingsPage IsVisible="{Binding IsSettingsSection}"/>
            </Panel>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="3" Background="#0F0C11" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"
                           Classes="faint" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Width="140"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
